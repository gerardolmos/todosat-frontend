---
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Todo-Sat",
    description = "Portal especializado en internet satelital.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>{title}</title>
        <meta name="description" content={description} />
    </head>

    <body>
        <header
            class="sticky top-0 z-50 border-b border-brand-border/80 bg-white/85 backdrop-blur"
        >
            <div
                class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8"
            >
                <a
                    href="/"
                    class="font-heading text-3xl font-bold tracking-tight text-brand-base"
                >
                    Todo-Sat
                </a>

                <nav
                    class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-brand-muted"
                >
                    <a
                        href="/marcas"
                        class="transition hover:text-info-primary"
                    >
                        Marcas
                    </a>
                    <a
                        href="/modelos"
                        class="transition hover:text-info-primary"
                    >
                        Modelos
                    </a>
                    <a
                        href="/articulos"
                        class="transition hover:text-info-primary"
                    >
                        Artículos
                    </a>
                    <a
                        href="/manuales"
                        class="transition hover:text-info-primary"
                    >
                        Manuales
                    </a>
                    <a
                        href="/categorias"
                        class="transition hover:text-info-primary"
                    >
                        Categorías
                    </a>
                </nav>
            </div>
        </header>

        <slot />

        <footer
            class="mt-24 border-t border-brand-border bg-slate-950 text-white"
        >
            <div class="mx-auto max-w-7xl px-5 py-12 sm:px-6 lg:px-8">
                <div class="grid gap-10 md:grid-cols-2">
                    <div>
                        <p
                            class="font-heading text-3xl font-bold tracking-tight"
                        >
                            Todo-Sat
                        </p>

                        <p
                            class="mt-4 max-w-md text-sm leading-6 text-slate-300"
                        >
                            Portal especializado en internet satelital,
                            hardware, cobertura, instalación y actualidad del
                            sector.
                        </p>
                    </div>

                    <div class="md:text-right">
                        <p class="text-sm font-semibold text-white">
                            Información legal
                        </p>

                        <div
                            class="mt-4 flex flex-wrap gap-4 text-sm text-slate-300 md:justify-end"
                        >
                            <a href="/aviso-legal" class="hover:text-white">
                                Aviso legal
                            </a>

                            <a href="/privacidad" class="hover:text-white">
                                Privacidad
                            </a>

                            <a href="/cookies" class="hover:text-white">
                                Cookies
                            </a>

                            <a href="/contacto" class="hover:text-white">
                                Contacto
                            </a>
                        </div>
                    </div>
                </div>

                <div
                    class="mt-10 border-t border-white/10 pt-6 text-sm text-slate-400"
                >
                    © {new Date().getFullYear()} Todo-Sat.
                </div>
            </div>
        </footer>
    </body>
</html>
