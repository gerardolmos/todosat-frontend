---
import "../styles/global.css";
import logoTodoSatcom from "../assets/logoTodoSatcom.png";
import Header from "../components/Header.astro";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "TodoSatcom",
    description = "Portal especializado en internet satelital.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>{title}</title>
        <meta name="description" content={description} />
    </head>

    <body>
        <Header />
        <script is:inline>
            const button = document.getElementById("menu-toggle");
            const menu = document.getElementById("mobile-menu");
            const header = document.getElementById("site-header");

            button?.addEventListener("click", () => {
                const isOpen = !menu?.classList.contains("hidden");

                menu?.classList.toggle("hidden");
                button.setAttribute("aria-expanded", String(!isOpen));
            });

            let lastScrollY = window.scrollY;

            window.addEventListener("scroll", () => {
                const currentScrollY = window.scrollY;
                const menuIsOpen = !menu?.classList.contains("hidden");

                if (!header || menuIsOpen) return;

                if (currentScrollY <= 20) {
                    header.classList.remove("-translate-y-full");
                    lastScrollY = currentScrollY;
                    return;
                }

                if (currentScrollY > lastScrollY && currentScrollY > 120) {
                    header.classList.add("-translate-y-full");
                } else {
                    header.classList.remove("-translate-y-full");
                }

                lastScrollY = currentScrollY;
            });
        </script>
        <slot />

        <footer class="border-t border-white/10 bg-slate-950 text-white">
            <div class="mx-auto max-w-7xl px-5 py-12 sm:px-6 lg:px-8">
                <div class="grid gap-10 md:grid-cols-2">
                    <div>
                        <img
                            src={logoTodoSatcom.src}
                            alt="TodoSatcom"
                            class="w-[220px]"
                        />

                        <p
                            class="mt-4 max-w-md text-sm leading-6 text-slate-300"
                        >
                            Portal especializado en internet satelital,
                            hardware, cobertura, instalación y actualidad del
                            sector.
                        </p>
                    </div>

                    <div class="md:text-right">
                        <p class="text-sm font-semibold text-white">
                            Información legal
                        </p>

                        <div
                            class="mt-4 flex flex-wrap gap-4 text-sm text-slate-300 md:justify-end"
                        >
                            <a href="/aviso-legal" class="hover:text-white">
                                Aviso legal
                            </a>

                            <a href="/privacidad" class="hover:text-white">
                                Privacidad
                            </a>

                            <a href="/cookies" class="hover:text-white">
                                Cookies
                            </a>

                            <a href="/contacto" class="hover:text-white">
                                Contacto
                            </a>
                        </div>
                    </div>
                </div>

                <div
                    class="mt-10 border-t border-white/10 pt-6 text-sm text-slate-400"
                >
                    © {new Date().getFullYear()} TodoSatcom.
                </div>
            </div>
        </footer>
    </body>
</html>
