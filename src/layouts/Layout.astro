---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

type PageType = "website" | "article";

type StructuredData =
    | Record<string, unknown>
    | Record<string, unknown>[];

interface Props {
    title?: string;
    description?: string;
    canonical?: string | null;
    image?: string | null;
    type?: PageType;
    robots?: string;
    publishedTime?: string | null;
    modifiedTime?: string | null;
    structuredData?: StructuredData | null;
}

const {
    title = "TodoSatcom",
    description = "Portal especializado en internet satelital.",
    canonical,
    image,
    type = "website",
    robots = "index, follow",
    publishedTime,
    modifiedTime,
    structuredData,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://todosatcom.com");

function getAbsoluteUrl(value: string) {
    return new URL(value, siteUrl).toString();
}

function getCanonicalUrl(value: string) {
    const url = new URL(value, siteUrl);

    url.search = "";
    url.hash = "";

    const pathLooksLikeFile = /\/[^/]+\.[^/]+$/.test(url.pathname);

    if (!pathLooksLikeFile && !url.pathname.endsWith("/")) {
        url.pathname += "/";
    }

    return url.toString();
}

const canonicalUrl =
    canonical === null
        ? null
        : getCanonicalUrl(canonical ?? Astro.url.pathname);

const imageUrl = image ? getAbsoluteUrl(image) : null;

const siteIndexingEnabled =
    import.meta.env.PUBLIC_SITE_INDEXING !== "false";

const effectiveRobots = siteIndexingEnabled
    ? robots
    : "noindex, nofollow";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="robots" content={effectiveRobots} />

        {
            canonicalUrl && <link rel="canonical" href={canonicalUrl} />
        }

        <meta property="og:locale" content="es_ES" />
        <meta property="og:site_name" content="TodoSatcom" />
        <meta property="og:type" content={type} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        {
            canonicalUrl && <meta property="og:url" content={canonicalUrl} />
        }

        {
            imageUrl && (
                <>
                    <meta property="og:image" content={imageUrl} />
                    <meta property="og:image:alt" content={title} />
                </>
            )
        }

        {
            type === "article" && publishedTime && (
                <meta
                    property="article:published_time"
                    content={publishedTime}
                />
            )
        }

        {
            type === "article" && modifiedTime && (
                <meta property="article:modified_time" content={modifiedTime} />
            )
        }

        <meta
            name="twitter:card"
            content={imageUrl ? "summary_large_image" : "summary"}
        />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />

        {
            imageUrl && (
                <>
                    <meta name="twitter:image" content={imageUrl} />
                    <meta name="twitter:image:alt" content={title} />
                </>
            )
        }

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/favicon.svg" />

        {
            structuredData && (
                <script
                    type="application/ld+json"
                    set:html={JSON.stringify(structuredData)}
                />
            )
        }
    </head>

    <body>
        <Header />

        <script is:inline>
            const button = document.getElementById("menu-toggle");
            const menu = document.getElementById("mobile-menu");
            const header = document.getElementById("site-header");

            button?.addEventListener("click", () => {
                const isOpen = !menu?.classList.contains("hidden");

                menu?.classList.toggle("hidden");
                button.setAttribute("aria-expanded", String(!isOpen));
            });

            let lastScrollY = window.scrollY;

            window.addEventListener("scroll", () => {
                const currentScrollY = window.scrollY;
                const menuIsOpen = !menu?.classList.contains("hidden");

                if (!header || menuIsOpen) return;

                if (currentScrollY <= 20) {
                    header.classList.remove("-translate-y-full");
                    lastScrollY = currentScrollY;
                    return;
                }

                if (currentScrollY > lastScrollY && currentScrollY > 120) {
                    header.classList.add("-translate-y-full");
                } else {
                    header.classList.remove("-translate-y-full");
                }

                lastScrollY = currentScrollY;
            });
        </script>

        <slot />

        <div
            data-cart-message
            role="status"
            aria-live="polite"
            class="pointer-events-none fixed bottom-5 right-5 z-[70] max-w-sm rounded-2xl border border-emerald-300 bg-emerald-50 px-5 py-4 text-sm font-bold text-emerald-950 shadow-xl empty:hidden data-[state=error]:border-red-300 data-[state=error]:bg-red-50 data-[state=error]:text-red-950"
        ></div>

        <Footer />

        <script>
            import "../scripts/cart-ui";
        </script>
    </body>
</html>
