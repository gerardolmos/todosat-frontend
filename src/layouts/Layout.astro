---
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "TODOSat",
    description = "Portal especializado en internet satelital.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>{title}</title>
        <meta name="description" content={description} />
    </head>

    <body class="min-h-screen bg-white text-black">
        <header class="border-b">
            <div
                class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
            >
                <a href="/" class="text-2xl font-bold"> TODOSat </a>

                <nav class="flex gap-6 text-sm font-medium">
                    <a href="/marcas">Marcas</a>
                    <a href="/modelos">Modelos</a>
                    <a href="/articulos">Artículos</a>
                    <a href="/manuales">Manuales</a>
                    <a href="/categorias">Categorías</a>
                </nav>
            </div>
        </header>

        <slot />

        <footer class="mt-20 border-t bg-gray-50">
            <div class="mx-auto max-w-6xl px-6 py-10">
                <div class="grid gap-8 md:grid-cols-2">
                    <div>
                        <p class="text-xl font-bold text-black">TODOSat</p>

                        <p
                            class="mt-3 max-w-md text-sm leading-6 text-gray-600"
                        >
                            Portal especializado en internet satelital,
                            hardware, cobertura, instalación y actualidad del
                            sector.
                        </p>
                    </div>

                    <div class="md:text-right">
                        <p class="text-sm font-semibold text-black">
                            Información legal
                        </p>

                        <div
                            class="mt-3 flex flex-wrap gap-4 text-sm text-gray-600 md:justify-end"
                        >
                            <a href="/aviso-legal" class="hover:text-black">
                                Aviso legal
                            </a>

                            <a href="/privacidad" class="hover:text-black">
                                Privacidad
                            </a>

                            <a href="/cookies" class="hover:text-black">
                                Cookies
                            </a>

                            <a href="/contacto" class="hover:text-black">
                                Contacto
                            </a>
                        </div>
                    </div>
                </div>

                <div class="mt-8 border-t pt-6 text-sm text-gray-500">
                    © {new Date().getFullYear()} TODOSat.
                </div>
            </div>
        </footer>
    </body>
</html>
