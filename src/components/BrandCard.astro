---
import { getMediaUrl } from "../lib/media";

interface Props {
    marca: any;
}

const { marca } = Astro.props;

const logoUrl = getMediaUrl(marca.logo);
const portadaUrl = getMediaUrl(marca.imagen_portada);
---

<a
    href={`/marcas/${marca.slug}`}
    class="group flex h-full min-h-[390px] flex-col overflow-hidden rounded-2xl border border-brand-border bg-white shadow-sm transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-info-primary/30 hover:shadow-md"
>
    <div class="h-32 overflow-hidden bg-brand-soft">
        {
            portadaUrl && (
                <img
                    src={portadaUrl}
                    alt={marca.nombre}
                    class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-103"
                />
            )
        }
    </div>

    <div class="flex flex-1 flex-col p-4">
        <div
            class="mb-4 flex h-14 items-center border-b border-brand-border pb-3"
        >
            {
                logoUrl && (
                    <img
                        src={logoUrl}
                        alt={`Logo de ${marca.nombre}`}
                        class="max-h-9 w-auto"
                    />
                )
            }
        </div>

        <h3 class="text-2xl font-semibold tracking-tight text-brand-base">
            {marca.nombre}
        </h3>

        {
            marca.descripcion_corta && (
                <p class="mt-3 line-clamp-2 text-sm leading-6 text-brand-muted">
                    {marca.descripcion_corta}
                </p>
            )
        }

        <div class="mt-auto border-t border-brand-border pt-4">
            <p class="text-sm font-semibold text-info-primary">Ver marca →</p>
        </div>
    </div>
</a>
