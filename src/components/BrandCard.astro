---
import { getMediaUrl } from "../lib/media";

interface Props {
    marca: any;
}

const { marca } = Astro.props;

const logoUrl = getMediaUrl(marca.logo);
const portadaUrl = getMediaUrl(marca.imagen_portada);
---

<a
    href={`/operadores/${marca.slug}`}
    class="group flex h-full min-h-[300px] flex-col overflow-hidden rounded-2xl border border-transparent bg-slate-950/40 transition-all duration-300 hover:border-[#005EFF]/50"
>
    <div class="flex flex-1 flex-col items-center text-center p-6">
        <div class="mb-6 flex h-28 items-center justify-center">
            {
                logoUrl && (
                    <img
                        src={logoUrl}
                        alt={`Logo de ${marca.nombre}`}
                        class="max-h-16 max-w-[220px] object-contain"
                    />
                )
            }
        </div>

        <h3 class="text-2xl font-bold tracking-tight text-white">
            {marca.nombre}
        </h3>

        {
            marca.descripcion_corta && (
                <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-300">
                    {marca.descripcion_corta}
                </p>
            )
        }

        <div class="mt-auto pt-5 text-center">
            <p class="text-sm font-semibold text-[#4EA1FF]">Ver operador →</p>
        </div>
    </div>
</a>
