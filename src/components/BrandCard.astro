---
import { Image } from "astro:assets";
import { getMediaUrl } from "../lib/media";

interface Props {
    marca: any;
}

const { marca } = Astro.props;

const logoUrl = getMediaUrl(marca.logo);
---

<a
    href={`/operadores/${marca.slug}`}
    class="group flex h-full min-h-[230px] flex-col overflow-hidden rounded-2xl border border-white/10 bg-slate-900/55 p-4 transition-all duration-300 hover:border-blue-400/40 hover:bg-slate-900/85 md:min-h-[330px] md:p-6"
>
    <div class="flex flex-1 flex-col items-center text-center">
        <div
            class="mb-4 flex h-16 w-full items-center justify-center rounded-xl border border-white/5 bg-slate-950/45 px-4 md:mb-6 md:h-28 md:px-6"
        >
            {
                logoUrl && (
                    <Image
                        src={logoUrl}
                        inferSize
                        alt={`Logo de ${marca.nombre}`}
                        class="max-h-full max-w-full object-contain transition duration-300 group-hover:brightness-110"
                    />
                )
            }
        </div>

        <h3
            class="text-sm font-bold leading-tight tracking-tight text-white md:text-xl"
        >
            {marca.nombre}
        </h3>

        {
            marca.descripcion_corta && (
                <p class="mt-3 line-clamp-3 text-xs leading-5 text-slate-400 md:mt-5 md:text-base md:leading-7">
                    {marca.descripcion_corta}
                </p>
            )
        }

        <div class="mt-auto pt-5 md:pt-8">
            <p
                class="text-xs font-bold text-sky-300 transition-colors duration-300 group-hover:text-sky-200 md:text-sm"
            >
                Ver operador →
            </p>
        </div>
    </div>
</a>
