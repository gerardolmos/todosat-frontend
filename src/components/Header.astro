---
import logoTodoSatcom from "../assets/images/logoTodoSatcom.svg";

const navItems = [
    { href: "/operadores", label: "Operadores" },
    { href: "/hardware", label: "Hardware" },
    { href: "/noticias", label: "Noticias" },
    { href: "/manuales", label: "Manuales" },
    { href: "/tienda", label: "Tienda" },
];
---

<header
    id="site-header"
    class="sticky top-0 z-50 border-b border-white/10 bg-slate-950 transition-transform duration-300"
>
    <div
        class="mx-auto flex max-w-7xl items-center justify-between px-5 py-6 sm:px-6 lg:px-8"
    >
        <a href="/" class="shrink-0">
            <img
                src={logoTodoSatcom.src}
                alt="TodoSatcom"
                class="w-[150px] md:w-[210px]"
            />
        </a>

        <div class="hidden items-center gap-4 md:flex">
            <nav
                class="flex items-center text-sm font-semibold text-slate-300"
                aria-label="Navegación principal"
            >
                {
                    navItems.map((item, index) => (
                        <>
                            <a
                                href={item.href}
                                class={`px-5 py-2 transition hover:text-white ${
                                    item.href === "/tienda"
                                        ? "font-bold text-orange-400 hover:text-orange-300"
                                        : ""
                                }`}
                            >
                                {item.label}
                            </a>

                            {index < navItems.length - 1 && (
                                <span class="h-5 w-px bg-slate-500" />
                            )}
                        </>
                    ))
                }
            </nav>

            <a
                href="/tienda/carrito"
                class="relative inline-flex items-center justify-center rounded-full border border-orange-400/40 bg-orange-400/10 px-4 py-2.5 text-sm font-bold text-orange-200 transition hover:bg-orange-400/20 hover:text-white"
            >
                Carrito

                <span
                    data-cart-count
                    hidden
                    class="ml-2 inline-flex min-w-6 items-center justify-center rounded-full bg-orange-500 px-1.5 py-0.5 text-xs font-black text-white"
                >
                    0
                </span>
            </a>
        </div>

        <button
            id="menu-toggle"
            type="button"
            class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-white md:hidden"
            aria-label="Abrir menú"
            aria-expanded="false"
            aria-controls="mobile-menu"
        >
            <span class="text-2xl leading-none">☰</span>
        </button>
    </div>

    <nav
        id="mobile-menu"
        class="hidden border-t border-white/10 bg-slate-950/95 px-5 py-5 backdrop-blur-xl md:hidden"
        aria-label="Navegación móvil"
    >
        <div class="flex flex-col gap-2 text-sm font-semibold text-slate-300">
            {
                navItems.map((item) => (
                    <a
                        href={item.href}
                        class={`rounded-xl px-4 py-3 transition hover:bg-white/5 hover:text-white ${
                            item.href === "/tienda"
                                ? "border border-orange-400/30 bg-orange-400/10 font-bold text-orange-300 hover:bg-orange-400/20"
                                : ""
                        }`}
                    >
                        {item.label}
                    </a>
                ))
            }

            <a
                href="/tienda/carrito"
                class="mt-2 flex items-center justify-between rounded-xl border border-orange-400/30 bg-orange-400/10 px-4 py-3 font-bold text-orange-200 transition hover:bg-orange-400/20"
            >
                <span>Carrito</span>

                <span
                    data-cart-count
                    hidden
                    class="inline-flex min-w-6 items-center justify-center rounded-full bg-orange-500 px-1.5 py-0.5 text-xs font-black text-white"
                >
                    0
                </span>
            </a>

            <a
                href="/buscar"
                class="mt-2 rounded-xl border border-sky-400/30 bg-sky-400/10 px-4 py-3 font-bold text-sky-100 transition hover:bg-sky-400/20"
            >
                Buscar
            </a>
        </div>
    </nav>
</header>
