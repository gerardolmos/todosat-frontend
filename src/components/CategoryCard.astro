---
import { Image } from "astro:assets";
import { getMediaUrl } from "../lib/media";

interface Props {
    categoria: any;
}

const { categoria } = Astro.props;
const iconoUrl = getMediaUrl(
    categoria.icono?.formats?.thumbnail || categoria.icono,
);
---

<a
    href={`/categorias/${categoria.slug}`}
    class="group flex h-full min-h-[260px] flex-col rounded border border-transparent bg-slate-950 p-6 transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:border-[#005EFF] hover:shadow-[0_0_8px_rgba(0,94,255,0.90),0_0_18px_rgba(0,94,255,0.30)]"
>
    {
        iconoUrl && (
            <div class="mb-8 ">
                <Image
                    src={iconoUrl}
                    inferSize
                    alt={categoria.nombre}
                    class="h-48 w-48 object-contain"
                />
            </div>
        )
    }

    <h3 class="text-2xl font-bold tracking-tight !text-white">
        {categoria.nombre}
    </h3>

    {
        categoria.descripcion && (
            <p class="mt-3 text-sm leading-6 text-slate-300">
                {categoria.descripcion}
            </p>
        )
    }

    <p class="mt-auto pt-6 text-sm font-semibold text-blue-400">
        Ver artículos →
    </p>
</a>
