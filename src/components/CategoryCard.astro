---
import { getMediaUrl } from "../lib/media";

interface Props {
    categoria: any;
}

const { categoria } = Astro.props;
const iconoUrl = getMediaUrl(
    categoria.icono?.formats?.thumbnail || categoria.icono,
);
---

<a
    href={`/categorias/${categoria.slug}`}
    class="block rounded border p-6 hover:bg-gray-50 transition"
>
    {
        iconoUrl && (
            <img
                src={iconoUrl}
                alt={categoria.nombre}
                class="mb-4 h-12 w-12 object-contain"
            />
        )
    }

    <h3 class="text-2xl font-bold">
        {categoria.nombre}
    </h3>

    {
        categoria.descripcion && (
            <p class="mt-2 text-gray-600">{categoria.descripcion}</p>
        )
    }
</a>
