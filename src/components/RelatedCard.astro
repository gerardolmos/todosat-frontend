---
import { getMediaUrl } from "../lib/media";

type Props = {
    title: string;
    description?: string;
    url: string;
    image?: any;
    type?: string;
    meta?: string;
};

const { title, description, url, image, type, meta } = Astro.props;

const imageUrl = getMediaUrl(image);
---

<a
    href={url}
    class="block rounded-xl border border-slate-200 bg-white p-4 transition hover:border-slate-400 hover:shadow-sm"
>
    <div class="flex gap-4">
        {
            imageUrl && (
                <img
                    src={imageUrl}
                    alt={title}
                    class="h-20 w-20 rounded-lg object-cover"
                    loading="lazy"
                />
            )
        }

        <div>
            {
                type && (
                    <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-slate-500">
                        {type}
                    </p>
                )
            }

            <h3 class="font-semibold text-slate-900">
                {title}
            </h3>

            {meta && <p class="mt-1 text-xs text-slate-400">{meta}</p>}

            {
                description && (
                    <p class="mt-1 line-clamp-2 text-sm text-slate-600">
                        {description}
                    </p>
                )
            }
        </div>
    </div>
</a>
