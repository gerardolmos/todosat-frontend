---
import { Image } from "astro:assets";
import { getMediaUrl } from "../lib/media";

type Props = {
    title: string;
    description?: string;
    url: string;
    image?: any;
    type?: string;
    meta?: string;
};

const { title, description, url, image, type, meta } = Astro.props;

const imageUrl = getMediaUrl(image);
---

<a href={url} class="group flex h-full">
    <div
        class="flex min-h-[150px] w-full gap-5 border-b border-white/10 py-6 transition-colors duration-200 group-hover:border-[#005EFF]"
    >
        {
            imageUrl && (
                <div class="h-24 w-24 shrink-0 overflow-hidden rounded">
                    <Image
                        src={imageUrl}
                        inferSize
                        alt={title}
                        class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-105"
                        loading="lazy"
                    />
                </div>
            )
        }

        <div class="flex min-w-0 flex-1 flex-col">
            <div class="mb-3 flex flex-wrap gap-2">
                {
                    type && (
                        <span class="rounded-full border border-blue-500/50 bg-blue-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-blue-300">
                            {type}
                        </span>
                    )
                }

                {
                    meta && (
                        <span class="rounded-full border border-white/10 px-3 py-1 text-xs font-semibold text-slate-300">
                            {meta}
                        </span>
                    )
                }
            </div>

            <h3
                class="line-clamp-2 text-lg font-bold leading-snug tracking-tight !text-white"
            >
                {title}
            </h3>

            {
                description && (
                    <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-300">
                        {description}
                    </p>
                )
            }
        </div>
    </div>
</a>
