---
import { getMediaUrl } from "../lib/media";

type Props = {
    title: string;
    description?: string;
    url: string;
    image?: any;
    type?: string;
    meta?: string;
};

const { title, description, url, image, type, meta } = Astro.props;

const imageUrl = getMediaUrl(image);
---

<a
    href={url}
    class="group block overflow-hidden rounded-2xl border border-brand-border bg-white shadow-sm transition hover:-translate-y-1 hover:border-info-primary/40 hover:shadow-md"
>
    <div class="flex gap-4 p-4">
        {
            imageUrl && (
                <div class="shrink-0 overflow-hidden rounded-xl bg-brand-soft">
                    <img
                        src={imageUrl}
                        alt={title}
                        class="h-24 w-24 object-cover transition duration-500 group-hover:scale-105"
                        loading="lazy"
                    />
                </div>
            )
        }

        <div class="min-w-0">
            <div class="mb-2 flex flex-wrap gap-2">
                {
                    type && (
                        <span class="rounded-full bg-info-primary-soft px-3 py-1 text-xs font-semibold uppercase tracking-wide text-info-primary-dark">
                            {type}
                        </span>
                    )
                }

                {
                    meta && (
                        <span class="rounded-full bg-brand-soft px-3 py-1 text-xs font-semibold text-brand-muted">
                            {meta}
                        </span>
                    )
                }
            </div>

            <h3
                class="text-lg font-bold leading-snug tracking-tight text-brand-base"
            >
                {title}
            </h3>

            {
                description && (
                    <p class="mt-2 line-clamp-2 text-sm leading-6 text-brand-muted">
                        {description}
                    </p>
                )
            }
        </div>
    </div>
</a>
