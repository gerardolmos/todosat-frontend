---
import FeaturedCard from "./FeaturedCard.astro";
import seleccionBg from "../assets/images/seleccionbg.png";

interface Props {
    destacados: any[];
}

const { destacados } = Astro.props;
---

{
    destacados.length > 0 && (
        <section class="relative mt-16 overflow-hidden rounded-3xl bg-slate-950 px-6 py-14 text-white shadow-2xl md:px-10 md:py-20">
            <img
                src={seleccionBg.src}
                alt=""
                class="pointer-events-none absolute right-10 top-8 z-0 hidden h-48 w-48 object-contain opacity-25 lg:block md:h-56 md:w-72"
            />

            <div class="absolute inset-0 bg-gradient-to-b from-slate-950/5 via-slate-950/50 to-slate-950" />

            <div class="relative z-10">
                <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
                    <div>
                        <p class="inline-flex rounded-full border border-blue-500/50 bg-blue-500/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-blue-400">
                            SELECCIÓN TODOSATCOM
                        </p>

                        <h2 class="mt-6 text-4xl font-bold leading-tight tracking-tight !text-white md:text-5xl">
                            Recomendados por TodoSatcom
                        </h2>

                        <p class="mt-5 max-w-2xl text-xl leading-8 text-slate-300">
                            Una selección editorial de operadores, equipos,
                            guías y contenidos clave para entender mejor el
                            ecosistema satelital.
                        </p>
                    </div>
                </div>

                <div class="mt-8">
                    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
                        {destacados.map((destacado: any) => (
                            <FeaturedCard destacado={destacado} />
                        ))}
                    </div>
                </div>
            </div>
        </section>
    )
}
