---
import type {
    EstadoVentaTienda,
} from "../../types/store";

interface Props {
    estado: EstadoVentaTienda;
    productoNombre: string;
}

const {
    estado,
    productoNombre,
} = Astro.props;

const contactUrl =
    `/contacto?producto=${encodeURIComponent(
        productoNombre,
    )}&motivo=disponibilidad`;

const unavailableLabels: Partial<
    Record<EstadoVentaTienda, string>
> = {
    Agotado: "Producto agotado",
    Próximamente: "Disponible próximamente",
    Descatalogado: "Producto descatalogado",
};

const unavailableLabel =
    unavailableLabels[estado];
---

<div>
    {
        estado === "Disponible" && (
            <>
                <button
                    type="button"
                    disabled
                    class="inline-flex w-full cursor-not-allowed items-center justify-center rounded-full bg-orange-500 px-6 py-3.5 text-sm font-bold text-white opacity-70 sm:w-auto"
                >
                    Comprar
                </button>

                <p class="mt-3 max-w-md text-sm leading-6 text-slate-500">
                    La compra online se activará cuando incorporemos el carrito y el pago seguro.
                </p>
            </>
        )
    }

    {
        estado === "Bajo consulta" && (
            <a
                href={contactUrl}
                class="inline-flex w-full items-center justify-center rounded-full bg-orange-500 px-6 py-3.5 text-sm font-bold text-white transition hover:bg-orange-400 sm:w-auto"
            >
                Consultar disponibilidad
            </a>
        )
    }

    {
        unavailableLabel && (
            <button
                type="button"
                disabled
                class="inline-flex w-full cursor-not-allowed items-center justify-center rounded-full border border-slate-300 bg-slate-200 px-6 py-3.5 text-sm font-bold text-slate-500 sm:w-auto"
            >
                {unavailableLabel}
            </button>
        )
    }
</div>
