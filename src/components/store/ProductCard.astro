---
import { getMediaUrl } from "../../lib/media";

import ProductCommercialStatus from "./ProductCommercialStatus.astro";

import type {
    ProductoTiendaResumen,
} from "../../types/store";

interface Props {
    producto: ProductoTiendaResumen;
}

const { producto } = Astro.props;

const imageUrl = getMediaUrl(
    producto.imagen_principal,
);

const productUrl =
    `/tienda/producto/${producto.slug}`;

const actionLabel =
    producto.estado_venta === "Bajo consulta"
        ? "Consultar disponibilidad"
        : "Ver producto";
---

<article
    class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-0.5 hover:border-orange-300 hover:shadow-lg hover:shadow-slate-950/10 focus-within:border-orange-400 focus-within:ring-2 focus-within:ring-orange-400/30"
>
    <div
        class="flex h-48 items-center justify-center border-b border-slate-200 bg-slate-50 p-4 sm:h-52"
    >
        {
            imageUrl ? (
                <img
                    src={imageUrl}
                    alt={
                        producto.imagen_principal
                            ?.alternativeText ||
                        producto.nombre
                    }
                    class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.035]"
                    loading="lazy"
                />
            ) : (
                <span class="text-sm font-semibold text-slate-400">
                    Imagen no disponible
                </span>
            )
        }
    </div>

    <div class="flex flex-1 flex-col p-5">
        <div class="relative z-20">
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-orange-700">
                {producto.tipo_producto}
            </p>
        </div>

        <h2 class="mt-3 text-xl font-bold leading-tight tracking-tight text-slate-950">
            <a
                href={productUrl}
                class="after:absolute after:inset-0 after:z-10 focus-visible:outline-none group-hover:text-orange-700"
                aria-label={`${actionLabel}: ${producto.nombre}`}
            >
                {producto.nombre}
            </a>
        </h2>

        <p class="mt-3 line-clamp-2 text-sm leading-6 text-slate-600">
            {producto.descripcion_corta}
        </p>

        <div class="mt-auto pt-5">
            <ProductCommercialStatus
                estado={producto.estado_venta}
                precioCentimos={producto.precio_centimos}
                moneda={producto.moneda}
                compact
            />

            <span
                class="mt-4 inline-flex items-center text-sm font-bold text-slate-950 transition group-hover:text-orange-700"
                aria-hidden="true"
            >
                {actionLabel}
                <span
                    class="ml-2 transition-transform group-hover:translate-x-1"
                >
                    →
                </span>
            </span>
        </div>
    </div>
</article>
