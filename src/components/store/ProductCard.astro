---
import { getMediaUrl } from "../../lib/media";

import ProductCommercialStatus from "./ProductCommercialStatus.astro";

import type {
    ProductoTiendaResumen,
} from "../../types/store";

interface Props {
    producto: ProductoTiendaResumen;
}

const { producto } = Astro.props;

const imageUrl = getMediaUrl(
    producto.imagen_principal,
);

const productUrl =
    `/tienda/producto/${producto.slug}`;

const categoryUrl =
    `/tienda/categoria/${producto.categoria_producto_tienda.slug}`;

const actionLabel =
    producto.estado_venta === "Bajo consulta"
        ? "Consultar disponibilidad"
        : "Ver producto";
---

<article
    class="group flex h-full flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:border-orange-300 hover:shadow-xl hover:shadow-slate-950/10"
>
    <a
        href={productUrl}
        class="flex h-64 items-center justify-center border-b border-slate-200 bg-slate-50 p-6"
        aria-label={`Ver ${producto.nombre}`}
    >
        {
            imageUrl ? (
                <img
                    src={imageUrl}
                    alt={
                        producto.imagen_principal
                            ?.alternativeText ||
                        producto.nombre
                    }
                    class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
                    loading="lazy"
                />
            ) : (
                <span class="text-sm font-semibold text-slate-400">
                    Imagen no disponible
                </span>
            )
        }
    </a>

    <div class="flex flex-1 flex-col p-6">
        <div class="flex flex-wrap items-center gap-2">
            <a
                href={categoryUrl}
                class="text-xs font-bold uppercase tracking-[0.16em] text-orange-700 transition hover:text-orange-950"
            >
                {producto.categoria_producto_tienda.nombre}
            </a>

            <span
                class="h-1 w-1 rounded-full bg-slate-300"
                aria-hidden="true"
            ></span>

            <span class="text-xs font-semibold text-slate-500">
                {producto.tipo_producto}
            </span>
        </div>

        <h2 class="mt-4 text-2xl font-bold leading-tight tracking-tight text-slate-950">
            <a
                href={productUrl}
                class="transition group-hover:text-orange-700"
            >
                {producto.nombre}
            </a>
        </h2>

        <p class="mt-4 line-clamp-3 text-sm leading-6 text-slate-600">
            {producto.descripcion_corta}
        </p>

        <div class="mt-auto pt-6">
            <ProductCommercialStatus
                estado={producto.estado_venta}
                precioCentimos={producto.precio_centimos}
                moneda={producto.moneda}
                compact
            />

            <a
                href={productUrl}
                class="mt-5 inline-flex items-center text-sm font-bold text-slate-950 transition hover:text-orange-700"
            >
                {actionLabel}
                <span
                    class="ml-2 transition-transform group-hover:translate-x-1"
                    aria-hidden="true"
                >
                    →
                </span>
            </a>
        </div>
    </div>
</article>
