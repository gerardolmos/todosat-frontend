---
import { getMediaUrl } from "../../lib/media";

import type {
    CategoriaTiendaConConteo,
} from "../../types/store";

interface Props {
    item: CategoriaTiendaConConteo;
}

const { item } = Astro.props;

const { categoria, totalProductos } = item;

const imageUrl = getMediaUrl(categoria.imagen);

const categoryUrl =
    `/tienda/categoria/${categoria.slug}`;
---

<a
    href={categoryUrl}
    class="group relative flex min-h-64 overflow-hidden rounded-3xl border border-slate-200 bg-slate-950 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-orange-400 hover:shadow-xl hover:shadow-slate-950/15"
>
    {
        imageUrl && (
            <img
                src={imageUrl}
                alt={
                    categoria.imagen?.alternativeText ||
                    categoria.nombre
                }
                class="absolute inset-0 h-full w-full object-cover opacity-45 transition duration-500 group-hover:scale-105 group-hover:opacity-55"
                loading="lazy"
            />
        )
    }

    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/75 to-slate-950/20"></div>

    <div class="relative mt-auto p-6 text-white">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-orange-400">
            {
                totalProductos === 1
                    ? "1 producto"
                    : `${totalProductos} productos`
            }
        </p>

        <h3 class="mt-3 text-2xl font-bold leading-tight text-white">
            {categoria.nombre}
        </h3>

        {
            categoria.descripcion && (
                <p class="mt-3 line-clamp-2 text-sm leading-6 text-slate-300">
                    {categoria.descripcion}
                </p>
            )
        }

        <span class="mt-5 inline-flex items-center text-sm font-bold text-orange-300">
            Ver categoría
            <span
                class="ml-2 transition-transform group-hover:translate-x-1"
                aria-hidden="true"
            >
                →
            </span>
        </span>
    </div>
</a>
