---
type Props = {
    currentPage: number;
    totalPages: number;
    basePath: string;
};

const { currentPage, totalPages, basePath } = Astro.props;

const getPageUrl = (page: number) => {
    if (page === 1) return basePath;
    return `${basePath}/${page}`;
};
---

{
    totalPages > 1 && (
        <nav class="mt-10 flex items-center justify-center gap-2 text-sm">
            {currentPage > 1 && (
                <a
                    href={getPageUrl(currentPage - 1)}
                    class="rounded border px-3 py-2 hover:bg-gray-100"
                >
                    Anterior
                </a>
            )}

            {Array.from({ length: totalPages }, (_, index) => {
                const page = index + 1;

                return (
                    <a
                        href={getPageUrl(page)}
                        class={`rounded border px-3 py-2 ${
                            page === currentPage
                                ? "bg-black text-white"
                                : "hover:bg-gray-100"
                        }`}
                    >
                        {page}
                    </a>
                );
            })}

            {currentPage < totalPages && (
                <a
                    href={getPageUrl(currentPage + 1)}
                    class="rounded border px-3 py-2 hover:bg-gray-100"
                >
                    Siguiente
                </a>
            )}
        </nav>
    )
}
