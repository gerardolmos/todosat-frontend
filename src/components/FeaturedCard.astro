---
import { getMediaUrl } from "../lib/media";

interface Props {
    destacado: any;
}

const { destacado } = Astro.props;

const imagenUrl = getMediaUrl(destacado.imagen);

const relaciones = [
    destacado.marca && {
        tipo: "Marca",
        href: `/marcas/${destacado.marca.slug}`,
    },
    destacado.modelo && {
        tipo: "Modelo",
        href: `/modelos/${destacado.modelo.slug}`,
    },
    destacado.articulo && {
        tipo: "Artículo",
        href: `/articulos/${destacado.articulo.slug}`,
    },
    destacado.manual && {
        tipo: "Manual",
        href: `/manuales/${destacado.manual.slug}`,
    },
].filter(Boolean);

const href = relaciones.length === 1 ? relaciones[0].href : "#";
const tipo = relaciones.length === 1 ? relaciones[0].tipo : "Destacado";
const tieneRelacionValida = relaciones.length === 1;
---

<a
    href={href}
    class={`group flex h-full min-h-[390px] flex-col overflow-hidden rounded-2xl border border-brand-border bg-white shadow-sm transition-all duration-300 ease-out ${
        tieneRelacionValida
            ? "hover:-translate-y-0.5 hover:border-info-primary/30 hover:shadow-md"
            : "pointer-events-none opacity-60"
    }`}
>
    <div class="h-32 overflow-hidden bg-brand-soft">
        {
            imagenUrl && (
                <img
                    src={imagenUrl}
                    alt={destacado.titulo}
                    class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-103"
                />
            )
        }
    </div>

    <div class="flex flex-1 flex-col p-4">
        <p
            class="mb-4 inline-flex w-fit rounded-full bg-info-primary-soft px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-info-primary"
        >
            {tipo}
        </p>

        <h3
            class="text-2xl font-semibold leading-tight tracking-tight text-brand-base"
        >
            {destacado.titulo}
        </h3>

        {
            destacado.descripcion && (
                <p class="mt-3 line-clamp-3 text-sm leading-6 text-brand-muted">
                    {destacado.descripcion}
                </p>
            )
        }

        {
            tieneRelacionValida && (
                <div class="mt-auto border-t border-brand-border pt-4">
                    <p class="text-sm font-semibold text-info-primary">
                        Ver destacado →
                    </p>
                </div>
            )
        }
    </div>
</a>
