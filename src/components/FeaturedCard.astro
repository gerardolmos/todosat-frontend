---
import { Image } from "astro:assets";
import { getMediaUrl } from "../lib/media";

interface Props {
    destacado: any;
    variant?: "default" | "large";
}

const { destacado, variant = "default" } = Astro.props;

const isLarge = variant === "large";

const imagenUrl = getMediaUrl(destacado.imagen);

const relaciones = [
    destacado.operador && {
        tipo: "Operador",
        href: `/operadores/${destacado.operador.slug}`,
    },
    destacado.hardware && {
        tipo: "Modelo",
        href: `/hardware/${destacado.hardware.slug}`,
    },
    destacado.noticia && {
        tipo: "Artículo",
        href: `/noticias/${destacado.noticia.slug}`,
    },
    destacado.manual && {
        tipo: "Manual",
        href: `/manuales/${destacado.manual.slug}`,
    },
].filter(Boolean);

const relacionPrincipal = relaciones[0];

const href = relacionPrincipal ? relacionPrincipal.href : "#";
const tipo = relacionPrincipal ? relacionPrincipal.tipo : "Destacado";
const tieneRelacionValida = Boolean(relacionPrincipal);
---

<a
    href={href}
    class={`group relative flex ${
        isLarge ? "" : "min-h-[340px] flex-col"
    } overflow-hidden rounded bg-slate-900/90 shadow-sm transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] ${
        isLarge ? "" : "border border-transparent"
    } ${
        tieneRelacionValida
            ? "hover:border-[#005EFF] hover:shadow-[0_0_8px_rgba(0,94,255,0.80),0_0_18px_rgba(0,94,255,0.30)]"
            : "pointer-events-none opacity-60"
    }`}
>
    {
        imagenUrl && (
            <>
                <Image
                    src={imagenUrl}
                    inferSize
                    alt={destacado.titulo}
                    class={`${
                        isLarge
                            ? "absolute inset-0 h-full w-full"
                            : "h-40 w-full"
                    } object-cover transition-transform duration-700 ease-out group-hover:scale-103`}
                />

                <p class="absolute left-5 top-5 z-20 inline-flex rounded-full bg-slate-950/80 px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-blue-300 text-blue-400 backdrop-blur">
                    {tipo}
                </p>
            </>
        )
    }

    {
        isLarge && (
            <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/75 to-slate-950/20" />
        )
    }

    <div
        class={`relative z-10 flex flex-1 flex-col ${
            isLarge ? "max-w-lg p-8 md:p-10" : "p-5"
        }`}
    >
        <h3
            class={`${
                isLarge ? "text-4xl md:text-5xl" : "text-xl"
            } font-semibold leading-tight tracking-tight !text-white`}
        >
            {destacado.titulo}
        </h3>

        {
            destacado.descripcion && (
                <p
                    class={`${
                        isLarge
                            ? "mt-4 mb-4 max-w-xl text-base leading-7"
                            : "mt-3 mb-4 line-clamp-3 text-sm leading-6"
                    } text-slate-300`}
                >
                    {destacado.descripcion}
                </p>
            )
        }

        {
            tieneRelacionValida && (
                <div class="mt-auto border-t border-white/10 pt-5">
                    <p class="text-sm font-semibold text-sky-400">
                        Ver contenido →
                    </p>
                </div>
            )
        }
    </div>
</a>
