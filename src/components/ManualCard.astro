---
import { getMediaUrl } from "../lib/media";
import { formatLabel } from "../lib/format";

interface Props {
    manual: any;
}

const { manual } = Astro.props;
const imagenUrl = getMediaUrl(manual.imagen_portada);
const chipPrincipal = manual.tipo_documento || manual.idioma;

const estadoEditorial = manual.discontinuado
    ? "Discontinuado"
    : manual.descatalogado
      ? "Descatalogado"
      : null;
---

<a
    href={`/manuales/${manual.slug}`}
    class="group flex h-full min-h-[340px] flex-col overflow-hidden rounded border border-transparent bg-slate-900/90 shadow-sm transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] hover:border-[#005EFF] hover:shadow-[0_0_8px_rgba(0,94,255,0.80),0_0_18px_rgba(0,94,255,0.30)]"
>
    <div class="h-40 overflow-hidden bg-slate-800">
        {
            imagenUrl && (
                <img
                    src={imagenUrl}
                    alt={manual.titulo}
                    class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-103"
                />
            )
        }
    </div>

    <div class="relative z-10 flex flex-1 flex-col p-5">
        {
            (chipPrincipal || estadoEditorial) && (
                <div class="mb-4 flex flex-wrap gap-2">
                    {chipPrincipal && (
                        <p class="inline-flex w-fit rounded-full bg-sky-400/15 px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-blue-300">
                            {formatLabel(chipPrincipal)}
                        </p>
                    )}

                    {estadoEditorial && (
                        <p
                            class={`inline-flex w-fit rounded-full border px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] ${
                                manual.discontinuado
                                    ? "border-red-400/50 bg-red-400/10 text-red-300"
                                    : "border-amber-400/50 bg-amber-400/10 text-amber-300"
                            }`}
                        >
                            {estadoEditorial}
                        </p>
                    )}
                </div>
            )
        }

        <h3
            class="text-xl font-semibold leading-tight tracking-tight !text-white"
        >
            {manual.titulo}
        </h3>

        {
            manual.descripcion && (
                <p class="mt-3 mb-4 line-clamp-3 text-sm leading-6 text-slate-300">
                    {manual.descripcion}
                </p>
            )
        }

        <div class="mt-4 flex flex-wrap gap-2 text-xs">
            {
                manual.idioma && manual.tipo_documento && (
                    <span class="rounded-full bg-slate-800 px-3 py-1 font-medium text-slate-300">
                        {formatLabel(manual.idioma)}
                    </span>
                )
            }

            {
                manual.version && (
                    <span class="rounded-full bg-slate-800 px-3 py-1 font-medium text-slate-300">
                        v{manual.version}
                    </span>
                )
            }

            {
                manual.ano_publicacion && (
                    <span class="rounded-full bg-slate-800 px-3 py-1 font-medium text-slate-300">
                        {manual.ano_publicacion}
                    </span>
                )
            }

            {
                manual.oficial && (
                    <span class="rounded-full bg-sky-400/15 px-3 py-1 font-medium text-sky-300">
                        Oficial
                    </span>
                )
            }
        </div>

        <div class="mt-auto border-t border-white/10 pt-5">
            <p class="text-sm font-semibold text-blue-400">Ver manual →</p>
        </div>
    </div>
</a>
