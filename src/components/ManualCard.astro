---
import { getMediaUrl } from "../lib/media";
import { formatLabel } from "../lib/format";

interface Props {
    manual: any;
}

const { manual } = Astro.props;
const imagenUrl = getMediaUrl(manual.imagen_portada);
---

<a
    href={`/manuales/${manual.slug}`}
    class="group block overflow-hidden rounded-2xl border border-brand-border bg-white shadow-sm transition hover:-translate-y-1 hover:border-info-primary/40 hover:shadow-lg"
>
    {
        imagenUrl && (
            <div class="overflow-hidden bg-brand-soft">
                <img
                    src={imagenUrl}
                    alt={manual.titulo}
                    class="h-56 w-full object-cover transition duration-500 group-hover:scale-105"
                />
            </div>
        )
    }

    <div class="p-6">
        {
            manual.idioma && (
                <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-info-primary">
                    {formatLabel(manual.idioma)}
                </p>
            )
        }

        <h3 class="text-2xl font-bold tracking-tight text-brand-base">
            {manual.titulo}
        </h3>

        {
            manual.descripcion && (
                <p class="mt-3 text-sm leading-6 text-brand-muted">
                    {manual.descripcion}
                </p>
            )
        }

        <div class="mt-5 flex flex-wrap gap-2 text-xs">
            {
                manual.version && (
                    <span class="rounded-full bg-brand-soft px-3 py-1 font-medium text-brand-muted">
                        v{manual.version}
                    </span>
                )
            }

            {
                manual.ano_publicacion && (
                    <span class="rounded-full bg-brand-soft px-3 py-1 font-medium text-brand-muted">
                        {manual.ano_publicacion}
                    </span>
                )
            }

            {
                manual.oficial && (
                    <span class="rounded-full bg-info-primary-soft px-3 py-1 font-medium text-info-primary-dark">
                        Oficial
                    </span>
                )
            }
        </div>

        <p class="mt-5 text-sm font-semibold text-info-primary">Ver manual →</p>
    </div>
</a>
