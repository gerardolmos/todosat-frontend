---
import ManualCard from "./ManualCard.astro";
import guiasbg from "../assets/images/guiasbg.png";

interface Props {
    manuales: any[];
}

const { manuales } = Astro.props;
---

<section
    class="relative mt-16 overflow-hidden rounded-3xl bg-slate-950 px-6 py-10 text-white shadow-2xl md:px-8 md:py-12"
>
    <img
        src={guiasbg.src}
        alt=""
        class="pointer-events-none absolute right-0 top-0 h-[430px] w-full object-cover opacity-20"
    />

    <div
        class="absolute left-0 top-0 h-[430px] w-full bg-gradient-to-b from-transparent via-slate-950/40 to-slate-950"
    >
    </div>

    <div class="relative z-10">
        <div>
            <p
                class="inline-flex rounded-full border border-blue-500/50 bg-blue-500/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-blue-400"
            >
                DOCUMENTACIÓN
            </p>

            <h2
                class="mt-6 text-4xl font-bold leading-tight tracking-tight !text-white md:text-5xl"
            >
                Manuales y documentación técnica
            </h2>

            <p class="mt-5 max-w-md text-base leading-7 text-slate-300">
                Manuales, guías, fichas técnicas y documentación práctica para
                instalar, configurar y entender equipos satelitales.
            </p>
        </div>

        <div class="mt-8">
            <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
                {manuales.map((manual: any) => <ManualCard manual={manual} />)}

                <a
                    href="/manuales"
                    class="group flex h-full min-h-[340px] flex-col justify-between overflow-hidden rounded border border-[#00ccff] bg-[#00ccff] p-6 text-slate-950 shadow-[0_0_18px_rgba(0,204,255,0.35)] transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:bg-white hover:shadow-[0_0_24px_rgba(0,204,255,0.65)]"
                >
                    <div>
                        <p
                            class="text-xs font-bold uppercase tracking-[0.16em] text-slate-800"
                        >
                            Biblioteca técnica
                        </p>

                        <h3
                            class="mt-5 text-3xl font-bold leading-tight tracking-tight text-slate-950"
                        >
                            Ver todos los manuales
                        </h3>

                        <p class="mt-4 text-sm leading-6 text-slate-800">
                            Consulta todos los manuales, guías, fichas técnicas
                            y documentos disponibles.
                        </p>
                    </div>

                    <div class="mt-8 border-t border-slate-950/20 pt-5">
                        <p class="text-sm font-bold text-slate-950">
                            Explorar documentación →
                        </p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>
