---
import { getMediaUrl } from "../lib/media";
import { formatLabel } from "../lib/format";

interface Props {
    articulo: any;
}

const { articulo } = Astro.props;
const imagenUrl = getMediaUrl(articulo.imagen_principal);
---

<a
    href={`/articulos/${articulo.slug}`}
    class="group flex h-full min-h-[340px] flex-col overflow-hidden rounded border border-transparent bg-slate-900/90 shadow-sm transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:border-[#00ccff] hover:shadow-[0_0_8px_rgba(0,204,255,0.90),0_0_18px_rgba(0,204,255,0.30)]"
>
    <div class="relative h-40 overflow-hidden bg-slate-800">
        {
            imagenUrl && (
                <>
                    <img
                        src={imagenUrl}
                        alt={articulo.titulo}
                        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-103"
                    />

                    {articulo.tipo_articulo && (
                        <p class="absolute left-5 top-5 z-20 inline-flex rounded-full bg-slate-950/80 px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-sky-300 backdrop-blur">
                            {formatLabel(articulo.tipo_articulo)}
                        </p>
                    )}
                </>
            )
        }
    </div>

    <div class="relative z-10 flex flex-1 flex-col p-5">
        <h3
            class="text-xl font-semibold leading-tight tracking-tight !text-white"
        >
            {articulo.titulo}
        </h3>

        {
            articulo.subtitulo && (
                <p class="mt-3 mb-4 line-clamp-3 text-sm leading-6 text-slate-300">
                    {articulo.subtitulo}
                </p>
            )
        }

        <div class="mt-auto border-t border-white/10 pt-5">
            <p class="text-sm font-semibold text-sky-400">Leer artículo →</p>
        </div>
    </div>
</a>
