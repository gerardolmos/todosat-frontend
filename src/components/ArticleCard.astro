---
import { getMediaUrl } from "../lib/media";
import { formatLabel } from "../lib/format";

interface Props {
    articulo: any;
}

const { articulo } = Astro.props;
const imagenUrl = getMediaUrl(articulo.imagen_principal);
---

<a
    href={`/articulos/${articulo.slug}`}
    class="group flex h-full min-h-[390px] flex-col overflow-hidden rounded-2xl border border-brand-border bg-white shadow-sm transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-info-primary/30 hover:shadow-md"
>
    <div class="h-32 overflow-hidden bg-brand-soft">
        {
            imagenUrl && (
                <img
                    src={imagenUrl}
                    alt={articulo.titulo}
                    class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-103"
                />
            )
        }
    </div>

    <div class="flex flex-1 flex-col p-4">
        {
            articulo.tipo_articulo && (
                <p class="mb-4 inline-flex w-fit rounded-full bg-info-primary-soft px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-info-primary">
                    {formatLabel(articulo.tipo_articulo)}
                </p>
            )
        }

        <h3
            class="text-2xl font-semibold leading-tight tracking-tight text-brand-base"
        >
            {articulo.titulo}
        </h3>

        {
            articulo.subtitulo && (
                <p class="mt-3 line-clamp-3 text-sm leading-6 text-brand-muted">
                    {articulo.subtitulo}
                </p>
            )
        }

        <div class="mt-auto border-t border-brand-border pt-4">
            <p class="text-sm font-semibold text-info-primary">
                Leer artículo →
            </p>
        </div>
    </div>
</a>
