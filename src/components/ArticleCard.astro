---
interface Props {
    articulo: any;
}

const { articulo } = Astro.props;
---

<a
    href={`/articulos/${articulo.slug}`}
    class="block rounded border p-6 hover:bg-gray-50 transition"
>
    <h3 class="text-2xl font-bold">
        {articulo.titulo}
    </h3>

    <p class="mt-2 text-gray-600">
        {articulo.subtitulo}
    </p>

    {
        articulo.tipo_articulo && (
            <p class="mt-4 text-sm text-gray-500">{articulo.tipo_articulo}</p>
        )
    }
</a>
