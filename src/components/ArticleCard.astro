---
import { getMediaUrl } from "../lib/media";

interface Props {
    articulo: any;
}

const { articulo } = Astro.props;
const imagenUrl = getMediaUrl(articulo.imagen_principal);
---

<a
    href={`/articulos/${articulo.slug}`}
    class="block overflow-hidden rounded border hover:bg-gray-50 transition"
>
    {
        imagenUrl && (
            <img
                src={imagenUrl}
                alt={articulo.titulo}
                class="h-56 w-full object-cover"
            />
        )
    }

    <div class="p-6">
        <h3 class="text-2xl font-bold">
            {articulo.titulo}
        </h3>

        {
            articulo.subtitulo && (
                <p class="mt-2 text-gray-600">{articulo.subtitulo}</p>
            )
        }

        {
            articulo.tipo_articulo && (
                <p class="mt-4 text-sm text-gray-500">
                    {articulo.tipo_articulo}
                </p>
            )
        }
    </div>
</a>
