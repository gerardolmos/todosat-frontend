---
import { getMediaUrl } from "../lib/media";
import { getReadingTime } from "../lib/renderBlocks";

interface Props {
    articulo: any;
}

const { articulo } = Astro.props;
const imagenUrl = getMediaUrl(articulo.imagen_principal);

const categoria = articulo.categoria_tematica;
const fecha = articulo.fecha_publicacion
    ? new Date(articulo.fecha_publicacion).toLocaleDateString("es-ES", {
          day: "2-digit",
          month: "short",
          year: "numeric",
      })
    : null;

const readingTime = getReadingTime(articulo.contenido);
---

<a
    href={`/articulos/${articulo.slug}`}
    class="group flex h-full min-h-[380px] flex-col overflow-hidden rounded border border-transparent bg-slate-900/90 shadow-sm transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:border-[#005EFF] hover:shadow-[0_0_8px_rgba(0,94,255,0.90),0_0_18px_rgba(0,94,255,0.30)]"
>
    <div class="relative h-44 overflow-hidden bg-slate-800">
        {
            imagenUrl && (
                <img
                    src={imagenUrl}
                    alt={articulo.titulo}
                    class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                />
            )
        }

        {
            categoria?.nombre && (
                <p class="absolute left-5 top-5 z-20 inline-flex rounded-full bg-slate-950/85 px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-blue-300 backdrop-blur">
                    {categoria.nombre}
                </p>
            )
        }
    </div>

    <div class="relative z-10 flex flex-1 flex-col p-5">
        {
            (fecha || readingTime) && (
                <p class="mb-3 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">
                    {fecha}
                    {fecha && readingTime && " · "}
                    {readingTime && `${readingTime} min lectura`}
                </p>
            )
        }

        <h3
            class="text-xl font-semibold leading-tight tracking-tight !text-white"
        >
            {articulo.titulo}
        </h3>

        {
            articulo.subtitulo && (
                <p class="mt-3 mb-5 line-clamp-3 text-sm leading-6 text-slate-300">
                    {articulo.subtitulo}
                </p>
            )
        }

        <div class="mt-auto border-t border-white/10 pt-5">
            <p class="text-sm font-semibold text-blue-400">Leer artículo →</p>
        </div>
    </div>
</a>
