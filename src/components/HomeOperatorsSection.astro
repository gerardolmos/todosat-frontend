---

import coberturaIcon from "../assets/images/pictostecnicos/cobertura.png";
import velocidadIcon from "../assets/images/pictostecnicos/velocidad.png";
import latenciaIcon from "../assets/images/pictostecnicos/latencia.png";


const { marcas = [] } = Astro.props;

const STRAPI_URL =
	import.meta.env.PUBLIC_STRAPI_URL ||
	import.meta.env.STRAPI_URL ||
	"http://localhost:1337";

function getMediaUrl(media: any) {
	if (!media?.url) return null;
	return media.url.startsWith("http")
		? media.url
		: `${STRAPI_URL}${media.url}`;
}

function getExternalUrl(url: string | null | undefined) {
	if (!url) return null;
	return url.startsWith("http") ? url : `https://${url}`;
}

function getOperatorData(marca: any) {
	const cobertura = marca?.cobertura || "Cobertura en expansión";
	const velocidad = marca?.velocidad || "Velocidad según disponibilidad";
	const latencia = marca?.latencia || "Latencia variable";

	return {
		nombre: marca?.nombre || "Operador",
		slug: marca?.slug || "#",
		logo: getMediaUrl(marca?.logo),
		imagen: getMediaUrl(marca?.imagen_portada),
		descripcion_corta: marca?.descripcion_corta || "Operador satelital",
		descripcion_home:
			marca?.descripcion_home ||
			marca?.descripcion_corta ||
			"Información pendiente de completar.",
		web_oficial: getExternalUrl(marca?.web_oficial),
		tipo_orbita: marca?.tipo_orbita || "Operador satelital",
		features: [
			{
				title: "Cobertura",
				description: cobertura,
				icon: coberturaIcon.src,
			},
			{
				title: "Velocidad",
				description: velocidad,
				icon: velocidadIcon.src,
			},
			{
				title: "Latencia",
				description: latencia,
				icon: latenciaIcon.src,
			},
		],
	};
}

const operators = marcas.map((marca: any) => getOperatorData(marca));
const selectedOperator = operators[0];
---

{
	selectedOperator && (
		<section class="overflow-hidden rounded-3xl bg-slate-950 px-1 py-10 text-white shadow-2xl md:px-10 md:py-20">
			<script
				id="operators-data"
				type="application/json"
				set:html={JSON.stringify(operators)}
			/>

			<div class="grid gap-10 xl:h-[820px] xl:grid-cols-2 xl:items-stretch">
				<div class="flex h-full min-h-0 flex-col">
					<p class="inline-flex w-fit rounded-full border border-blue-500/50 bg-blue-500/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-blue-400">
						Operadores
					</p>

					<h2 class="mt-6 max-w-4xl text-4xl font-bold leading-tight tracking-tight !text-white md:text-5xl">
						Operadores satelitales
					</h2>

					<p class="mt-5 max-w-2xl text-xl leading-7 text-slate-300">
						Explora las principales empresas del ecosistema
						satelital: operadores de internet, constelaciones,
						proveedores de conectividad y compañías clave del
						sector.
					</p>

					<a
						href="/operadores"
						class="self-start mt-8 inline-flex items-center gap-3 rounded border border-[#00ccff] bg-[#00ccff] px-6 py-3 text-sm font-bold text-slate-950 shadow-[0_0_18px_rgba(0,204,255,0.35)] transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:bg-white hover:text-slate-950 hover:shadow-[0_0_24px_rgba(0,204,255,0.65)]"
					>
						Ver operadores en detalle
						<span>→</span>
					</a>

					<div class="mt-8 min-h-0 flex-1 overflow-y-auto pr-2">
    <div class="grid grid-cols-2 gap-3 md:grid-cols-3">
						{operators.map((operator: any, index: number) => (
							<a
	href={`/operadores/${operator.slug}`}
	data-operator-button
	data-index={index}
	class={`group flex h-52 flex-col rounded border p-4 text-left transition-all duration-300 ${
									index === 0
										? "border-[#00ccff] bg-slate-900/80 shadow-[0_0_8px_rgba(0,204,255,0.70),0_0_14px_rgba(0,204,255,0.25)]"
										: "border-transparent bg-slate-900/70 hover:border-[#00ccff] hover:bg-slate-900 hover:shadow-[0_0_8px_rgba(0,204,255,0.70),0_0_14px_rgba(0,204,255,0.25)]"
								}`}
							>
								<div class="flex h-20 items-center justify-center">
									{operator.logo ? (
										<img
											src={operator.logo}
											alt={operator.nombre}
											class="max-h-20 max-w-[180px] object-contain"
										/>
									) : (
										<span class="text-sm font-semibold text-slate-200">
											{operator.nombre}
										</span>
									)}
								</div>

								<p class="mt-2 inline-flex w-fit rounded-full bg-sky-400/15 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.08em] text-sky-300">
									{operator.tipo_orbita}
								</p>

								<h3 class="mt-3 text-lg font-semibold leading-tight !text-white">
									{operator.nombre}
								</h3>

								<p class="mt-2 line-clamp-2 text-xs leading-5 text-slate-300">
									{operator.descripcion_corta}
								</p>
							</a>
						))}
						</div>
					</div>
				</div>

				<div class="relative mt-10 hidden overflow-hidden rounded-2xl border border-white/10 bg-slate-950 shadow-2xl xl:sticky xl:top-24 xl:mt-0 xl:block">
					<img
						data-selected-image
						src={selectedOperator.imagen || ""}
						alt=""
						class={`absolute inset-0 h-full w-full object-cover opacity-70 ${
							selectedOperator.imagen ? "" : "hidden"
						}`}
					/>

					<div class="absolute inset-0 bg-gradient-to-b from-slate-950/20 via-slate-950/55 to-slate-950" />
					<div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/70 to-slate-950/10" />

					<div class="relative flex h-full min-h-0 flex-col overflow-hidden p-8">
					 

						<div class="xl:h-[550px] xl:overflow-y-auto xl:pr-2">
							<img
	data-selected-logo
	src={selectedOperator.logo || ""}
	alt={selectedOperator.nombre}
	class={`max-h-48 max-w-[420px] object-contain ${
		selectedOperator.logo ? "" : "hidden"
	}`}
/>

							<h3
								data-selected-name
								class="mt-8 text-5xl font-bold leading-none tracking-tight !text-white"
							>
								{selectedOperator.nombre}
							</h3>

							<p class="mt-5 inline-flex w-fit rounded-full bg-sky-400/15 px-4 py-2 text-xs font-bold uppercase tracking-[0.12em] text-sky-300">
								<span data-selected-orbit>
									{selectedOperator.tipo_orbita}
								</span>
							</p>

							<p
								data-selected-home
								class="mt-6 max-w-xl text-base leading-7 text-slate-200"
							>
								{selectedOperator.descripcion_home}
							</p>
						</div>

						<div class="mt-6 border-t border-white/10 pt-6">
	<div class="grid gap-6 md:grid-cols-3 xl:grid-cols-3">
		{selectedOperator.features.map((feature: any, index: number) => (
			<div>
				<div class="flex w-20  mb-2">
					<img
						src={feature.icon}
						alt={feature.title}
						class="h-14 w-14 object-contain"
					/>
				</div>

				<p
					data-feature-title={index}
					class="text-lg font-bold !text-white"
				>
					{feature.title}
				</p>

				<p
	data-feature-description={index}
	class=" text-sm font-medium leading-6 text-slate-400"
>
					{feature.description}
				</p>
			</div>
		))}
	</div>
</div>

						<div class="mt-auto pt-10">
							<a
								data-selected-link
								href={`/operadores/${selectedOperator.slug}`}
								class="flex w-full items-center justify-center gap-3 rounded border border-[#00ccff] bg-slate-950/50 px-6 py-4 text-sm font-bold text-[#00ccff] transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:bg-[#00ccff] hover:text-slate-950 hover:shadow-[0_0_24px_rgba(0,204,255,0.65)]"
							>
								Ver detalles del operador
								<span>→</span>
							</a>
						</div>
					</div>
				</div>
			</div>

			<script is:inline>
				const dataElement = document.getElementById("operators-data");
				const operators = JSON.parse(dataElement?.textContent || "[]");

				const buttons = document.querySelectorAll(
					"[data-operator-button]",
				);

				const selectedImage = document.querySelector(
					"[data-selected-image]",
				);
				const selectedLogo = document.querySelector(
					"[data-selected-logo]",
				);
				const selectedName = document.querySelector(
					"[data-selected-name]",
				);
				const selectedHome = document.querySelector(
					"[data-selected-home]",
				);
				const selectedOrbit = document.querySelector(
					"[data-selected-orbit]",
				);
				const selectedLink = document.querySelector(
					"[data-selected-link]",
				);

				function setActiveButton(activeIndex) {
					buttons.forEach((button, index) => {
						const isActive = index === activeIndex;

						button.classList.toggle("border-[#00ccff]", isActive);
						button.classList.toggle("bg-slate-900/80", isActive);
						button.classList.toggle(
							"shadow-[0_0_8px_rgba(0,204,255,0.70),0_0_14px_rgba(0,204,255,0.25)]",
							isActive,
						);

						button.classList.toggle(
							"border-transparent",
							!isActive,
						);
						button.classList.toggle("bg-slate-900/70", !isActive);
					});
				}

				function updateOperator(index) {
					const operator = operators[index];
					if (!operator) return;

					setActiveButton(index);

					if (selectedImage) {
						if (operator.imagen) {
							selectedImage.src = operator.imagen;
							selectedImage.classList.remove("hidden");
						} else {
							selectedImage.classList.add("hidden");
						}
					}

					if (selectedLogo) {
						if (operator.logo) {
							selectedLogo.src = operator.logo;
							selectedLogo.alt = operator.nombre;
							selectedLogo.classList.remove("hidden");
						} else {
							selectedLogo.classList.add("hidden");
						}
					}

					if (selectedName) selectedName.textContent = operator.nombre;
					if (selectedHome)
						selectedHome.textContent = operator.descripcion_home;
					if (selectedOrbit)
						selectedOrbit.textContent = operator.tipo_orbita;

					if (selectedLink) {
						selectedLink.href = `/operadores/${operator.slug}`;
					}

					operator.features.forEach((feature, featureIndex) => {
						const title = document.querySelector(
							`[data-feature-title="${featureIndex}"]`,
						);
						const description = document.querySelector(
							`[data-feature-description="${featureIndex}"]`,
						);

						if (title) title.textContent = feature.title;
						if (description)
							description.textContent = feature.description;
					});
				}

				buttons.forEach((button) => {
					button.addEventListener("click", () => {
						const index = Number(button.dataset.index);
						updateOperator(index);
					});
				});
			</script>
		</section>
	)
}