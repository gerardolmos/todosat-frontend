---
const { marcas = [] } = Astro.props;

const STRAPI_URL =
    import.meta.env.PUBLIC_STRAPI_URL ||
    import.meta.env.STRAPI_URL ||
    "http://localhost:1337";

function getMediaUrl(media: any) {
    if (!media?.url) return null;
    return media.url.startsWith("http")
        ? media.url
        : `${STRAPI_URL}${media.url}`;
}

function getExternalUrl(url: string | null | undefined) {
    if (!url) return null;
    return url.startsWith("http") ? url : `https://${url}`;
}

const selectedMarca = marcas[0];

const selectedLogo = getMediaUrl(selectedMarca?.logo);
const selectedImage = getMediaUrl(selectedMarca?.imagen_portada);

const metrics = [
    {
        label: "Cobertura",
        value: selectedMarca?.cobertura || "Sin datos",
        description: selectedMarca?.cobertura_descripcion,
    },
    {
        label: "Órbita",
        value: selectedMarca?.tipo_orbita || "Sin datos",
        description: selectedMarca?.orbita_descripcion,
    },
    {
        label: "Satélites",
        value: selectedMarca?.satelites || "Sin datos",
        description: selectedMarca?.satelites_descripcion,
    },
    {
        label: "Latencia",
        value: selectedMarca?.latencia || "Sin datos",
        description: selectedMarca?.latencia_descripcion,
    },
    {
        label: "Velocidad",
        value: selectedMarca?.velocidad || "Sin datos",
        description: selectedMarca?.velocidad_descripcion,
    },
];

const officialUrl = getExternalUrl(selectedMarca?.web_oficial);
---

{
    selectedMarca && (
        <section class="overflow-hidden rounded-3xl bg-slate-950 px-6 py-10 text-white shadow-2xl md:px-10 md:py-20">
            <div class="grid gap-10 lg:grid-cols-4">
                <div class="lg:col-span-1">
                    <p class="inline-flex rounded-full border border-blue-500/50 bg-blue-500/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-blue-400">
                        Operadores
                    </p>

                    <h2 class="mt-6 text-4xl font-black leading-tight tracking-tight !text-white">
                        Operadores y compañías satelitales
                    </h2>

                    <p class="mt-5 text-base leading-7 text-slate-300">
                        Explora las principales empresas del ecosistema
                        satelital: operadores de internet, constelaciones,
                        proveedores de conectividad y compañías clave del
                        sector.
                    </p>

                    <a
                        href="/marcas"
                        class="mt-8 inline-flex items-center gap-3 rounded-full border border-blue-500 px-5 py-3 text-sm font-bold text-blue-400 transition hover:bg-blue-500 hover:text-white"
                    >
                        Ver todas las marcas
                        <span>→</span>
                    </a>
                </div>

                <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-5 lg:col-span-3">
                    {marcas.map((marca: any, index: number) => {
                        const logoUrl = getMediaUrl(marca.logo);

                        return (
                            <button
                                type="button"
                                class={`flex h-40 flex-col justify-between rounded-xl border p-4 text-center text-white transition ${
                                    index === 0
                                        ? "border-blue-500 bg-blue-500/10 shadow-lg shadow-blue-950"
                                        : "border-slate-700 bg-slate-900/70 hover:border-blue-500/70 hover:bg-slate-900"
                                }`}
                            >
                                <div class="flex h-16 items-center justify-center">
                                    <div class="flex h-16 w-32 items-center justify-center">
                                        {logoUrl ? (
                                            <img
                                                src={logoUrl}
                                                alt={marca.nombre}
                                                class="max-h-full max-w-full object-contain"
                                            />
                                        ) : (
                                            <span class="text-sm font-semibold text-slate-200">
                                                {marca.nombre}
                                            </span>
                                        )}
                                    </div>
                                </div>

                                <div class="h-10">
                                    <p class="text-sm font-normal leading-tight !text-slate-200">
                                        {marca.nombre}
                                    </p>

                                    <p class="text-xs leading-tight !text-slate-400">
                                        {marca.tipo_orbita ||
                                            "Operador satelital"}
                                    </p>
                                </div>
                            </button>
                        );
                    })}
                </div>
            </div>

            <div class="relative mt-10 overflow-hidden rounded-2xl bg-slate-950">
                {selectedImage && (
                    <img
                        src={selectedImage}
                        alt=""
                        class="absolute inset-0 h-full w-full object-cover opacity-65"
                    />
                )}

                <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/80 to-slate-950/10" />

                <div class="relative p-8 md:p-10">
                    <div class="max-w-xl">
                        <div class="flex items-center gap-3">
                            {selectedLogo && (
                                <img
                                    src={selectedLogo}
                                    alt={selectedMarca.nombre}
                                    class="h-24 max-w-32 object-contain"
                                />
                            )}
                        </div>

                        <p class="mt-4 text-5xl font-semibold leading-none tracking-tight !text-white">
                            {selectedMarca.nombre}
                        </p>

                        <p class="text-xl leading-7 text-slate-100">
                            {selectedMarca.descripcion_corta ||
                                "Operador satelital"}
                        </p>

                        <p class="mt-2 text-sm leading-7 text-slate-400">
                            {selectedMarca.descripcion_home ||
                                selectedMarca.descripcion_corta ||
                                "Información pendiente de completar."}
                        </p>

                        <div class="mt-7 flex flex-wrap gap-3">
                            <a
                                href={`/marcas/${selectedMarca.slug}`}
                                class="inline-flex items-center gap-3 rounded-full bg-blue-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-blue-500"
                            >
                                Ver operador
                                <span>→</span>
                            </a>

                            {officialUrl && (
                                <a
                                    href={officialUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-3 rounded-full border border-slate-600 bg-slate-950/40 px-6 py-3 text-sm font-bold text-white transition hover:border-blue-500 hover:text-blue-400"
                                >
                                    Sitio oficial
                                    <span>↗</span>
                                </a>
                            )}
                        </div>
                    </div>
                </div>

                <div class="relative grid border-t border-slate-800 bg-slate-950/80 backdrop-blur md:grid-cols-5">
                    {metrics.map((item) => (
                        <div class="p-5 md:border-r md:border-slate-800 last:border-r-0">
                            <p class="text-xs font-bold uppercase tracking-widest text-blue-400">
                                {item.label}
                            </p>

                            <p class="mt-2 text-lg font-bold !text-white">
                                {item.value}
                            </p>
                        </div>
                    ))}
                </div>
            </div>
        </section>
    )
}
