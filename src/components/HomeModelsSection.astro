---
import { Picture } from "astro:assets";
import ModelCard from "./ModelCard.astro";
import equiposBg from "../assets/images/equiposbg.png";

interface Props {
    modelos: any[];
}

const { modelos } = Astro.props;
---

<section
    class="relative mt-16 overflow-hidden rounded-3xl bg-slate-950 px-6 py-14 text-white shadow-2xl md:px-10 md:py-20"
>
    <Picture
        src={equiposBg}
        formats={["avif", "webp"]}
        fallbackFormat="png"
        widths={[192, 288]}
        sizes="288px"
        alt=""
        quality={100}
        loading="lazy"
        decoding="async"
        aria-hidden="true"
        class="pointer-events-none absolute right-10 top-18 z-10 hidden h-48 w-48 object-contain md:h-56 md:w-72 lg:block"
    />

    <div
        class="absolute left-0 top-0 h-[430px] w-full bg-gradient-to-b from-transparent via-slate-950/40 to-slate-950"
    >
    </div>

    <div class="relative z-10">
        <div>
            <p
                class="inline-flex rounded-full border border-blue-500/50 bg-blue-500/25 px-4 py-2 text-xs font-bold uppercase tracking-widest text-blue-400"
            >
                HARDWARE
            </p>

            <h2
                class="mt-6 text-4xl font-bold leading-tight tracking-tight !text-white md:text-5xl"
            >
                Hardware satelital
            </h2>

            <p class="mt-5 max-w-2xl text-xl leading-8 text-slate-300">
                Antenas, routers, kits de instalación y terminales utilizados
                para acceder a servicios de conectividad satelital.
            </p>
        </div>

        <div class="mt-8">
            <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
                {modelos.map((modelo: any) => <ModelCard modelo={modelo} />)}

                <a
                    href="/hardware"
                    class="group flex h-full min-h-[340px] flex-col justify-between overflow-hidden rounded border border-[#00ccff] bg-[#00ccff] p-6 text-slate-950 shadow-[0_0_18px_rgba(0,204,255,0.35)] transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:bg-white hover:shadow-[0_0_24px_rgba(0,204,255,0.65)]"
                >
                    <div>
                        <p
                            class="text-xs font-bold uppercase tracking-[0.16em] text-slate-800"
                        >
                            Catálogo completo
                        </p>

                        <h3
                            class="mt-5 text-3xl font-bold leading-tight tracking-tight text-slate-950"
                        >
                            Ver todos los modelos
                        </h3>

                        <p class="mt-4 text-sm leading-6 text-slate-800">
                            Explora todos los equipos, antenas, routers y
                            terminales disponibles en el portal.
                        </p>
                    </div>

                    <div class="mt-8 border-t border-slate-950/20 pt-5">
                        <p class="text-sm font-bold text-slate-950">
                            Explorar hardware →
                        </p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>
