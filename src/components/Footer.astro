---
import logoTodoSatcom from "../assets/logoTodoSatcom.png";
---

<footer class="border-t border-white/10 bg-slate-950 text-white">
    <div class="mx-auto max-w-7xl px-6 py-14">
        <div class="grid gap-12 lg:grid-cols-[1.4fr_auto_auto]">
            <div>
                <img
                    src={logoTodoSatcom.src}
                    alt="TodoSatcom"
                    class="w-[240px]"
                />

                <p class="mt-4 max-w-md text-sm leading-7 text-slate-400">
                    Operadores, hardware, manuales y actualidad sobre el
                    ecosistema satelital.
                </p>
            </div>

            <div>
                <p
                    class="mb-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500"
                >
                    Explorar
                </p>

                <nav class="flex flex-col gap-2">
                    <a
                        href="/operadores"
                        class="text-sm text-slate-400 transition-colors hover:text-white font-light"
                    >
                        Operadores
                    </a>

                    <a
                        href="/modelos"
                        class="text-sm text-slate-400 transition-colors hover:text-white font-light"
                    >
                        Hardware
                    </a>

                    <a
                        href="/articulos"
                        class="text-sm text-slate-400 transition-colors hover:text-white font-light"
                    >
                        Actualidad
                    </a>

                    <a
                        href="/manuales"
                        class="text-sm text-slate-400 transition-colors hover:text-white font-light"
                    >
                        Manuales
                    </a>

                    <a
                        href="/buscar"
                        class="text-sm text-blue-400 transition-colors hover:text-blue-300"
                    >
                        Buscar →
                    </a>
                </nav>
            </div>

            <div>
                <p
                    class="mb-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500"
                >
                    Legal
                </p>

                <nav class="flex flex-col gap-2">
                    <a
                        href="/aviso-legal"
                        class="text-sm text-slate-400 transition-colors hover:text-white font-light"
                    >
                        Aviso legal
                    </a>

                    <a
                        href="/privacidad"
                        class="text-sm text-slate-400 transition-colors hover:text-white font-light"
                    >
                        Privacidad
                    </a>

                    <a
                        href="/cookies"
                        class="text-sm text-slate-400 transition-colors hover:text-white font-light"
                    >
                        Cookies
                    </a>

                    <a
                        href="/contacto"
                        class="text-sm text-slate-400 transition-colors hover:text-white font-light"
                    >
                        Contacto
                    </a>
                </nav>
            </div>
        </div>

        <div class="mt-12 border-t border-white/10 pt-5">
            <p class="text-xs text-slate-500">
                © {new Date().getFullYear()} TodoSatcom.
            </p>
        </div>
    </div>
</footer>
