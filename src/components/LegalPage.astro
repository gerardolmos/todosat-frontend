---
import Layout from "../layouts/Layout.astro";

interface Props {
    title: string;
    description: string;
    robots?: string;
    contact?: boolean;
}

const { title, description, robots = "noindex, follow", contact = false } = Astro.props;
---

<Layout title={`${title} | TodoSatcom`} description={description} robots={robots}>
    <main class:list={["legal-page", { "legal-contact": contact }]}>
        <div class="legal-heading">
            <div class="legal-width">
                <h1>{title}</h1>
            </div>
        </div>
        <div class="legal-body">
            <div class="legal-width">
                <div class="legal-content">
                    <slot />
                </div>
            </div>
        </div>
    </main>
</Layout>

<style>
    :global(body:has(> .legal-page)) {
        min-height: 100vh;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
    }
    :global(body:has(> .legal-page) > header),
    :global(body:has(> .legal-page) > footer) { flex-shrink: 0; }
    .legal-page { flex: 1 0 auto; background: #f1f5f9; color: #334155; }
    .legal-width { width: min(100% - 2rem, 48rem); margin-inline: auto; }
    .legal-heading {
        background: linear-gradient(115deg, #020617, #0f172a);
        color: #f8fafc;
        padding-block: clamp(2.5rem, 5vw, 4rem);
        border-bottom: 3px solid #0284c7;
    }
    h1 {
        margin: 0;
        font-size: clamp(2rem, 4.5vw, 3.25rem);
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: -.035em;
        overflow-wrap: anywhere;
    }
    .legal-body { padding-block: clamp(1.5rem, 4vw, 3rem); }
    .legal-content {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: .75rem;
        padding: clamp(1.25rem, 4vw, 3rem);
        box-shadow: 0 4px 20px rgb(15 23 42 / .035);
        font-size: 1rem;
        line-height: 1.8;
        overflow-wrap: anywhere;
    }
    .legal-content :global(p) { margin-block: 1rem; }
    .legal-content :global(h2) {
        color: #0f172a;
        font-size: clamp(1.2rem, 2.5vw, 1.5rem);
        font-weight: 700;
        line-height: 1.35;
        letter-spacing: -.02em;
        margin-block: 2.25rem 1rem;
        padding-top: 1.75rem;
        border-top: 1px solid #e2e8f0;
    }
    .legal-content :global(> :first-child) { margin-top: 0; padding-top: 0; border-top: 0; }
    .legal-content :global(> :last-child) { margin-bottom: 0; }
    .legal-content :global(strong) { color: #0f172a; font-weight: 700; }
    .legal-content :global(ul) { list-style: disc; padding-inline-start: 1.4rem; margin-block: 1rem; }
    .legal-content :global(li) { padding-inline-start: .2rem; margin-block: .5rem; }
    .legal-content :global(li::marker) { color: #0369a1; }
    .legal-content :global(a) { display: inline-block; max-width: 100%; vertical-align: baseline; color: #0369a1; text-decoration: underline; text-underline-offset: .2em; text-decoration-thickness: 1px; }
    .legal-content :global(a:hover) { color: #075985; text-decoration-thickness: 2px; }
    .legal-content :global(a:focus-visible) { outline: 3px solid #0369a1; outline-offset: 4px; border-radius: .15rem; }
    .legal-contact .legal-content :global(p:first-child > strong) {
        display: block;
        margin-block: 1.5rem;
    }
    .legal-contact .legal-content :global(p:first-child a) {
        font-size: inherit;
        line-height: inherit;
    }
</style>
