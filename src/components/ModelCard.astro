---
interface Props {
    modelo: any;
}

const { modelo } = Astro.props;
---

<a
    href={`/modelos/${modelo.slug}`}
    class="block rounded border p-6 hover:bg-gray-50 transition"
>
    <h3 class="text-2xl font-bold">
        {modelo.nombre}
    </h3>

    <p class="mt-2 text-gray-600">
        {modelo.descripcion_corta}
    </p>
</a>
