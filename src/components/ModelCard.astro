---
import { getMediaUrl } from "../lib/media";

interface Props {
    modelo: any;
}

const { modelo } = Astro.props;
const imagenUrl = getMediaUrl(modelo.imagen_principal);

const estadoEditorial = modelo.discontinuado
    ? "Discontinuado"
    : modelo.descatalogado
      ? "Descatalogado"
      : null;
---

<a
    href={`/hardware/${modelo.slug}`}
    class="group flex h-full min-h-[340px] flex-col overflow-hidden rounded border border-transparent bg-slate-900/90 shadow-sm transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] hover:border-[#005EFF] hover:shadow-[0_0_8px_rgba(0,94,255,0.80),0_0_18px_rgba(0,94,255,0.30)]"
>
    <div class="relative h-56 overflow-hidden bg-slate-800">
        {
            imagenUrl && (
                <>
                    <img
                        src={imagenUrl}
                        alt={modelo.nombre}
                        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-103"
                    />

                    <div class="absolute left-3 top-3 z-20 flex flex-wrap gap-1.5 md:left-5 md:top-5 md:gap-2">
                        {modelo.operador && (
                            <p class="inline-flex rounded-full bg-slate-950/80 px-2 py-0.5 text-[10px] tracking-[0.08em] md:px-3 md:py-1 md:text-xs md:tracking-[0.12em] font-bold uppercase text-blue-300 backdrop-blur">
                                {modelo.operador.nombre}
                            </p>
                        )}

                        {modelo.tipo_hardware && (
                            <p class="inline-flex rounded-full bg-blue-600/90 px-2 py-0.5 text-[10px] tracking-[0.08em] md:px-3 md:py-1 md:text-xs md:tracking-[0.12em] font-bold uppercase text-white backdrop-blur">
                                {modelo.tipo_hardware}
                            </p>
                        )}

                        {estadoEditorial && (
                            <p
                                class={`inline-flex rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.08em] backdrop-blur md:px-3 md:py-1 md:text-xs md:tracking-[0.12em] ${
                                    modelo.discontinuado
                                        ? "border-red-400/60 bg-red-950/85 text-red-200"
                                        : "border-amber-400/60 bg-amber-950/85 text-amber-200"
                                }`}
                            >
                                {estadoEditorial}
                            </p>
                        )}
                    </div>
                </>
            )
        }
    </div>

    <div class="relative z-10 flex flex-1 flex-col p-5">
        <h3
            class="text-xl font-semibold leading-tight tracking-tight !text-white"
        >
            {modelo.nombre}
        </h3>

        {
            modelo.descripcion_corta && (
                <p class="mt-3 mb-4 line-clamp-3 text-sm leading-6 text-slate-300">
                    {modelo.descripcion_corta}
                </p>
            )
        }

        <div class="mt-auto border-t border-white/10 pt-5">
            <p class="text-sm font-semibold text-blue-400">Ver modelo →</p>
        </div>
    </div>
</a>
