---
import { getMediaUrl } from "../lib/media";

interface Props {
    modelo: any;
}

const { modelo } = Astro.props;
const imagenUrl = getMediaUrl(modelo.imagen_principal);
---

<a
    href={`/modelos/${modelo.slug}`}
    class="group flex h-full min-h-[340px] flex-col overflow-hidden rounded-2xl border border-white/15 bg-slate-900/90 shadow-sm transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-blue-400/50 hover:shadow-md"
>
    <div class="h-40 overflow-hidden bg-slate-800">
        {
            imagenUrl && (
                <img
                    src={imagenUrl}
                    alt={modelo.nombre}
                    class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-103"
                />
            )
        }
    </div>

    <div class="relative z-10 flex flex-1 flex-col p-5">
        {
            modelo.marca && (
                <p class="mb-4 inline-flex w-fit rounded-full bg-sky-400/15 px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-sky-300">
                    {modelo.marca.nombre}
                </p>
            )
        }

        <h3
            class="text-xl font-semibold leading-tight tracking-tight !text-white"
        >
            {modelo.nombre}
        </h3>

        {
            modelo.descripcion_corta && (
                <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-300">
                    {modelo.descripcion_corta}
                </p>
            )
        }

        <div class="mt-auto border-t border-white/10 pt-5">
            <p class="text-sm font-semibold text-sky-400">Ver modelo →</p>
        </div>
    </div>
</a>
