---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import { getNoticias, getCategoriasNoticia } from "../../lib/content";
import ArticleCard from "../../components/ArticleCard.astro";
import Pagination from "../../components/Pagination.astro";
import { Image, Picture } from "astro:assets";
import { getMediaUrl } from "../../lib/media";
import todasIcon from "../../assets/images/categoryPictos/todas.png";

export async function getStaticPaths() {
    const PAGE_SIZE = 9;

    type OrdenArticulos = "recientes" | "antiguos";

    function getFechaPublicacionTime(articulo: any) {
        if (!articulo.fecha_publicacion) return null;

        const time = new Date(articulo.fecha_publicacion).getTime();

        return Number.isNaN(time) ? null : time;
    }

    function ordenarArticulos(data: any[], orden: OrdenArticulos) {
        return [...data].sort((a: any, b: any) => {
            const timeA = getFechaPublicacionTime(a);
            const timeB = getFechaPublicacionTime(b);

            if (timeA === null && timeB === null) return 0;
            if (timeA === null) return 1;
            if (timeB === null) return -1;

            return orden === "antiguos" ? timeA - timeB : timeB - timeA;
        });
    }

    function createPage(data: any[], currentPage: number) {
        const totalPages = Math.ceil(data.length / PAGE_SIZE) || 1;
        const start = (currentPage - 1) * PAGE_SIZE;

        return {
            data: data.slice(start, start + PAGE_SIZE),
            currentPage,
            lastPage: totalPages,
        };
    }

    function createPaginatedPaths({
        articulosBase,
        baseSegments,
        categorias,
        categoriaActual,
        ordenActual,
    }: any) {
        const articulosOrdenados = ordenarArticulos(articulosBase, ordenActual);

        const totalPages =
            Math.ceil(articulosOrdenados.length / PAGE_SIZE) || 1;

        const paths = [];

        for (let pageNumber = 1; pageNumber <= totalPages; pageNumber++) {
            paths.push({
                params: {
                    page:
                        pageNumber === 1
                            ? baseSegments.join("/") || undefined
                            : [...baseSegments, String(pageNumber)].join("/"),
                },
                props: {
                    page: createPage(articulosOrdenados, pageNumber),
                    categorias,
                    categoriaActual,
                    ordenActual,
                },
            });
        }

        return paths;
    }

    const articulos = await getNoticias();
    const categorias = await getCategoriasNoticia();

    const paths: any[] = [];

    paths.push(
        ...createPaginatedPaths({
            articulosBase: articulos,
            baseSegments: [],
            categorias,
            categoriaActual: null,
            ordenActual: "recientes",
        }),
    );

    paths.push(
        ...createPaginatedPaths({
            articulosBase: articulos,
            baseSegments: ["orden", "antiguos"],
            categorias,
            categoriaActual: null,
            ordenActual: "antiguos",
        }),
    );

    categorias.forEach((categoria: any) => {
        const categoriaSlug = String(categoria.slug);

        const articulosCategoria = articulos.filter(
            (articulo: any) =>
                articulo.categoria_noticia?.slug === categoriaSlug,
        );

        paths.push(
            ...createPaginatedPaths({
                articulosBase: articulosCategoria,
                baseSegments: [categoriaSlug],
                categorias,
                categoriaActual: categoria,
                ordenActual: "recientes",
            }),
        );

        paths.push(
            ...createPaginatedPaths({
                articulosBase: articulosCategoria,
                baseSegments: [categoriaSlug, "orden", "antiguos"],
                categorias,
                categoriaActual: categoria,
                ordenActual: "antiguos",
            }),
        );
    });

    return paths;
}

const {
    page,
    categorias,
    categoriaActual,
    ordenActual = "recientes",
} = Astro.props as any;

const currentPage = page.currentPage;
const pageSuffix = currentPage > 1 ? ` — Página ${currentPage}` : "";

const sectionName = categoriaActual
    ? `Noticias de ${categoriaActual.nombre}`
    : "Noticias y actualidad satelital";

const title = `${sectionName}${pageSuffix} | TodoSatcom`;

const descriptionBase =
    categoriaActual?.descripcion ||
    "Noticias, análisis y novedades sobre operadores, internet satelital, hardware, cobertura y comunicaciones satelitales.";

const description =
    currentPage > 1
        ? `${descriptionBase} Página ${currentPage}.`
        : descriptionBase;

const recentBasePath = categoriaActual
    ? `/noticias/${categoriaActual.slug}`
    : "/noticias";

const canonicalPath =
    currentPage > 1
        ? `${recentBasePath}/${currentPage}`
        : recentBasePath;

const robots =
    ordenActual === "antiguos" ? "noindex, follow" : "index, follow";

const basePath =
    ordenActual === "antiguos"
        ? categoriaActual
            ? `/noticias/${categoriaActual.slug}/orden/antiguos`
            : "/noticias/orden/antiguos"
        : categoriaActual
          ? `/noticias/${categoriaActual.slug}`
          : "/noticias";

const ordenRecientesUrl = categoriaActual
    ? `/noticias/${categoriaActual.slug}`
    : "/noticias";

const ordenAntiguosUrl = categoriaActual
    ? `/noticias/${categoriaActual.slug}/orden/antiguos`
    : "/noticias/orden/antiguos";

const heroIconUrl = categoriaActual ? getMediaUrl(categoriaActual.icono) : null;
---

<Layout
    title={title}
    description={description}
    canonical={canonicalPath}
    robots={robots}
>
    <main class="min-h-screen bg-slate-950 py-10 text-white">
        <Container>
            <section
                class="relative mb-10 flex min-h-[320px] overflow-hidden rounded-3xl border border-white/10 bg-slate-950 px-6 py-10 shadow-2xl md:min-h-[430px] md:px-12 md:py-10"
            >
                <div
                    class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(0,94,255,0.24),transparent_35%),radial-gradient(circle_at_bottom_left,rgba(78,161,255,0.13),transparent_32%)]"
                >
                </div>
                <div
                    class="absolute inset-0 bg-[linear-gradient(120deg,transparent_0%,rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[length:48px_48px] opacity-20"
                >
                </div>

                {
                    categoriaActual ? (
                        heroIconUrl && (
                            <img
                                src={heroIconUrl}
                                alt=""
                                class="pointer-events-none absolute right-12 top-1/2 hidden h-72 w-72 -translate-y-1/2 rounded-full object-contain opacity-80 md:block"
                            />
                        )
                    ) : (
                        <Picture
                            src={todasIcon}
                            formats={["avif", "webp"]}
                            fallbackFormat="png"
                            widths={[288]}
                            sizes="288px"
                            alt=""
                            loading="lazy"
                            decoding="async"
                            aria-hidden="true"
                            class="pointer-events-none absolute right-12 top-1/2 hidden h-72 w-72 -translate-y-1/2 rounded-full object-contain opacity-80 md:block"
                        />
                    )
                }

                <div
                    class="relative z-10 flex max-w-4xl flex-col justify-center"
                >
                    <p
                        class="inline-flex w-fit rounded-full border border-blue-500/40 bg-blue-500/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.2em] text-blue-400"
                    >
                        Actualidad satelital
                    </p>

                    <h1
                        class="mt-6 max-w-3xl text-3xl font-bold leading-tight tracking-tight !text-white md:text-6xl"
                    >
                        {
                            categoriaActual
                                ? categoriaActual.nombre
                                : "Noticias y actualidad"
                        }
                    </h1>

                    <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300">
                        {
                            categoriaActual?.descripcion ||
                                "Noticias, análisis, guías y contenidos para entender mejor los operadores, equipos, servicios y tendencias del ecosistema satelital."
                        }
                    </p>

                    <div class="mt-8 flex flex-wrap gap-3">
                        <span
                            class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-slate-200"
                        >
                            Noticias
                        </span>
                        <span
                            class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-slate-200"
                        >
                            Guías
                        </span>
                        <span
                            class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-slate-200"
                        >
                            Comparativas
                        </span>
                        <span
                            class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-slate-200"
                        >
                            Análisis
                        </span>
                    </div>
                </div>
            </section>

            <div class="grid gap-10 lg:grid-cols-[260px_1fr]">
                <div class="mb-8 lg:hidden">
                    <label class="block">
                        <span
                            class="mb-2 block text-xs font-bold uppercase tracking-[0.2em] text-blue-400"
                        >
                            Categoría
                        </span>

                        <div class="relative">
                            <select
                                class="w-full appearance-none rounded border border-white/10 bg-slate-950 px-4 py-3 text-sm font-semibold text-slate-200 outline-none"
                                onchange="window.location.href = this.value"
                            >
                                <option
                                    value="/noticias"
                                    selected={!categoriaActual}
                                >
                                    Todas
                                </option>

                                {
                                    categorias.map((categoria: any) => (
                                        <option
                                            value={`/noticias/${categoria.slug}`}
                                            selected={
                                                categoriaActual?.slug ===
                                                categoria.slug
                                            }
                                        >
                                            {categoria.nombre}
                                        </option>
                                    ))
                                }
                            </select>

                            <svg
                                class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </div>
                    </label>
                </div>

                <aside
                    class="hidden lg:sticky lg:top-24 lg:block lg:self-start"
                >
                    <div>
                        <p
                            class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-blue-400"
                        >
                            Categorías
                        </p>

                        <nav>
                            <a
                                href="/noticias"
                                class={`group flex items-center gap-4 border-b border-white/10 px-1 py-2.5 transition-all duration-200 hover:bg-slate-900/30 ${
                                    !categoriaActual
                                        ? "text-blue-400"
                                        : "text-white"
                                }`}
                            >
                                <Image
                                    src={todasIcon}
                                    alt="Todas las categorías"
                                    width={72}
                                    height={72}
                                    loading="lazy"
                                    quality={100}
                                    decoding="async"
                                    class="h-18 w-18 object-contain transition-transform duration-300 group-hover:scale-110"
                                />

                                <span class="font-semibold"> Todas </span>
                            </a>

                            {
                                categorias.map((categoria: any) => {
                                    const iconoUrl = getMediaUrl(
                                        categoria.icono,
                                    );

                                    return (
                                        <a
                                            href={`/noticias/${categoria.slug}`}
                                            class={`group flex items-center gap-4 border-b border-white/10 px-1 py-2.5 transition-all duration-200 hover:bg-slate-900/30 ${
                                                categoriaActual?.slug ===
                                                categoria.slug
                                                    ? "text-blue-400"
                                                    : "text-white"
                                            }`}
                                        >
                                            {iconoUrl && (
                                                <img
                                                    src={iconoUrl}
                                                    alt={categoria.nombre}
                                                    class="h-18 w-18 object-contain transition-transform duration-300 group-hover:scale-110"
                                                />
                                            )}

                                            <span class="font-semibold">
                                                {categoria.nombre}
                                            </span>
                                        </a>
                                    );
                                })
                            }
                        </nav>
                    </div>
                </aside>

                <section>
                    <div
                        class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
                    >
                        <p class="text-sm text-slate-400">
                            {page.data.length} artículos en esta página
                        </p>

                        <label class="block w-full sm:w-64">
                            <span class="sr-only">Ordenar artículos</span>

                            <div class="relative">
                                <select
                                    class="w-full appearance-none rounded border border-white/10 bg-slate-950 px-4 py-3 text-sm font-semibold text-slate-200 outline-none transition hover:border-blue-500/50"
                                    onchange="window.location.href = this.value"
                                >
                                    <option
                                        value={ordenRecientesUrl}
                                        selected={ordenActual === "recientes"}
                                    >
                                        Más recientes primero
                                    </option>

                                    <option
                                        value={ordenAntiguosUrl}
                                        selected={ordenActual === "antiguos"}
                                    >
                                        Más antiguos primero
                                    </option>
                                </select>

                                <svg
                                    class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </div>
                        </label>
                    </div>

                    {
                        page.data.length > 0 ? (
                            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                                {page.data.map((articulo: any) => (
                                    <ArticleCard articulo={articulo} />
                                ))}
                            </div>
                        ) : (
                            <p class="rounded border border-white/10 bg-slate-900 p-6 text-slate-300">
                                Todavía no hay artículos en esta categoría.
                            </p>
                        )
                    }

                    <Pagination
                        currentPage={page.currentPage}
                        totalPages={page.lastPage}
                        basePath={basePath}
                    />
                </section>
            </div>
        </Container>
    </main></Layout
>
