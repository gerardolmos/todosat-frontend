---
import Layout from "../../../layouts/Layout.astro";
import { getNoticias } from "../../../lib/content";
import { renderBlocks, getReadingTime } from "../../../lib/renderBlocks";
import { getMediaUrl } from "../../../lib/media";
import Container from "../../../components/Container.astro";
import RelatedCard from "../../../components/RelatedCard.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";

export async function getStaticPaths() {
    const articulos = await getNoticias();

    return articulos.map((articulo: any) => ({
        params: {
            slug: articulo.slug,
        },
        props: {
            articulo,
        },
    }));
}

const { articulo } = Astro.props as any;

const contenidoHTML = renderBlocks(articulo.contenido);
const imagenUrl = getMediaUrl(articulo.imagen_principal);

const categoria = articulo.categoria_noticia;
const marcas = articulo.operadores || [];
const modelos = articulo.hardwares || [];
const manuales = articulo.manuales || [];

const todosLosArticulos = await getNoticias();

const marcasSlugs = new Set(
    marcas.map((marca: any) => marca.slug).filter(Boolean),
);

const articulosRelacionados = todosLosArticulos
    .filter(
        (articuloRelacionado: any) =>
            articuloRelacionado.slug !== articulo.slug,
    )
    .map((articuloRelacionado: any) => {
        const comparteCategoria =
            categoria?.slug &&
            articuloRelacionado.categoria_noticia?.slug === categoria.slug;

        const comparteMarca = articuloRelacionado.operadores?.some(
            (marcaRelacionada: any) => marcasSlugs.has(marcaRelacionada.slug),
        );

        const score = (comparteMarca ? 2 : 0) + (comparteCategoria ? 1 : 0);

        return {
            articulo: articuloRelacionado,
            score,
        };
    })
    .filter((item: any) => item.score > 0)
    .sort((a: any, b: any) => {
        if (b.score !== a.score) return b.score - a.score;

        const fechaA = a.articulo.fecha_publicacion
            ? new Date(a.articulo.fecha_publicacion).getTime()
            : 0;

        const fechaB = b.articulo.fecha_publicacion
            ? new Date(b.articulo.fecha_publicacion).getTime()
            : 0;

        return fechaB - fechaA;
    })
    .slice(0, 4)
    .map((item: any) => item.articulo);

const fecha = articulo.fecha_publicacion
    ? new Date(articulo.fecha_publicacion).toLocaleDateString("es-ES", {
          day: "2-digit",
          month: "long",
          year: "numeric",
      })
    : null;

const readingTime = getReadingTime(articulo.contenido);

const hasRelated = marcas.length > 0 || articulosRelacionados.length > 0;

function toIsoDate(value: unknown) {
    if (!value) return null;

    const date = new Date(String(value));

    return Number.isNaN(date.getTime()) ? null : date.toISOString();
}

const publishedTime = toIsoDate(
    articulo.fecha_publicacion || articulo.publishedAt,
);

const modifiedTime =
    toIsoDate(articulo.updatedAt) || publishedTime;

const articlePath = `/noticias/${articulo.slug}`;
const siteUrl = Astro.site ?? new URL("https://todosatcom.com");
const articleUrl = new URL(`${articlePath}/`, siteUrl).toString();
const homeUrl = new URL("/", siteUrl).toString();
const noticiasUrl = new URL("/noticias/", siteUrl).toString();

const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "NewsArticle",
            "@id": `${articleUrl}#article`,
            headline: articulo.titulo,
            description: articulo.subtitulo,
            ...(imagenUrl ? { image: [imagenUrl] } : {}),
            ...(publishedTime
                ? { datePublished: publishedTime }
                : {}),
            ...(modifiedTime
                ? { dateModified: modifiedTime }
                : {}),
            ...(categoria?.nombre
                ? { articleSection: categoria.nombre }
                : {}),
            inLanguage: "es-ES",
            mainEntityOfPage: {
                "@type": "WebPage",
                "@id": articleUrl,
            },
            publisher: {
                "@type": "Organization",
                name: "TodoSatcom",
                url: homeUrl,
            },
        },
        {
            "@type": "BreadcrumbList",
            "@id": `${articleUrl}#breadcrumb`,
            itemListElement: [
                {
                    "@type": "ListItem",
                    position: 1,
                    name: "Inicio",
                    item: homeUrl,
                },
                {
                    "@type": "ListItem",
                    position: 2,
                    name: "Noticias",
                    item: noticiasUrl,
                },
                {
                    "@type": "ListItem",
                    position: 3,
                    name: articulo.titulo,
                    item: articleUrl,
                },
            ],
        },
    ],
};
---

<Layout
    title={`${articulo.titulo} | TodoSatcom`}
    description={articulo.subtitulo}
    canonical={articlePath}
    image={imagenUrl}
    type="article"
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    structuredData={structuredData}
>
    <main class="min-h-screen bg-slate-950 text-white">
        <section class="bg-slate-950 py-8 md:py-12">
            <Container>
                <Breadcrumbs
                    items={[
                        {
                            label: "Noticias",
                            href: "/noticias",
                        },
                        {
                            label: articulo.titulo,
                        },
                    ]}
                />

                <article class="mt-8">
                    <a
                        href="/noticias"
                        class="inline-flex text-sm font-semibold text-blue-400 transition hover:text-white"
                    >
                        ← Volver a noticias
                    </a>

                    <header class="mt-8 max-w-5xl pb-10 md:pb-14">
                        <div class="flex flex-wrap gap-3">
                            {
                                categoria && (
                                    <a
                                        href={`/noticias/${categoria.slug}`}
                                        class="rounded-full border border-blue-500/50 bg-blue-500/10 px-3 py-1.5 text-xs font-semibold text-blue-300 transition hover:border-[#005EFF] hover:text-white md:px-4 md:py-2 md:text-sm"
                                    >
                                        {categoria.nombre}
                                    </a>
                                )
                            }

                            {
                                fecha && (
                                    <span class="rounded-full border border-white/10 bg-slate-900 px-3 py-1.5 text-xs font-semibold text-slate-300 md:px-4 md:py-2 md:text-sm">
                                        {fecha}
                                    </span>
                                )
                            }

                            {
                                readingTime && (
                                    <span class="rounded-full border border-white/10 bg-slate-900 px-3 py-1.5 text-xs font-semibold text-slate-300 md:px-4 md:py-2 md:text-sm">
                                        {readingTime} min lectura
                                    </span>
                                )
                            }
                        </div>

                        <h1
                            class="mt-6 max-w-5xl text-4xl font-bold leading-tight tracking-tight !text-white md:mt-8 md:text-6xl"
                        >
                            {articulo.titulo}
                        </h1>

                        {
                            articulo.subtitulo && (
                                <p class="mt-6 max-w-3xl border-l-2 border-[#00ccff]/60 pl-5 text-lg leading-8 text-slate-300 md:text-2xl md:leading-9">
                                    {articulo.subtitulo}
                                </p>
                            )
                        }
                    </header>
                </article>
            </Container>
        </section>

        <section class="bg-slate-100 py-10 text-slate-950 md:py-14">
            <Container>
                <div
                    class={`grid gap-10 ${
                        hasRelated
                            ? "lg:grid-cols-[minmax(0,1fr)_340px]"
                            : "lg:grid-cols-[minmax(0,1fr)]"
                    }`}
                >
                    <article
                        class="overflow-hidden rounded-3xl bg-white shadow-xl shadow-slate-950/10"
                    >
                        {
                            imagenUrl && (
                                <div class="border-b border-slate-200 bg-slate-950">
                                    <img
                                        src={imagenUrl}
                                        alt={articulo.titulo}
                                        class="h-[280px] w-full object-contain md:h-[520px]"
                                    />
                                </div>
                            )
                        }

                        {
                            contenidoHTML && (
                                <section class="px-6 py-8 md:px-10 md:py-12">
                                    <div
                                        class="prose prose-slate max-w-none prose-headings:text-slate-950 prose-p:text-slate-700 prose-a:text-blue-600 prose-strong:text-slate-950 prose-li:text-slate-700 md:[&_p]:text-[1.08rem] md:[&_p]:leading-8 md:[&_li]:text-[1.08rem] md:[&_li]:leading-8"
                                        set:html={contenidoHTML}
                                    />
                                </section>
                            )
                        }
                    </article>

                    {
                        hasRelated && (
                            <aside class="lg:sticky lg:top-28 lg:self-start">
                                <div class="overflow-hidden rounded-3xl border border-white/10 bg-slate-950 text-white shadow-2xl">
                                    <div class="border-b border-white/10 p-6">
                                        <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-400">
                                            Relacionado
                                        </p>

                                        <h2 class="mt-3 text-2xl font-bold text-white">
                                            En este artículo
                                        </h2>
                                    </div>

                                    <div class="space-y-8 p-6">
                                        {marcas.length > 0 && (
                                            <section>
                                                <h3 class="mb-4 border-l-2 border-blue-500 pl-3 text-sm font-bold uppercase tracking-[0.16em] text-slate-300">
                                                    Operadores
                                                </h3>

                                                <div class="grid gap-4">
                                                    {marcas.map(
                                                        (marca: any) => (
                                                            <RelatedCard
                                                                type="Operador"
                                                                title={
                                                                    marca.nombre
                                                                }
                                                                description={
                                                                    marca.descripcion_corta
                                                                }
                                                                url={`/operadores/${marca.slug}`}
                                                                image={
                                                                    marca.imagen_portada
                                                                }
                                                            />
                                                        ),
                                                    )}
                                                </div>
                                            </section>
                                        )}

                                        {articulosRelacionados.length > 0 && (
                                            <section>
                                                <h3 class="mb-4 border-l-2 border-blue-500 pl-3 text-sm font-bold uppercase tracking-[0.16em] text-slate-300">
                                                    Más noticias
                                                </h3>

                                                <div class="grid gap-4">
                                                    {articulosRelacionados.map(
                                                        (
                                                            articuloRelacionado: any,
                                                        ) => (
                                                            <RelatedCard
                                                                type="Noticia"
                                                                title={
                                                                    articuloRelacionado.titulo
                                                                }
                                                                description={
                                                                    articuloRelacionado.subtitulo
                                                                }
                                                                meta={
                                                                    articuloRelacionado
                                                                        .categoria_noticia
                                                                        ?.nombre
                                                                }
                                                                url={`/noticias/${articuloRelacionado.slug}`}
                                                                image={
                                                                    articuloRelacionado.imagen_principal
                                                                }
                                                            />
                                                        ),
                                                    )}
                                                </div>
                                            </section>
                                        )}
                                    </div>
                                </div>
                            </aside>
                        )
                    }
                </div>

                {
                    (modelos.length > 0 || manuales.length > 0) && (
                        <section class="mt-10 overflow-hidden rounded-3xl border border-white/10 bg-slate-950 text-white shadow-2xl">
                            <div class="border-b border-white/10 p-6 md:p-8">
                                <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-400">
                                    Recursos relacionados
                                </p>
                            </div>

                            <div class="grid gap-8 p-6 md:p-8 lg:grid-cols-2">
                                {modelos.length > 0 && (
                                    <div>
                                        <h3 class="mb-5 border-l-2 border-blue-500 pl-3 text-sm font-bold uppercase tracking-[0.16em] text-slate-300">
                                            Hardware relacionado
                                        </h3>

                                        <div class="grid gap-5 [&>a]:h-full [&>a]:min-h-[190px]">
                                            {modelos.map((modelo: any) => (
                                                <RelatedCard
                                                    type="Hardware"
                                                    title={modelo.nombre}
                                                    description={
                                                        modelo.descripcion_corta
                                                    }
                                                    url={`/hardware/${modelo.slug}`}
                                                    image={
                                                        modelo.imagen_principal
                                                    }
                                                />
                                            ))}
                                        </div>
                                    </div>
                                )}

                                {manuales.length > 0 && (
                                    <div>
                                        <h3 class="mb-5 border-l-2 border-blue-500 pl-3 text-sm font-bold uppercase tracking-[0.16em] text-slate-300">
                                            Guías relacionadas
                                        </h3>

                                        <div class="grid gap-5 [&>a]:h-full [&>a]:min-h-[190px]">
                                            {manuales.map((manual: any) => (
                                                <RelatedCard
                                                    type="Guía"
                                                    title={manual.titulo}
                                                    description={
                                                        manual.descripcion
                                                    }
                                                    url={`/manuales/${manual.slug}`}
                                                    image={
                                                        manual.imagen_portada
                                                    }
                                                />
                                            ))}
                                        </div>
                                    </div>
                                )}
                            </div>
                        </section>
                    )
                }
            </Container>
        </section>
    </main>
</Layout>
