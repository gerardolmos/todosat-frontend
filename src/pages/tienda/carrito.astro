---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import CheckoutSteps from "../../components/store/CheckoutSteps.astro";
---

<Layout
    title="Carrito | TodoSatcom"
    description="Revisa los productos añadidos al carrito de TodoSatcom."
    canonical="/tienda/carrito"
    robots="noindex, follow"
>
    <main class="min-h-[70vh] bg-slate-50 py-12 md:py-16">
        <Container>
            <nav
                aria-label="Migas de pan"
                class="text-sm font-semibold text-slate-500"
            >
                <a
                    href="/tienda"
                    class="transition hover:text-orange-700"
                >
                    Tienda
                </a>

                <span
                    class="mx-2 text-slate-300"
                    aria-hidden="true"
                >
                    /
                </span>

                <span class="text-slate-900">
                    Carrito
                </span>
            </nav>

            <header class="mt-7 max-w-3xl">
                <p class="text-sm font-bold uppercase tracking-[0.18em] text-orange-700">
                    Tu selección
                </p>

                <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 md:text-6xl">
                    Carrito
                </h1>

                <p class="mt-5 text-lg leading-8 text-slate-600">
                    Revisa los productos y sus cantidades antes de continuar.
                    Los precios y la disponibilidad se comprobarán nuevamente
                    en el servidor antes del pago.
                </p>
            </header>

            <CheckoutSteps activeStep={1} />

            <section
                data-cart-validation-panel
                data-state="empty"
                role="status"
                aria-live="polite"
                aria-atomic="true"
                hidden
                class="mt-8 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm md:p-6"
            >
                <div class="flex items-start gap-4">
                    <span
                        data-cart-validation-icon
                        aria-hidden="true"
                        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-slate-100 text-lg font-black text-slate-700"
                    >
                        i
                    </span>

                    <div class="min-w-0">
                        <p
                            data-cart-validation-eyebrow
                            class="text-xs font-black uppercase tracking-[0.14em] text-slate-500"
                        >
                            Estado del carrito
                        </p>

                        <h2
                            data-cart-validation-title
                            class="mt-1 text-lg font-black text-slate-950"
                        >
                            Pendiente de comprobación
                        </h2>

                        <p
                            data-cart-validation-message
                            class="mt-2 text-sm leading-6 text-slate-700"
                        >
                            Los precios y la disponibilidad se comprobarán en el servidor.
                        </p>
                    </div>
                </div>
            </section>

            <div
                data-cart-error
                role="alert"
                aria-live="assertive"
                class="mt-8 rounded-2xl border border-red-300 bg-red-50 px-5 py-4 text-sm font-bold text-red-950 empty:hidden"
            ></div>

            <section
                data-cart-empty
                hidden
                class="mt-10 rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-sm md:p-14"
            >
                <div
                    class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-orange-100 text-3xl"
                    aria-hidden="true"
                >
                    🛒
                </div>

                <h2 class="mt-6 text-2xl font-black text-slate-950">
                    El carrito está vacío
                </h2>

                <p class="mx-auto mt-3 max-w-lg text-sm leading-6 text-slate-600">
                    Explora el catálogo y añade los productos que quieras
                    revisar.
                </p>

                <a
                    href="/tienda"
                    class="mt-7 inline-flex items-center justify-center rounded-full bg-orange-500 px-6 py-3.5 text-sm font-bold text-white transition hover:bg-orange-400"
                >
                    Ver productos
                </a>
            </section>

            <div
                data-cart-shell
                aria-busy="false"
                class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_380px]"
            >
                <section
                    data-cart-items
                    hidden
                    aria-label="Productos del carrito"
                    class="space-y-5"
                ></section>

                <aside
                    data-cart-summary
                    hidden
                    class="h-fit rounded-3xl border border-slate-200 bg-white p-6 shadow-sm lg:sticky lg:top-28"
                >
                    <h2 class="text-2xl font-black text-slate-950">
                        Resumen
                    </h2>

                    <dl class="mt-6 space-y-4">
                        <div class="flex items-center justify-between gap-4 text-sm">
                            <dt class="font-semibold text-slate-600">
                                Productos
                            </dt>

                            <dd
                                data-cart-units
                                class="font-bold text-slate-950"
                            >
                                0 unidades
                            </dd>
                        </div>

                        <div class="border-t border-slate-200 pt-4">
                            <div class="flex items-end justify-between gap-4">
                                <dt
                                    data-cart-subtotal-label
                                    class="font-bold text-slate-950"
                                >
                                    Subtotal estimado
                                </dt>

                                <dd
                                    data-cart-subtotal
                                    class="text-2xl font-black text-slate-950"
                                >
                                    0,00 €
                                </dd>
                            </div>

                            <p
                                data-cart-subtotal-note
                                class="mt-2 text-xs leading-5 text-slate-500"
                            >
                                Calculado con la información guardada en este navegador.
                            </p>
                        </div>
                    </dl>

                    <section
                        data-cart-shipping
                        data-status="estimated"
                        class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-4"
                    >
                        <p class="text-xs font-black uppercase tracking-[0.12em] text-slate-500">
                            Envío
                        </p>

                        <h3
                            data-cart-shipping-title
                            class="mt-1 text-sm font-black text-slate-950"
                        >
                            Pendiente de comprobación
                        </h3>

                        <p
                            data-cart-shipping-message
                            class="mt-2 text-xs leading-5 text-slate-600"
                        >
                            El servidor confirmará si este pedido requiere dirección de envío.
                        </p>
                    </section>

                    <section
                        data-cart-privacy
                        class="mt-4 rounded-2xl border border-sky-200 bg-sky-50 p-4"
                    >
                        <p class="text-xs font-black uppercase tracking-[0.12em] text-sky-800">
                            Pago y privacidad
                        </p>

                        <h3 class="mt-1 text-sm font-black text-slate-950">
                            Tus datos se introducirán en Stripe
                        </h3>

                        <p class="mt-2 text-xs leading-5 text-slate-700">
                            TodoSatcom no solicita ni guarda datos de tarjeta.
                            Cuando el checkout se active, Stripe recogerá el
                            correo y, si el pedido necesita envío, también la
                            dirección y el teléfono.
                        </p>
                    </section>

                    <p class="mt-4 text-xs leading-5 text-slate-500">
                        Los impuestos, portes y condiciones definitivas
                        continúan pendientes de activación.
                    </p>

                    <button
                        type="button"
                        data-cart-checkout
                        disabled
                        aria-describedby="cart-checkout-status"
                        class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-orange-500 px-6 py-3.5 text-sm font-bold text-white transition hover:bg-orange-400 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:text-slate-600"
                    >
                        Pago todavía no disponible
                    </button>

                    <p
                        id="cart-checkout-status"
                        data-cart-checkout-status
                        role="status"
                        aria-live="polite"
                        class="mt-3 text-xs leading-5 text-slate-600"
                    >
                        El checkout permanece desactivado durante esta fase de desarrollo.
                    </p>

                    <a
                        href="/tienda"
                        class="mt-5 block text-center text-sm font-bold text-orange-700 transition hover:text-orange-950"
                    >
                        Seguir comprando
                    </a>

                    <div class="mt-5 border-t border-slate-200 pt-4">
                        <button
                            type="button"
                            data-cart-clear
                            class="inline-flex w-full items-center justify-center rounded-full border border-slate-300 bg-white px-6 py-3 text-sm font-bold text-slate-700 transition hover:border-red-300 hover:bg-red-50 hover:text-red-700 disabled:cursor-not-allowed disabled:opacity-40"
                        >
                            Vaciar carrito
                        </button>
                    </div>
                </aside>
            </div>

            <noscript>
                <p class="mt-8 rounded-2xl border border-amber-300 bg-amber-50 p-5 text-sm font-semibold text-amber-950">
                    El carrito necesita JavaScript para mostrar y modificar
                    los productos guardados.
                </p>
            </noscript>
        </Container>
    </main>

    <script>
        import "../../scripts/cart-page";
        import "../../scripts/cart-checkout";
    </script>
</Layout>
