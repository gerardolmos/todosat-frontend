---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import CheckoutSteps from "../../components/store/CheckoutSteps.astro";
---

<Layout
    title="Carrito | TodoSatcom"
    description="Revisa los productos añadidos al carrito de TodoSatcom."
    canonical="/tienda/carrito"
    robots="noindex, follow"
>
    <main class="min-h-[70vh] bg-slate-50 py-12 md:py-16">
        <Container>
            <nav
                aria-label="Migas de pan"
                class="text-sm font-semibold text-slate-500"
            >
                <a
                    href="/tienda"
                    class="transition hover:text-orange-700"
                >
                    Tienda
                </a>

                <span
                    class="mx-2 text-slate-300"
                    aria-hidden="true"
                >
                    /
                </span>

                <span class="text-slate-900">
                    Carrito
                </span>
            </nav>

            <header class="mt-7 max-w-3xl">
                <p class="text-sm font-bold uppercase tracking-[0.18em] text-orange-700">
                    Tu selección
                </p>

                <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 md:text-6xl">
                    Carrito
                </h1>

                <p class="mt-5 text-lg leading-8 text-slate-600">
                    Revisa los productos y sus cantidades antes de continuar.
                    Confirmaremos el precio y la disponibilidad cuando pulses
                    «Revisar pedido».
                </p>
            </header>

            <CheckoutSteps activeStep={1} />

            <section
                data-cart-error
                role="alert"
                aria-live="assertive"
                aria-atomic="true"
                tabindex="-1"
                hidden
                class="mt-8 scroll-mt-28 rounded-2xl border border-red-300 bg-red-50 px-5 py-4 text-red-950"
            >
                <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                    <div class="flex min-w-0 items-start gap-3">
                        <span
                            aria-hidden="true"
                            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-100 text-lg font-black text-red-900"
                        >
                            !
                        </span>

                        <div class="min-w-0">
                            <h2 class="text-sm font-black">
                                No se ha podido completar la acción
                            </h2>

                            <p
                                data-cart-error-message
                                class="mt-1 text-sm leading-6"
                            ></p>
                        </div>
                    </div>

                    <button
                        type="button"
                        data-cart-error-dismiss
                        class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-full border border-red-300 bg-white px-4 py-2 text-sm font-black text-red-800 transition hover:bg-red-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700 motion-reduce:transition-none"
                    >
                        Cerrar aviso
                    </button>
                </div>
            </section>

            <section
                data-cart-empty
                hidden
                class="mt-10 rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-sm md:p-14"
            >
                <div
                    class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-orange-100 text-3xl"
                    aria-hidden="true"
                >
                    🛒
                </div>

                <h2 class="mt-6 text-2xl font-black text-slate-950">
                    El carrito está vacío
                </h2>

                <p class="mx-auto mt-3 max-w-lg text-sm leading-6 text-slate-600">
                    Explora el catálogo y añade los productos que quieras
                    revisar.
                </p>

                <a
                    href="/tienda"
                    class="mt-7 inline-flex min-h-11 items-center justify-center rounded-full bg-orange-500 px-6 py-3.5 text-sm font-bold text-white transition hover:bg-orange-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-700 motion-reduce:transition-none"
                >
                    Ver productos
                </a>
            </section>

            <div
                data-cart-shell
                aria-busy="false"
                class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_380px]"
            >
                <section
                    data-cart-items
                    hidden
                    aria-label="Productos del carrito"
                    class="space-y-5"
                ></section>

                <aside
                    data-cart-summary
                    hidden
                    class="h-fit rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6 xl:sticky xl:top-28"
                >
                    <h2 class="text-2xl font-black text-slate-950">
                        Resumen
                    </h2>

                    <dl class="mt-6 space-y-4">
                        <div class="flex items-center justify-between gap-4 text-sm">
                            <dt class="font-semibold text-slate-600">
                                Productos
                            </dt>

                            <dd
                                data-cart-units
                                class="font-bold text-slate-950"
                            >
                                0 unidades
                            </dd>
                        </div>

                        <div class="border-t border-slate-200 pt-4">
                            <div class="flex items-end justify-between gap-4">
                                <dt
                                    data-cart-subtotal-label
                                    class="font-bold text-slate-950"
                                >
                                    Subtotal estimado
                                </dt>

                                <dd
                                    data-cart-subtotal
                                    class="text-2xl font-black text-slate-950"
                                >
                                    0,00 €
                                </dd>
                            </div>

                            <p
                                data-cart-subtotal-note
                                class="mt-2 text-xs leading-5 text-slate-500"
                            >
                                El importe final se confirmará al revisar el pedido.
                            </p>
                        </div>
                    </dl>

                    <section
                        data-cart-shipping
                        data-status="estimated"
                        class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-4"
                    >
                        <p class="text-xs font-black uppercase tracking-[0.12em] text-slate-500">
                            Envío
                        </p>

                        <h3
                            data-cart-shipping-title
                            class="mt-1 text-sm font-black text-slate-950"
                        >
                            Información de entrega
                        </h3>

                        <p
                            data-cart-shipping-message
                            class="mt-2 text-xs leading-5 text-slate-600"
                        >
                            La información de entrega se completará cuando la tienda esté activa.
                        </p>
                    </section>

                    <section
                        data-cart-privacy
                        class="mt-4 rounded-2xl border border-sky-200 bg-sky-50 p-4"
                    >
                        <p class="text-xs font-black uppercase tracking-[0.12em] text-sky-800">
                            Pago
                        </p>

                        <h3 class="mt-1 text-sm font-black text-slate-950">
                            Compra online próximamente
                        </h3>

                        <p class="mt-2 text-xs leading-5 text-slate-700">
                            Podrás revisar el pedido completo. En esta versión
                            todavía no se realizan cargos ni se generan pedidos.
                        </p>
                    </section>


                    <button
                        type="button"
                        data-cart-checkout
                        disabled
                        aria-describedby="cart-checkout-status"
                        class="mt-6 inline-flex min-h-11 w-full items-center justify-center rounded-full bg-orange-500 px-6 py-3.5 text-sm font-bold text-white transition hover:bg-orange-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-700 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:text-slate-600 motion-reduce:transition-none"
                    >
                        Revisar pedido
                    </button>

                    <p
                        id="cart-checkout-status"
                        data-cart-checkout-status
                        role="status"
                        aria-live="polite"
                        aria-atomic="true"
                        tabindex="-1"
                        data-tone="neutral"
                        class="mt-3 text-xs leading-5 text-slate-600"
                    >
                        Confirmaremos el precio y la disponibilidad antes de mostrar el siguiente paso.
                    </p>

                    <a
                        href="/tienda"
                        class="mt-5 block rounded-lg py-2 text-center text-sm font-bold text-orange-700 transition hover:text-orange-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-700 motion-reduce:transition-none"
                    >
                        Seguir comprando
                    </a>

                    <div class="mt-5 border-t border-slate-200 pt-4">
                        <button
                            type="button"
                            data-cart-clear
                            class="inline-flex min-h-11 w-full items-center justify-center rounded-full border border-slate-300 bg-white px-6 py-3 text-sm font-bold text-slate-700 transition hover:border-red-300 hover:bg-red-50 hover:text-red-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700 disabled:cursor-not-allowed disabled:opacity-40 motion-reduce:transition-none"
                        >
                            Vaciar carrito
                        </button>
                    </div>
                </aside>
            </div>

            <dialog
                data-cart-clear-dialog
                aria-labelledby="cart-clear-title"
                aria-describedby="cart-clear-description"
                class="m-auto w-[min(92vw,32rem)] rounded-3xl border border-slate-200 bg-white p-0 text-slate-950 shadow-2xl backdrop:bg-slate-950/60"
            >
                <div class="p-6 sm:p-8">
                    <p class="text-xs font-black uppercase tracking-[0.14em] text-red-700">
                        Acción irreversible
                    </p>

                    <h2
                        id="cart-clear-title"
                        class="mt-2 text-2xl font-black"
                    >
                        ¿Vaciar todo el carrito?
                    </h2>

                    <p
                        id="cart-clear-description"
                        class="mt-3 text-sm leading-6 text-slate-600"
                    >
                        Se eliminarán todos los productos de tu carrito.
                    </p>

                    <div class="mt-7 grid gap-3 sm:grid-cols-2">
                        <button
                            type="button"
                            data-cart-clear-cancel
                            class="inline-flex min-h-11 items-center justify-center rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-black text-slate-700 transition hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-700 motion-reduce:transition-none"
                        >
                            Conservar productos
                        </button>

                        <button
                            type="button"
                            data-cart-clear-confirm
                            class="inline-flex min-h-11 items-center justify-center rounded-full bg-red-700 px-5 py-3 text-sm font-black text-white transition hover:bg-red-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700 motion-reduce:transition-none"
                        >
                            Vaciar carrito
                        </button>
                    </div>
                </div>
            </dialog>


            <dialog
                data-checkout-demo-dialog
                aria-labelledby="checkout-demo-title"
                aria-describedby="checkout-demo-description"
                class="m-auto w-[min(92vw,34rem)] rounded-3xl border border-slate-200 bg-white p-0 text-slate-950 shadow-2xl backdrop:bg-slate-950/60"
            >
                <div class="p-6 sm:p-8">
                    <p class="text-xs font-black uppercase tracking-[0.14em] text-orange-700">
                        Demostración de tienda
                    </p>

                    <h2
                        id="checkout-demo-title"
                        class="mt-2 text-2xl font-black"
                    >
                        Compra online próximamente
                    </h2>

                    <p
                        id="checkout-demo-description"
                        class="mt-4 text-sm leading-6 text-slate-600"
                    >
                        El carrito se ha revisado correctamente. En esta
                        versión no se genera ningún pedido ni se realiza
                        ningún cargo.
                    </p>

                    <p class="mt-4 rounded-2xl border border-sky-200 bg-sky-50 p-4 text-sm leading-6 text-slate-700">
                        Cuando la tienda esté activa, el siguiente paso será
                        completar el pago seguro y los datos de entrega.
                    </p>

                    <div class="mt-7 grid gap-3 sm:grid-cols-2">
                        <button
                            type="button"
                            data-checkout-demo-close
                            class="inline-flex min-h-11 items-center justify-center rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-black text-slate-700 transition hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-700 motion-reduce:transition-none"
                        >
                            Volver al carrito
                        </button>

                        <a
                            href="/tienda"
                            class="inline-flex min-h-11 items-center justify-center rounded-full bg-orange-500 px-5 py-3 text-sm font-black text-white transition hover:bg-orange-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-700 motion-reduce:transition-none"
                        >
                            Seguir viendo productos
                        </a>
                    </div>
                </div>
            </dialog>

            <noscript>
                <p class="mt-8 rounded-2xl border border-amber-300 bg-amber-50 p-5 text-sm font-semibold text-amber-950">
                    El carrito necesita JavaScript para mostrar y modificar
                    los productos guardados.
                </p>
            </noscript>
        </Container>
    </main>

    <script>
        import "../../scripts/cart-page";
        import "../../scripts/cart-checkout";
    </script>
</Layout>
