---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import ProductCard from "../../components/store/ProductCard.astro";

import {
    getAccesoriosTienda,
    getProductosPrincipalesTienda,
    getProductosTiendaPage,
    PRODUCTOS_TIENDA_POR_PAGINA,
} from "../../lib/store";

import type {
    PaginaTienda,
    ProductoTiendaResumen,
} from "../../types/store";

export async function getStaticPaths() {
    const [
        firstPage,
        productosPrincipales,
        accesorios,
    ] = await Promise.all([
        getProductosTiendaPage(
            1,
            PRODUCTOS_TIENDA_POR_PAGINA,
        ),
        getProductosPrincipalesTienda(),
        getAccesoriosTienda(),
    ]);

    const totalPages = Math.max(
        1,
        firstPage.pagination.pageCount,
    );

    const paths = [
        {
            params: {
                page: undefined,
            },
            props: {
                catalogo: firstPage,
                productosPrincipales,
                accesorios,
            },
        },
    ];

    for (
        let pageNumber = 2;
        pageNumber <= totalPages;
        pageNumber += 1
    ) {
        const catalogo =
            await getProductosTiendaPage(
                pageNumber,
                PRODUCTOS_TIENDA_POR_PAGINA,
            );

        paths.push({
            params: {
                page: String(pageNumber),
            },
            props: {
                catalogo,
                productosPrincipales: [],
                accesorios: [],
            },
        });
    }

    return paths;
}

const {
    catalogo,
    productosPrincipales,
    accesorios,
} = Astro.props as {
    catalogo: PaginaTienda<ProductoTiendaResumen>;
    productosPrincipales: ProductoTiendaResumen[];
    accesorios: ProductoTiendaResumen[];
};

const currentPage = catalogo.pagination.page;

const totalPages = Math.max(
    1,
    catalogo.pagination.pageCount,
);

const isFirstPage = currentPage === 1;

const pageSuffix =
    currentPage > 1
        ? ` — Página ${currentPage}`
        : "";

const title =
    `Tienda de conectividad satelital${pageSuffix} | TodoSatcom`;

const descriptionBase =
    "Terminales, accesorios y servicios de integración para comunicaciones fiables en entornos marítimos, móviles y profesionales.";

const description =
    currentPage > 1
        ? `${descriptionBase} Página ${currentPage}.`
        : descriptionBase;

const canonicalPath =
    currentPage > 1
        ? `/tienda/${currentPage}`
        : "/tienda";
---

<Layout
    title={title}
    description={description}
    canonical={canonicalPath}
>
    <main class="min-h-screen bg-slate-100 text-slate-950">
        <section class="relative overflow-hidden bg-slate-950 py-10 text-white md:py-14">
            <div
                class="absolute -right-24 -top-28 h-80 w-80 rounded-full bg-orange-500/15 blur-3xl"
                aria-hidden="true"
            ></div>

            <div
                class="absolute -bottom-40 left-1/3 h-72 w-72 rounded-full bg-sky-500/10 blur-3xl"
                aria-hidden="true"
            ></div>

            <Container>
                <header class="relative grid gap-8 lg:grid-cols-[minmax(0,1fr)_360px] lg:items-end">
                    <div>
                        <div class="flex flex-wrap items-center gap-3">
                            <p class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">
                                Tienda TodoSatcom
                            </p>

                        </div>

                        <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-[1.05] tracking-tight !text-white md:text-5xl xl:text-6xl">
                            Soluciones de conectividad satelital
                        </h1>

                        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-300 md:text-lg">
                            {descriptionBase}
                        </p>

                        {
                            isFirstPage && (
                                <div class="mt-7 flex flex-wrap gap-3">
                                    {
                                        productosPrincipales.length > 0 && (
                                            <a
                                                href="#productos-principales"
                                                class="inline-flex min-h-11 items-center rounded-full bg-orange-500 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-orange-400 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-orange-400/30"
                                            >
                                                Consultar soluciones
                                            </a>
                                        )
                                    }
                                </div>
                            )
                        }
                    </div>
                </header>
            </Container>
        </section>

        {
            isFirstPage &&
            productosPrincipales.length > 0 && (
                <section
                    id="productos-principales"
                    class="border-b border-orange-200 bg-orange-50 py-9 md:py-11"
                >
                    <Container>
                        <div class="flex flex-col gap-5 border-l-4 border-orange-500 pl-5 md:flex-row md:items-end md:justify-between">
                            <div class="max-w-3xl">
                                <p class="text-xs font-black uppercase tracking-[0.2em] text-orange-700">
                                    01 · Sistemas marítimos
                                </p>

                                <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 md:text-4xl">
                                    Starlink satelital marítimo
                                </h2>

                                <p class="mt-3 text-base leading-7 text-slate-600">
                                    Terminales y equipos seleccionados para embarcaciones, operaciones costeras y despliegues profesionales que requieren conectividad estable.
                                </p>
                            </div>
                        </div>

                        <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                            {
                                productosPrincipales.map((producto) => (
                                    <ProductCard producto={producto} />
                                ))
                            }
                        </div>
                    </Container>
                </section>
            )
        }

        {
            isFirstPage &&
            accesorios.length > 0 && (
                <section
                    id="accesorios"
                    class="border-b border-slate-200 bg-white py-9 md:py-11"
                >
                    <Container>
                        <div class="rounded-2xl border border-slate-200 bg-slate-50 px-5 py-5 md:flex md:items-end md:justify-between md:px-6">
                            <div class="max-w-3xl">
                                <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-500">
                                    02 · Integración y soporte
                                </p>

                                <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 md:text-4xl">
                                    Accesorios y servicios técnicos
                                </h2>

                                <p class="mt-3 text-base leading-7 text-slate-600">
                                    Componentes de instalación, alimentación, montaje y configuración para completar cada solución con criterios profesionales.
                                </p>
                            </div>
                        </div>

                        <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                            {
                                accesorios.map((producto) => (
                                    <ProductCard producto={producto} />
                                ))
                            }
                        </div>
                    </Container>
                </section>
            )
        }
    </main>
</Layout>
