---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import Pagination from "../../components/Pagination.astro";
import ProductCard from "../../components/store/ProductCard.astro";

import {
    getProductosTiendaPage,
    PRODUCTOS_TIENDA_POR_PAGINA,
} from "../../lib/store";

import type {
    PaginaTienda,
    ProductoTiendaResumen,
} from "../../types/store";

export async function getStaticPaths() {
    const firstPage = await getProductosTiendaPage(
        1,
        PRODUCTOS_TIENDA_POR_PAGINA,
    );

    const totalPages = Math.max(
        1,
        firstPage.pagination.pageCount,
    );

    const paths = [
        {
            params: {
                page: undefined,
            },
            props: {
                catalogo: firstPage,
            },
        },
    ];

    for (
        let pageNumber = 2;
        pageNumber <= totalPages;
        pageNumber += 1
    ) {
        const catalogo =
            await getProductosTiendaPage(
                pageNumber,
                PRODUCTOS_TIENDA_POR_PAGINA,
            );

        paths.push({
            params: {
                page: String(pageNumber),
            },
            props: {
                catalogo,
            },
        });
    }

    return paths;
}

const { catalogo } = Astro.props as {
    catalogo: PaginaTienda<ProductoTiendaResumen>;
};

const currentPage = catalogo.pagination.page;

const totalPages = Math.max(
    1,
    catalogo.pagination.pageCount,
);

const pageSuffix =
    currentPage > 1
        ? ` — Página ${currentPage}`
        : "";

const title =
    `Tienda de conectividad satelital${pageSuffix} | TodoSatcom`;

const descriptionBase =
    "Consulta terminales, accesorios y equipamiento para conectividad satelital.";

const description =
    currentPage > 1
        ? `${descriptionBase} Página ${currentPage}.`
        : descriptionBase;

const canonicalPath =
    currentPage > 1
        ? `/tienda/${currentPage}`
        : "/tienda";
---

<Layout
    title={title}
    description={description}
    canonical={canonicalPath}
>
    <main class="min-h-screen bg-slate-100 text-slate-950">
        <section class="bg-slate-950 py-12 text-white md:py-16">
            <Container>
                <header class="max-w-4xl">
                    <p class="text-sm font-bold uppercase tracking-[0.2em] text-orange-400">
                        TodoSatcom
                    </p>

                    <h1 class="mt-4 text-4xl font-bold tracking-tight !text-white md:text-6xl">
                        Tienda de conectividad satelital
                    </h1>

                    <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
                        {descriptionBase}
                    </p>
                </header>
            </Container>
        </section>

        <section class="py-12 md:py-16">
            <Container>
                <div class="flex flex-wrap items-end justify-between gap-5">
                    <div>
                        <p class="text-sm font-bold uppercase tracking-[0.18em] text-orange-700">
                            Catálogo
                        </p>

                        <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 md:text-4xl">
                            Productos disponibles
                        </h2>
                    </div>

                    <p class="text-sm font-semibold text-slate-500">
                        {catalogo.pagination.total}
                        {
                            catalogo.pagination.total === 1
                                ? " producto"
                                : " productos"
                        }
                    </p>
                </div>

                {
                    catalogo.items.length > 0 ? (
                        <div class="mt-8 grid gap-7 md:grid-cols-2 xl:grid-cols-3">
                            {
                                catalogo.items.map((producto) => (
                                    <ProductCard
                                        producto={producto}
                                    />
                                ))
                            }
                        </div>
                    ) : (
                        <p class="mt-8 rounded-3xl border border-slate-200 bg-white p-8 text-slate-600 shadow-sm">
                            No hay productos disponibles actualmente.
                        </p>
                    )
                }

                <div class="[&_nav_a]:border-slate-300 [&_nav_a]:bg-white [&_nav_a]:text-slate-700 [&_nav_a:hover]:border-orange-400 [&_nav_a:hover]:text-orange-700 [&_nav_div]:border-slate-300 [&_nav_div]:bg-white [&_nav_div]:text-slate-700">
                    <Pagination
                        currentPage={currentPage}
                        totalPages={totalPages}
                        basePath="/tienda"
                    />
                </div>
            </Container>
        </section>
    </main>
</Layout>
