---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import Pagination from "../../components/Pagination.astro";
import CategoryCard from "../../components/store/CategoryCard.astro";
import ProductCard from "../../components/store/ProductCard.astro";

import {
    getCategoriasTiendaConConteo,
    getProductosDestacadosTienda,
    getProductosTiendaPage,
    PRODUCTOS_TIENDA_POR_PAGINA,
} from "../../lib/store";

import type {
    CategoriaTiendaConConteo,
    PaginaTienda,
    ProductoTiendaResumen,
} from "../../types/store";

export async function getStaticPaths() {
    const [
        firstPage,
        categorias,
        destacados,
    ] = await Promise.all([
        getProductosTiendaPage(
            1,
            PRODUCTOS_TIENDA_POR_PAGINA,
        ),
        getCategoriasTiendaConConteo(),
        getProductosDestacadosTienda(6),
    ]);

    const totalPages = Math.max(
        1,
        firstPage.pagination.pageCount,
    );

    const paths = [
        {
            params: {
                page: undefined,
            },
            props: {
                catalogo: firstPage,
                categorias,
                destacados,
            },
        },
    ];

    for (
        let pageNumber = 2;
        pageNumber <= totalPages;
        pageNumber += 1
    ) {
        const catalogo =
            await getProductosTiendaPage(
                pageNumber,
                PRODUCTOS_TIENDA_POR_PAGINA,
            );

        paths.push({
            params: {
                page: String(pageNumber),
            },
            props: {
                catalogo,
                categorias: [],
                destacados: [],
            },
        });
    }

    return paths;
}

const {
    catalogo,
    categorias,
    destacados,
} = Astro.props as {
    catalogo: PaginaTienda<ProductoTiendaResumen>;
    categorias: CategoriaTiendaConConteo[];
    destacados: ProductoTiendaResumen[];
};

const currentPage = catalogo.pagination.page;

const totalPages = Math.max(
    1,
    catalogo.pagination.pageCount,
);

const isFirstPage = currentPage === 1;

const pageSuffix =
    currentPage > 1
        ? ` — Página ${currentPage}`
        : "";

const title =
    `Tienda de conectividad satelital${pageSuffix} | TodoSatcom`;

const descriptionBase =
    "Consulta terminales, accesorios y equipamiento para conectividad satelital.";

const description =
    currentPage > 1
        ? `${descriptionBase} Página ${currentPage}.`
        : descriptionBase;

const canonicalPath =
    currentPage > 1
        ? `/tienda/${currentPage}`
        : "/tienda";
---

<Layout
    title={title}
    description={description}
    canonical={canonicalPath}
>
    <main class="min-h-screen bg-slate-100 text-slate-950">
        <section class="relative overflow-hidden bg-slate-950 py-14 text-white md:py-20">
            <div
                class="absolute -right-32 -top-32 h-96 w-96 rounded-full bg-orange-500/10 blur-3xl"
                aria-hidden="true"
            ></div>

            <Container>
                <header class="relative max-w-4xl">
                    <p class="text-sm font-bold uppercase tracking-[0.2em] text-orange-400">
                        TodoSatcom
                    </p>

                    <h1 class="mt-4 text-4xl font-bold tracking-tight !text-white md:text-6xl">
                        Tienda de conectividad satelital
                    </h1>

                    <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
                        {descriptionBase}
                    </p>

                    {
                        isFirstPage &&
                        categorias.length > 0 && (
                            <a
                                href="#categorias"
                                class="mt-8 inline-flex rounded-full bg-orange-500 px-6 py-3 text-sm font-bold text-white transition hover:bg-orange-400"
                            >
                                Explorar categorías
                            </a>
                        )
                    }
                </header>
            </Container>
        </section>

        {
            isFirstPage &&
            destacados.length > 0 && (
                <section class="border-b border-orange-200 bg-orange-50 py-12 md:py-16">
                    <Container>
                        <div class="max-w-3xl">
                            <p class="text-sm font-bold uppercase tracking-[0.18em] text-orange-700">
                                Selección TodoSatcom
                            </p>

                            <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 md:text-4xl">
                                Productos destacados
                            </h2>

                            <p class="mt-4 text-base leading-7 text-slate-600">
                                Una selección de terminales y accesorios relevantes del catálogo.
                            </p>
                        </div>

                        <div class="mt-8 grid gap-7 md:grid-cols-2 xl:grid-cols-3">
                            {
                                destacados.map((producto) => (
                                    <ProductCard
                                        producto={producto}
                                    />
                                ))
                            }
                        </div>
                    </Container>
                </section>
            )
        }

        {
            isFirstPage &&
            categorias.length > 0 && (
                <section
                    id="categorias"
                    class="border-b border-slate-200 bg-white py-12 md:py-16"
                >
                    <Container>
                        <div class="max-w-3xl">
                            <p class="text-sm font-bold uppercase tracking-[0.18em] text-orange-700">
                                Categorías
                            </p>

                            <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 md:text-4xl">
                                Encuentra el equipo que necesitas
                            </h2>

                            <p class="mt-4 text-base leading-7 text-slate-600">
                                Accede directamente a cada familia de productos disponibles.
                            </p>
                        </div>

                        <div class="mt-8 grid gap-7 md:grid-cols-2 xl:grid-cols-3">
                            {
                                categorias.map((item) => (
                                    <CategoryCard item={item} />
                                ))
                            }
                        </div>
                    </Container>
                </section>
            )
        }

        <section class="py-12 md:py-16">
            <Container>
                <div class="flex flex-wrap items-end justify-between gap-5">
                    <div>
                        <p class="text-sm font-bold uppercase tracking-[0.18em] text-orange-700">
                            Catálogo
                        </p>

                        <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 md:text-4xl">
                            {
                                isFirstPage
                                    ? "Todos los productos"
                                    : `Productos — Página ${currentPage}`
                            }
                        </h2>
                    </div>

                    <p class="text-sm font-semibold text-slate-500">
                        {catalogo.pagination.total}
                        {
                            catalogo.pagination.total === 1
                                ? " producto"
                                : " productos"
                        }
                    </p>
                </div>

                {
                    catalogo.items.length > 0 ? (
                        <div class="mt-8 grid gap-7 md:grid-cols-2 xl:grid-cols-3">
                            {
                                catalogo.items.map((producto) => (
                                    <ProductCard
                                        producto={producto}
                                    />
                                ))
                            }
                        </div>
                    ) : (
                        <p class="mt-8 rounded-3xl border border-slate-200 bg-white p-8 text-slate-600 shadow-sm">
                            No hay productos disponibles actualmente.
                        </p>
                    )
                }

                <div class="[&_nav_a]:border-slate-300 [&_nav_a]:bg-white [&_nav_a]:text-slate-700 [&_nav_a:hover]:border-orange-400 [&_nav_a:hover]:text-orange-700 [&_nav_div]:border-slate-300 [&_nav_div]:bg-white [&_nav_div]:text-slate-700">
                    <Pagination
                        currentPage={currentPage}
                        totalPages={totalPages}
                        basePath="/tienda"
                    />
                </div>
            </Container>
        </section>
    </main>
</Layout>
