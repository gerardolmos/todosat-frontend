---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import Pagination from "../../components/Pagination.astro";

import {
    getProductosTiendaPage,
    PRODUCTOS_TIENDA_POR_PAGINA,
} from "../../lib/store";

import { getMediaUrl } from "../../lib/media";

import type {
    PaginaTienda,
    ProductoTiendaResumen,
} from "../../types/store";

export async function getStaticPaths() {
    const firstPage = await getProductosTiendaPage(
        1,
        PRODUCTOS_TIENDA_POR_PAGINA,
    );

    const totalPages = Math.max(
        1,
        firstPage.pagination.pageCount,
    );

    const paths = [
        {
            params: {
                page: undefined,
            },
            props: {
                catalogo: firstPage,
            },
        },
    ];

    for (
        let pageNumber = 2;
        pageNumber <= totalPages;
        pageNumber += 1
    ) {
        const catalogo =
            await getProductosTiendaPage(
                pageNumber,
                PRODUCTOS_TIENDA_POR_PAGINA,
            );

        paths.push({
            params: {
                page: String(pageNumber),
            },
            props: {
                catalogo,
            },
        });
    }

    return paths;
}

const { catalogo } = Astro.props as {
    catalogo: PaginaTienda<ProductoTiendaResumen>;
};

const currentPage = catalogo.pagination.page;
const totalPages = Math.max(
    1,
    catalogo.pagination.pageCount,
);

const pageSuffix =
    currentPage > 1
        ? ` — Página ${currentPage}`
        : "";

const title =
    `Tienda de conectividad satelital${pageSuffix} | TodoSatcom`;

const descriptionBase =
    "Consulta terminales, accesorios y equipamiento para conectividad satelital.";

const description =
    currentPage > 1
        ? `${descriptionBase} Página ${currentPage}.`
        : descriptionBase;

const canonicalPath =
    currentPage > 1
        ? `/tienda/${currentPage}`
        : "/tienda";
---

<Layout
    title={title}
    description={description}
    canonical={canonicalPath}
>
    <main class="min-h-screen bg-slate-950 py-10 text-white">
        <Container>
            <header class="max-w-4xl">
                <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-400">
                    TodoSatcom
                </p>

                <h1 class="mt-4 text-4xl font-bold tracking-tight !text-white md:text-6xl">
                    Tienda de conectividad satelital
                </h1>

                <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
                    {descriptionBase}
                </p>
            </header>

            <section class="mt-12">
                {
                    catalogo.items.length > 0 ? (
                        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                            {catalogo.items.map((producto) => {
                                const imageUrl = getMediaUrl(
                                    producto.imagen_principal,
                                );

                                return (
                                    <article class="rounded-2xl border border-white/10 bg-slate-900 p-5">
                                        {imageUrl && (
                                            <img
                                                src={imageUrl}
                                                alt={
                                                    producto
                                                        .imagen_principal
                                                        ?.alternativeText ||
                                                    producto.nombre
                                                }
                                                class="mb-5 h-48 w-full rounded-xl object-contain"
                                            />
                                        )}

                                        <p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-400">
                                            {
                                                producto
                                                    .categoria_producto_tienda
                                                    .nombre
                                            }
                                        </p>

                                        <h2 class="mt-3 text-xl font-bold text-white">
                                            {producto.nombre}
                                        </h2>

                                        <p class="mt-3 text-sm leading-6 text-slate-300">
                                            {
                                                producto.descripcion_corta
                                            }
                                        </p>

                                        <a
                                            href={`/tienda/producto/${producto.slug}`}
                                            class="mt-5 inline-flex text-sm font-bold text-blue-400"
                                        >
                                            Ver producto →
                                        </a>
                                    </article>
                                );
                            })}
                        </div>
                    ) : (
                        <p class="rounded-2xl border border-white/10 bg-slate-900 p-6 text-slate-300">
                            No hay productos disponibles actualmente.
                        </p>
                    )
                }

                <Pagination
                    currentPage={currentPage}
                    totalPages={totalPages}
                    basePath="/tienda"
                />
            </section>
        </Container>
    </main>
</Layout>
