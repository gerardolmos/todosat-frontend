---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
---

<Layout
    title="Consulta enviada | TodoSatcom"
    description="Confirmación de envío de una consulta de disponibilidad."
    robots="noindex, follow"
    canonical={null}
>
    <main class="min-h-screen bg-slate-50 py-16 text-slate-950">
        <Container>
            <section class="mx-auto max-w-3xl rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-sm md:p-12">
                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 text-2xl font-bold text-emerald-700">
                    ✓
                </div>
                <p class="mt-6 text-xs font-bold uppercase tracking-[0.16em] text-orange-700">
                    Consulta recibida
                </p>
                <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-950">
                    Hemos recibido tu consulta
                </h1>
                <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-slate-600">
                    Revisaremos la solicitud y los datos del producto indicado antes de responderte por los canales de contacto facilitados.
                </p>
                <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
                    <a
                        href="/tienda/"
                        class="inline-flex items-center justify-center rounded-full bg-slate-950 px-6 py-3 text-sm font-bold text-white transition hover:bg-slate-800"
                    >
                        Volver a la tienda
                    </a>
                    <a
                        href="/"
                        class="inline-flex items-center justify-center rounded-full border border-slate-300 px-6 py-3 text-sm font-bold text-slate-800 transition hover:border-slate-400 hover:bg-slate-50"
                    >
                        Ir al inicio
                    </a>
                </div>
            </section>
        </Container>
    </main>
</Layout>
