---
import Layout from "../../../../layouts/Layout.astro";
import Container from "../../../../components/Container.astro";
import Pagination from "../../../../components/Pagination.astro";

import {
    getCategoriasTienda,
    getProductosTiendaPorCategoriaPage,
    PRODUCTOS_TIENDA_POR_PAGINA,
} from "../../../../lib/store";

import { getMediaUrl } from "../../../../lib/media";

import type {
    CategoriaProductoTienda,
    PaginaTienda,
    ProductoTiendaResumen,
} from "../../../../types/store";

export async function getStaticPaths() {
    const categorias = await getCategoriasTienda();
    const paths = [];

    for (const categoria of categorias) {
        const firstPage =
            await getProductosTiendaPorCategoriaPage(
                categoria.slug,
                1,
                PRODUCTOS_TIENDA_POR_PAGINA,
            );

        if (firstPage.pagination.total === 0) {
            continue;
        }

        const totalPages = Math.max(
            1,
            firstPage.pagination.pageCount,
        );

        paths.push({
            params: {
                slug: categoria.slug,
                page: undefined,
            },
            props: {
                categoria,
                catalogo: firstPage,
            },
        });

        for (
            let pageNumber = 2;
            pageNumber <= totalPages;
            pageNumber += 1
        ) {
            const catalogo =
                await getProductosTiendaPorCategoriaPage(
                    categoria.slug,
                    pageNumber,
                    PRODUCTOS_TIENDA_POR_PAGINA,
                );

            paths.push({
                params: {
                    slug: categoria.slug,
                    page: String(pageNumber),
                },
                props: {
                    categoria,
                    catalogo,
                },
            });
        }
    }

    return paths;
}

const { categoria, catalogo } = Astro.props as {
    categoria: CategoriaProductoTienda;
    catalogo: PaginaTienda<ProductoTiendaResumen>;
};

const currentPage = catalogo.pagination.page;
const totalPages = Math.max(
    1,
    catalogo.pagination.pageCount,
);

const pageSuffix =
    currentPage > 1
        ? ` — Página ${currentPage}`
        : "";

const title =
    `${categoria.nombre}${pageSuffix} | Tienda TodoSatcom`;

const descriptionBase =
    categoria.descripcion ||
    `Consulta los productos de ${categoria.nombre} disponibles en la tienda TodoSatcom.`;

const description =
    currentPage > 1
        ? `${descriptionBase} Página ${currentPage}.`
        : descriptionBase;

const basePath =
    `/tienda/categoria/${categoria.slug}`;

const canonicalPath =
    currentPage > 1
        ? `${basePath}/${currentPage}`
        : basePath;
---

<Layout
    title={title}
    description={description}
    canonical={canonicalPath}
>
    <main class="min-h-screen bg-slate-950 py-10 text-white">
        <Container>
            <header class="max-w-4xl">
                <a
                    href="/tienda"
                    class="text-sm font-semibold text-blue-400 transition hover:text-white"
                >
                    ← Volver a la tienda
                </a>

                <p class="mt-8 text-sm font-bold uppercase tracking-[0.2em] text-blue-400">
                    Categoría
                </p>

                <h1 class="mt-4 text-4xl font-bold tracking-tight !text-white md:text-6xl">
                    {categoria.nombre}
                </h1>

                <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
                    {descriptionBase}
                </p>
            </header>

            <section class="mt-12">
                <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                    {
                        catalogo.items.map((producto) => {
                            const imageUrl = getMediaUrl(
                                producto.imagen_principal,
                            );

                            return (
                                <article class="rounded-2xl border border-white/10 bg-slate-900 p-5">
                                    {imageUrl && (
                                        <img
                                            src={imageUrl}
                                            alt={
                                                producto
                                                    .imagen_principal
                                                    ?.alternativeText ||
                                                producto.nombre
                                            }
                                            class="mb-5 h-48 w-full rounded-xl object-contain"
                                        />
                                    )}

                                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-400">
                                        {producto.tipo_producto}
                                    </p>

                                    <h2 class="mt-3 text-xl font-bold text-white">
                                        {producto.nombre}
                                    </h2>

                                    <p class="mt-3 text-sm leading-6 text-slate-300">
                                        {producto.descripcion_corta}
                                    </p>

                                    <a
                                        href={`/tienda/producto/${producto.slug}`}
                                        class="mt-5 inline-flex text-sm font-bold text-blue-400"
                                    >
                                        Ver producto →
                                    </a>
                                </article>
                            );
                        })
                    }
                </div>

                <Pagination
                    currentPage={currentPage}
                    totalPages={totalPages}
                    basePath={basePath}
                />
            </section>
        </Container>
    </main>
</Layout>
