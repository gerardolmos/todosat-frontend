---
import Layout from "../../../../layouts/Layout.astro";
import Container from "../../../../components/Container.astro";
import Pagination from "../../../../components/Pagination.astro";
import ProductCard from "../../../../components/store/ProductCard.astro";

import {
    getCategoriasTienda,
    getProductosTiendaPorCategoriaPage,
    PRODUCTOS_TIENDA_POR_PAGINA,
} from "../../../../lib/store";

import type {
    CategoriaProductoTienda,
    PaginaTienda,
    ProductoTiendaResumen,
} from "../../../../types/store";

export async function getStaticPaths() {
    const categorias = await getCategoriasTienda();
    const paths = [];

    for (const categoria of categorias) {
        const firstPage =
            await getProductosTiendaPorCategoriaPage(
                categoria.slug,
                1,
                PRODUCTOS_TIENDA_POR_PAGINA,
            );

        if (firstPage.pagination.total === 0) {
            continue;
        }

        const totalPages = Math.max(
            1,
            firstPage.pagination.pageCount,
        );

        paths.push({
            params: {
                slug: categoria.slug,
                page: undefined,
            },
            props: {
                categoria,
                catalogo: firstPage,
            },
        });

        for (
            let pageNumber = 2;
            pageNumber <= totalPages;
            pageNumber += 1
        ) {
            const catalogo =
                await getProductosTiendaPorCategoriaPage(
                    categoria.slug,
                    pageNumber,
                    PRODUCTOS_TIENDA_POR_PAGINA,
                );

            paths.push({
                params: {
                    slug: categoria.slug,
                    page: String(pageNumber),
                },
                props: {
                    categoria,
                    catalogo,
                },
            });
        }
    }

    return paths;
}

const { categoria, catalogo } = Astro.props as {
    categoria: CategoriaProductoTienda;
    catalogo: PaginaTienda<ProductoTiendaResumen>;
};

const currentPage = catalogo.pagination.page;

const totalPages = Math.max(
    1,
    catalogo.pagination.pageCount,
);

const pageSuffix =
    currentPage > 1
        ? ` — Página ${currentPage}`
        : "";

const title =
    `${categoria.nombre}${pageSuffix} | Tienda TodoSatcom`;

const descriptionBase =
    categoria.descripcion ||
    `Consulta los productos de ${categoria.nombre} disponibles en la tienda TodoSatcom.`;

const description =
    currentPage > 1
        ? `${descriptionBase} Página ${currentPage}.`
        : descriptionBase;

const basePath =
    `/tienda/categoria/${categoria.slug}`;

const canonicalPath =
    currentPage > 1
        ? `${basePath}/${currentPage}`
        : basePath;
---

<Layout
    title={title}
    description={description}
    canonical={canonicalPath}
>
    <main class="min-h-screen bg-slate-100 text-slate-950">
        <section class="bg-slate-950 py-12 text-white md:py-16">
            <Container>
                <header class="max-w-4xl">
                    <a
                        href="/tienda"
                        class="text-sm font-semibold text-orange-400 transition hover:text-orange-300"
                    >
                        ← Volver a la tienda
                    </a>

                    <p class="mt-8 text-sm font-bold uppercase tracking-[0.2em] text-orange-400">
                        Categoría
                    </p>

                    <h1 class="mt-4 text-4xl font-bold tracking-tight !text-white md:text-6xl">
                        {categoria.nombre}
                    </h1>

                    <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
                        {descriptionBase}
                    </p>
                </header>
            </Container>
        </section>

        <section class="py-12 md:py-16">
            <Container>
                <div class="flex flex-wrap items-end justify-between gap-5">
                    <div>
                        <p class="text-sm font-bold uppercase tracking-[0.18em] text-orange-700">
                            Productos
                        </p>

                        <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 md:text-4xl">
                            Catálogo de {categoria.nombre}
                        </h2>
                    </div>

                    <p class="text-sm font-semibold text-slate-500">
                        {catalogo.pagination.total}
                        {
                            catalogo.pagination.total === 1
                                ? " producto"
                                : " productos"
                        }
                    </p>
                </div>

                <div class="mt-8 grid gap-7 md:grid-cols-2 xl:grid-cols-3">
                    {
                        catalogo.items.map((producto) => (
                            <ProductCard producto={producto} />
                        ))
                    }
                </div>

                <div class="[&_nav_a]:border-slate-300 [&_nav_a]:bg-white [&_nav_a]:text-slate-700 [&_nav_a:hover]:border-orange-400 [&_nav_a:hover]:text-orange-700 [&_nav_div]:border-slate-300 [&_nav_div]:bg-white [&_nav_div]:text-slate-700">
                    <Pagination
                        currentPage={currentPage}
                        totalPages={totalPages}
                        basePath={basePath}
                    />
                </div>
            </Container>
        </section>
    </main>
</Layout>
