---
import Layout from "../../../../layouts/Layout.astro";
import Container from "../../../../components/Container.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import ProductCommercialStatus from "../../../../components/store/ProductCommercialStatus.astro";

import {
    getProductoTiendaPorSlug,
    getSlugsProductosTienda,
} from "../../../../lib/store";

import { getMediaUrl } from "../../../../lib/media";
import { renderBlocks } from "../../../../lib/renderBlocks";

import type {
    ProductoTienda,
} from "../../../../types/store";

export async function getStaticPaths() {
    const slugs = await getSlugsProductosTienda();
    const paths = [];

    for (const slug of slugs) {
        const producto =
            await getProductoTiendaPorSlug(slug);

        if (!producto) {
            continue;
        }

        paths.push({
            params: {
                slug,
            },
            props: {
                producto,
            },
        });
    }

    return paths;
}

const { producto } = Astro.props as {
    producto: ProductoTienda;
};

const imagenUrl = getMediaUrl(
    producto.imagen_principal,
);

const descripcionHTML = renderBlocks(
    producto.descripcion_completa || [],
);

const incluyeHTML = renderBlocks(
    producto.incluye || [],
);

const productoPath =
    `/tienda/producto/${producto.slug}`;

const robots =
    producto.estado_venta === "Descatalogado"
        ? "noindex, follow"
        : "index, follow";

---

<Layout
    title={`${producto.nombre} | Tienda TodoSatcom`}
    description={producto.descripcion_corta}
    canonical={productoPath}
    image={imagenUrl}
    robots={robots}
>
    <main class="min-h-screen bg-slate-950 py-10 text-white">
        <Container>
            <Breadcrumbs
                items={[
                    {
                        label: "Tienda",
                        href: "/tienda",
                    },
                    {
                        label:
                            producto
                                .categoria_producto_tienda
                                .nombre,
                        href: `/tienda/categoria/${
                            producto
                                .categoria_producto_tienda
                                .slug
                        }`,
                    },
                    {
                        label: producto.nombre,
                    },
                ]}
            />

            <article class="mt-8">
                <div class="grid gap-10 lg:grid-cols-2 lg:items-start">
                    <section>
                        {
                            imagenUrl ? (
                                <div class="overflow-hidden rounded-3xl border border-white/10 bg-white p-6">
                                    <img
                                        src={imagenUrl}
                                        alt={
                                            producto
                                                .imagen_principal
                                                ?.alternativeText ||
                                            producto.nombre
                                        }
                                        class="h-[320px] w-full object-contain md:h-[480px]"
                                    />
                                </div>
                            ) : (
                                <div class="flex h-[320px] items-center justify-center rounded-3xl border border-white/10 bg-slate-900 text-slate-500 md:h-[480px]">
                                    Sin imagen
                                </div>
                            )
                        }
                    </section>

                    <header>
                        <p class="text-sm font-bold uppercase tracking-[0.18em] text-blue-400">
                            {producto.tipo_producto}
                        </p>

                        <h1 class="mt-4 text-4xl font-bold leading-tight tracking-tight !text-white md:text-6xl">
                            {producto.nombre}
                        </h1>

                        <p class="mt-5 text-sm text-slate-400">
                            SKU: {producto.sku}
                        </p>

                        <p class="mt-6 text-lg leading-8 text-slate-300">
                            {producto.descripcion_corta}
                        </p>

                        <div class="mt-8">
                            <ProductCommercialStatus
                                estado={producto.estado_venta}
                                precioCentimos={producto.precio_centimos}
                                moneda={producto.moneda}
                            />
                        </div>
                    </header>
                </div>

                {
                    producto.caracteristicas.length > 0 && (
                        <section class="mt-14 rounded-3xl border border-white/10 bg-slate-900 p-6 md:p-8">
                            <h2 class="text-3xl font-bold text-white">
                                Características
                            </h2>

                            <dl class="mt-8 grid gap-x-10 md:grid-cols-2">
                                {
                                    producto.caracteristicas.map(
                                        (caracteristica) => (
                                            <div class="border-b border-white/10 py-5">
                                                <dt class="text-xs font-bold uppercase tracking-[0.16em] text-blue-400">
                                                    {
                                                        caracteristica.etiqueta
                                                    }
                                                </dt>

                                                <dd class="mt-2 text-lg text-slate-200">
                                                    {
                                                        caracteristica.valor
                                                    }
                                                </dd>
                                            </div>
                                        ),
                                    )
                                }
                            </dl>
                        </section>
                    )
                }

                {
                    descripcionHTML && (
                        <section class="mt-14 rounded-3xl bg-white p-6 text-slate-950 md:p-10">
                            <h2 class="mb-8 text-3xl font-bold text-slate-950">
                                Descripción
                            </h2>

                            <div
                                class="prose prose-slate max-w-none"
                                set:html={descripcionHTML}
                            />
                        </section>
                    )
                }

                {
                    incluyeHTML && (
                        <section class="mt-10 rounded-3xl border border-white/10 bg-slate-900 p-6 md:p-10">
                            <h2 class="mb-8 text-3xl font-bold text-white">
                                Contenido incluido
                            </h2>

                            <div
                                class="text-slate-300"
                                set:html={incluyeHTML}
                            />
                        </section>
                    )
                }

                {
                    producto.hardware && (
                        <section class="mt-10 rounded-3xl border border-blue-500/30 bg-blue-500/10 p-6 md:p-8">
                            <p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-300">
                                Información relacionada
                            </p>

                            <h2 class="mt-3 text-2xl font-bold text-white">
                                {producto.hardware.nombre}
                            </h2>

                            <a
                                href={`/hardware/${producto.hardware.slug}`}
                                class="mt-5 inline-flex text-sm font-bold text-blue-300 transition hover:text-white"
                            >
                                Consultar ficha informativa →
                            </a>
                        </section>
                    )
                }

                {
                    producto.accesorios_compatibles.length >
                        0 && (
                        <section class="mt-14">
                            <h2 class="text-3xl font-bold text-white">
                                Accesorios compatibles
                            </h2>

                            <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
                                {
                                    producto
                                        .accesorios_compatibles
                                        .map((accesorio) => (
                                            <a
                                                href={`/tienda/producto/${accesorio.slug}`}
                                                class="rounded-2xl border border-white/10 bg-slate-900 p-5 transition hover:border-blue-500/50"
                                            >
                                                <p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-400">
                                                    {
                                                        accesorio.tipo_producto
                                                    }
                                                </p>

                                                <h3 class="mt-3 text-xl font-bold text-white">
                                                    {
                                                        accesorio.nombre
                                                    }
                                                </h3>
                                            </a>
                                        ))
                                }
                            </div>
                        </section>
                    )
                }
            </article>
        </Container>
    </main>
</Layout>
