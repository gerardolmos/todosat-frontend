---
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/Container.astro";
import { getManuales } from "../../../lib/content";
import { getMediaUrl } from "../../../lib/media";
import RelatedCard from "../../../components/RelatedCard.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { formatLabel } from "../../../lib/format";

export async function getStaticPaths() {
    const manuales = await getManuales();

    return manuales.map((manual: any) => ({
        params: {
            slug: manual.slug,
        },
        props: {
            manual,
        },
    }));
}

const { manual } = Astro.props as any;

const archivoPdfUrl = getMediaUrl(manual.archivo_pdf);
const imagenUrl = getMediaUrl(manual.imagen_portada);
const marcas = manual.operadores || [];
const modelos = manual.hardwares || [];
const articulos = manual.noticias || [];

const meta = [
    manual.version && {
        label: "Versión",
        value: manual.version,
    },
    manual.idioma && {
        label: "Idioma",
        value: formatLabel(manual.idioma),
    },
    manual.ano_publicacion && {
        label: "Año",
        value: manual.ano_publicacion,
    },
    manual.oficial !== null &&
        manual.oficial !== undefined && {
            label: "Tipo",
            value: manual.oficial ? "Manual oficial" : "Manual no oficial",
        },
].filter(Boolean);
---

<Layout
    title={`${manual.titulo} | TodoSatcom`}
    description={manual.descripcion}
>
    <main class="min-h-screen bg-slate-950 py-10 text-white">
        <Container>
            <Breadcrumbs
                items={[
                    {
                        label: "Manuales",
                        href: "/manuales",
                    },
                    {
                        label: manual.titulo,
                    },
                ]}
            />

            <section
                class="mt-8 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center"
            >
                <div>
                    <div class="flex flex-wrap items-center gap-3">
                        <a
                            href="/manuales"
                            class="text-sm font-semibold text-blue-400 transition hover:text-white"
                        >
                            ← Volver a manuales
                        </a>

                        {
                            manual.idioma && (
                                <p class="inline-flex rounded-full border border-blue-500/40 bg-blue-500/10 px-4 py-2 text-sm font-semibold text-blue-300">
                                    {formatLabel(manual.idioma)}
                                </p>
                            )
                        }
                    </div>

                    <h1
                        class="mt-8 max-w-4xl text-4xl font-bold leading-tight tracking-tight !text-white md:text-6xl"
                    >
                        {manual.titulo}
                    </h1>

                    {
                        manual.descripcion && (
                            <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300 md:text-xl">
                                {manual.descripcion}
                            </p>
                        )
                    }

                    {
                        archivoPdfUrl && (
                            <a
                                href={archivoPdfUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="mt-8 inline-flex rounded-full border border-[#00ccff] bg-[#00ccff] px-5 py-3 text-sm font-bold text-slate-950 shadow-[0_0_18px_rgba(0,204,255,0.35)] transition hover:bg-white"
                            >
                                Abrir PDF →
                            </a>
                        )
                    }
                </div>

                {
                    imagenUrl && (
                        <div class="overflow-hidden">
                            <img
                                src={imagenUrl}
                                alt={manual.titulo}
                                class="h-[320px] w-full object-contain lg:h-[420px]"
                            />
                        </div>
                    )
                }
            </section>

            {
                meta.length > 0 && (
                    <section class="mt-16 rounded-3xl border border-white/10 bg-slate-900/70 p-6 shadow-2xl shadow-slate-950/30 md:p-8">
                        <h2 class="mb-6 text-3xl font-bold text-white">
                            Datos del manual
                        </h2>

                        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                            {meta.map((item: any) => (
                                <div class="rounded-2xl border border-white/10 bg-slate-950/70 p-4">
                                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                                        {item.label}
                                    </p>

                                    <p class="mt-2 text-lg font-semibold text-white">
                                        {item.value}
                                    </p>
                                </div>
                            ))}
                        </div>
                    </section>
                )
            }

            {
                (marcas.length > 0 ||
                    modelos.length > 0 ||
                    articulos.length > 0) && (
                    <section class="mt-16 border-t border-white/10 pt-12">
                        <h2 class="mb-8 text-3xl font-bold text-white">
                            Contenido relacionado
                        </h2>

                        <div class="grid gap-8 lg:grid-cols-3">
                            {marcas.length > 0 && (
                                <div>
                                    <h3 class="mb-5 border-l-2 border-blue-500 pl-3 text-sm font-bold uppercase tracking-[0.16em] text-slate-300">
                                        Operadores relacionados
                                    </h3>

                                    <div class="grid gap-5 [&>a]:min-h-[190px] [&>a]:h-full">
                                        {marcas.map((marca: any) => (
                                            <RelatedCard
                                                type="Operador"
                                                title={marca.nombre}
                                                description={
                                                    marca.descripcion_corta
                                                }
                                                url={`/operadores/${marca.slug}`}
                                                image={marca.imagen_portada}
                                            />
                                        ))}
                                    </div>
                                </div>
                            )}

                            {modelos.length > 0 && (
                                <div>
                                    <h3 class="mb-5 border-l-2 border-blue-500 pl-3 text-sm font-bold uppercase tracking-[0.16em] text-slate-300">
                                        Hardware relacionado
                                    </h3>

                                    <div class="grid gap-5 [&>a]:min-h-[190px] [&>a]:h-full">
                                        {modelos.map((modelo: any) => (
                                            <RelatedCard
                                                type="Modelo"
                                                title={modelo.nombre}
                                                description={
                                                    modelo.descripcion_corta
                                                }
                                                url={`/hardware/${modelo.slug}`}
                                                image={modelo.imagen_principal}
                                            />
                                        ))}
                                    </div>
                                </div>
                            )}

                            {articulos.length > 0 && (
                                <div>
                                    <h3 class="mb-5 border-l-2 border-blue-500 pl-3 text-sm font-bold uppercase tracking-[0.16em] text-slate-300">
                                        Artículos relacionados
                                    </h3>

                                    <div class="grid gap-5 [&>a]:min-h-[190px] [&>a]:h-full">
                                        {articulos.map((articulo: any) => (
                                            <RelatedCard
                                                type="Artículo"
                                                title={articulo.titulo}
                                                description={articulo.subtitulo}
                                                url={`/noticias/${articulo.slug}`}
                                                image={
                                                    articulo.imagen_principal
                                                }
                                            />
                                        ))}
                                    </div>
                                </div>
                            )}
                        </div>
                    </section>
                )
            }
        </Container>
    </main>
</Layout>
