---
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/Container.astro";
import { getManuales } from "../../../lib/content";
import { getMediaUrl } from "../../../lib/media";
import RelatedCard from "../../../components/RelatedCard.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { formatLabel } from "../../../lib/format";

export async function getStaticPaths() {
    const manuales = await getManuales();

    return manuales.map((manual: any) => ({
        params: {
            slug: manual.slug,
        },
        props: {
            manual,
        },
    }));
}

const { manual } = Astro.props as any;

const archivoPdfUrl = getMediaUrl(manual.archivo_pdf);
const imagenUrl = getMediaUrl(manual.imagen_portada);
const marcas = manual.marcas || [];
const modelos = manual.modelos || [];
const articulos = manual.articulos || [];

const meta = [
    manual.version && {
        label: "Versión",
        value: manual.version,
    },
    manual.idioma && {
        label: "Idioma",
        value: formatLabel(manual.idioma),
    },
    manual.ano_publicacion && {
        label: "Año",
        value: manual.ano_publicacion,
    },
    manual.oficial !== null &&
        manual.oficial !== undefined && {
            label: "Tipo",
            value: manual.oficial ? "Manual oficial" : "Manual no oficial",
        },
].filter(Boolean);
---

<Layout title={`${manual.titulo} | Todo-Sat`} description={manual.descripcion}>
    <main class="min-h-screen py-10">
        <Container>
            <Breadcrumbs
                items={[
                    {
                        label: "Manuales",
                        href: "/manuales",
                    },
                    {
                        label: manual.titulo,
                    },
                ]}
            />

            <section
                class="mt-8 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center"
            >
                <div>
                    <a
                        href="/manuales"
                        class="text-sm font-semibold text-info-primary hover:text-info-primary-dark"
                    >
                        ← Volver a manuales
                    </a>

                    {
                        manual.idioma && (
                            <p class="mt-8 inline-flex rounded-full bg-info-primary-soft px-4 py-2 text-sm font-semibold text-info-primary-dark">
                                {formatLabel(manual.idioma)}
                            </p>
                        )
                    }

                    <h1 class="mt-6 max-w-4xl">
                        {manual.titulo}
                    </h1>

                    {
                        manual.descripcion && (
                            <p class="mt-6 max-w-2xl text-xl leading-8 text-brand-muted">
                                {manual.descripcion}
                            </p>
                        )
                    }

                    {
                        archivoPdfUrl && (
                            <a
                                href={archivoPdfUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="mt-8 inline-flex rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-info-primary-dark"
                            >
                                Abrir PDF →
                            </a>
                        )
                    }
                </div>

                {
                    imagenUrl && (
                        <div class="overflow-hidden rounded-3xl border border-brand-border bg-white shadow-sm">
                            <img
                                src={imagenUrl}
                                alt={manual.titulo}
                                class="h-full max-h-[460px] w-full object-cover"
                            />
                        </div>
                    )
                }
            </section>

            {
                meta.length > 0 && (
                    <section class="mt-16 rounded-3xl border border-brand-border bg-white p-6 shadow-sm md:p-8">
                        <h2 class="mb-6 text-3xl">Datos del manual</h2>

                        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                            {meta.map((item: any) => (
                                <div class="rounded-2xl bg-brand-soft p-4">
                                    <p class="text-xs font-semibold uppercase tracking-wider text-brand-muted">
                                        {item.label}
                                    </p>

                                    <p class="mt-2 text-lg font-semibold text-brand-base">
                                        {item.value}
                                    </p>
                                </div>
                            ))}
                        </div>
                    </section>
                )
            }

            {
                marcas.length > 0 && (
                    <section class="mt-16 border-t border-brand-border pt-12">
                        <h2 class="mb-6">Marcas relacionadas</h2>

                        <div class="grid gap-5 md:grid-cols-2">
                            {marcas.map((marca: any) => (
                                <RelatedCard
                                    type="Marca"
                                    title={marca.nombre}
                                    description={marca.descripcion_corta}
                                    url={`/marcas/${marca.slug}`}
                                    image={marca.imagen_portada}
                                />
                            ))}
                        </div>
                    </section>
                )
            }

            {
                modelos.length > 0 && (
                    <section class="mt-16 border-t border-brand-border pt-12">
                        <h2 class="mb-6">Modelos relacionados</h2>

                        <div class="grid gap-5 md:grid-cols-2">
                            {modelos.map((modelo: any) => (
                                <RelatedCard
                                    type="Modelo"
                                    title={modelo.nombre}
                                    description={modelo.descripcion_corta}
                                    url={`/modelos/${modelo.slug}`}
                                    image={modelo.imagen_principal}
                                />
                            ))}
                        </div>
                    </section>
                )
            }

            {
                articulos.length > 0 && (
                    <section class="mt-16 border-t border-brand-border pt-12">
                        <h2 class="mb-6">Artículos relacionados</h2>

                        <div class="grid gap-5 md:grid-cols-2">
                            {articulos.map((articulo: any) => (
                                <RelatedCard
                                    type="Artículo"
                                    title={articulo.titulo}
                                    description={articulo.subtitulo}
                                    url={`/articulos/${articulo.slug}`}
                                    image={articulo.imagen_principal}
                                />
                            ))}
                        </div>
                    </section>
                )
            }
        </Container>
    </main>
</Layout>
