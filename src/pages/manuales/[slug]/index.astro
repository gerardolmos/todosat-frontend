---
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/Container.astro";
import { getManuales } from "../../../lib/content";
import { getMediaUrl } from "../../../lib/media";

export async function getStaticPaths() {
    const manuales = await getManuales();

    return manuales.map((manual: any) => ({
        params: {
            slug: manual.slug,
        },
        props: {
            manual,
        },
    }));
}

const { manual } = Astro.props as any;

const archivoPdfUrl = getMediaUrl(manual.archivo_pdf);
const imagenUrl = getMediaUrl(manual.imagen_portada);
const marcas = manual.marcas || [];
const modelos = manual.modelos || [];
const articulos = manual.articulos || [];
---

<Layout title={`${manual.titulo} | TODOSat`}>
    <main class="min-h-screen py-10">
        <Container>
            <a href="/manuales" class="text-blue-600 underline">
                ← Volver a manuales
            </a>

            <h1 class="mt-6 text-5xl font-bold">
                {manual.titulo}
            </h1>

            {
                manual.descripcion && (
                    <p class="mt-4 text-xl text-gray-700">
                        {manual.descripcion}
                    </p>
                )
            }

            {
                imagenUrl && (
                    <img
                        src={imagenUrl}
                        alt={manual.titulo}
                        class="mt-8 w-full max-w-4xl rounded"
                    />
                )
            }

            <div class="mt-10 space-y-2">
                {
                    manual.version && (
                        <p>
                            Versión: <strong>{manual.version}</strong>
                        </p>
                    )
                }

                {
                    manual.idioma && (
                        <p>
                            Idioma: <strong>{manual.idioma}</strong>
                        </p>
                    )
                }

                {
                    manual.ano_publicacion && (
                        <p>
                            Año: <strong>{manual.ano_publicacion}</strong>
                        </p>
                    )
                }

                {
                    manual.oficial !== null && manual.oficial !== undefined && (
                        <p>
                            Tipo:{" "}
                            <strong>
                                {manual.oficial
                                    ? "Manual oficial"
                                    : "Manual no oficial"}
                            </strong>
                        </p>
                    )
                }
            </div>

            {
                archivoPdfUrl && (
                    <p class="mt-8">
                        <a
                            href={archivoPdfUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-block rounded bg-blue-600 px-5 py-3 font-medium text-white hover:bg-blue-700"
                        >
                            Abrir PDF
                        </a>
                    </p>
                )
            }

            {
                marcas.length > 0 && (
                    <section class="mt-12">
                        <h2 class="text-3xl font-bold">Marcas relacionadas</h2>

                        <ul class="mt-4 space-y-2">
                            {marcas.map((marca: any) => (
                                <li>
                                    <a
                                        href={`/marcas/${marca.slug}`}
                                        class="text-blue-600 underline"
                                    >
                                        {marca.nombre}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </section>
                )
            }

            {
                modelos.length > 0 && (
                    <section class="mt-12">
                        <h2 class="text-3xl font-bold">Modelos relacionados</h2>

                        <ul class="mt-4 space-y-2">
                            {modelos.map((modelo: any) => (
                                <li>
                                    <a
                                        href={`/modelos/${modelo.slug}`}
                                        class="text-blue-600 underline"
                                    >
                                        {modelo.nombre}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </section>
                )
            }

            {
                articulos.length > 0 && (
                    <section class="mt-12">
                        <h2 class="text-3xl font-bold">
                            Artículos relacionados
                        </h2>

                        <ul class="mt-4 space-y-2">
                            {articulos.map((articulo: any) => (
                                <li>
                                    <a
                                        href={`/articulos/${articulo.slug}`}
                                        class="text-blue-600 underline"
                                    >
                                        {articulo.titulo}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </section>
                )
            }
        </Container>
    </main>
</Layout>
