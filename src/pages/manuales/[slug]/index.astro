---
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/Container.astro";
import { getManuales } from "../../../lib/content";
import { renderBlocks } from "../../../lib/renderBlocks";
import { getImage } from "astro:assets";
import { getMediaUrl } from "../../../lib/media";
import RelatedCard from "../../../components/RelatedCard.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { formatLabel } from "../../../lib/format";

export async function getStaticPaths() {
    const manuales = await getManuales();

    return manuales.map((manual: any) => ({
        params: {
            slug: manual.slug,
        },
        props: {
            manual,
        },
    }));
}

const { manual } = Astro.props as any;

const estadoEditorial = manual.discontinuado
    ? "Discontinuado"
    : manual.descatalogado
      ? "Descatalogado"
      : null;

const archivoPdfUrl = getMediaUrl(manual.archivo_pdf);

const imagenOrigenUrl = getMediaUrl(manual.imagen_portada);
const imagenOptimizada = imagenOrigenUrl
    ? await getImage({
          src: imagenOrigenUrl,
          inferSize: true,
      })
    : null;

const imagenUrl = imagenOptimizada?.src ?? null;
const imagenWidth = imagenOptimizada?.attributes.width;
const imagenHeight = imagenOptimizada?.attributes.height;

const contenidoHTML = renderBlocks(manual.contenido);
const marcas = manual.operadores || [];
const modelos = manual.hardwares || [];
const articulos = manual.noticias || [];

const meta = [
    manual.version && {
        label: "Versión",
        value: manual.version,
    },
    manual.idioma && {
        label: "Idioma",
        value: formatLabel(manual.idioma),
    },
    manual.ano_publicacion && {
        label: "Año",
        value: manual.ano_publicacion,
    },
    manual.oficial !== null &&
        manual.oficial !== undefined && {
            label: "Tipo",
            value: manual.oficial ? "Manual oficial" : "Manual no oficial",
        },
].filter(Boolean);

function toIsoDate(value: unknown) {
    if (!value) return null;

    const date = new Date(String(value));

    return Number.isNaN(date.getTime()) ? null : date.toISOString();
}

const manualTitle = String(manual.titulo || "").trim();
const manualPath = `/manuales/${manual.slug}`;
const siteUrl = Astro.site ?? new URL("https://todosatcom.com");
const imagenSeoUrl = imagenUrl
    ? new URL(imagenUrl, siteUrl).toString()
    : null;
const manualUrl = new URL(`${manualPath}/`, siteUrl).toString();
const homeUrl = new URL("/", siteUrl).toString();
const manualsUrl = new URL("/manuales/", siteUrl).toString();
const modifiedTime = toIsoDate(manual.updatedAt);

const about = [
    ...marcas.map((marca: any) => ({
        "@type": "Organization",
        name: String(marca.nombre || "").trim(),
        url: new URL(
            `/operadores/${marca.slug}/`,
            siteUrl,
        ).toString(),
    })),
    ...modelos.map((modelo: any) => ({
        "@type": "Product",
        name: String(modelo.nombre || "").trim(),
        url: new URL(
            `/hardware/${modelo.slug}/`,
            siteUrl,
        ).toString(),
    })),
];

const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebPage",
            "@id": manualUrl,
            url: manualUrl,
            name: manualTitle,
            description: manual.descripcion,
            inLanguage: "es-ES",
            mainEntity: {
                "@id": `${manualUrl}#document`,
            },
            ...(imagenSeoUrl
                ? {
                      primaryImageOfPage: {
                          "@type": "ImageObject",
                          url: imagenSeoUrl,
                      },
                  }
                : {}),
            ...(modifiedTime
                ? {
                      dateModified: modifiedTime,
                  }
                : {}),
        },
        {
            "@type": "DigitalDocument",
            "@id": `${manualUrl}#document`,
            name: manualTitle,
            description: manual.descripcion,
            url: manualUrl,
            ...(imagenSeoUrl ? { image: [imagenSeoUrl] } : {}),
            ...(manual.idioma
                ? {
                      inLanguage: formatLabel(manual.idioma),
                  }
                : {}),
            ...(manual.version
                ? {
                      version: String(manual.version),
                  }
                : {}),
            ...(about.length > 0 ? { about } : {}),
            ...(archivoPdfUrl
                ? {
                      encoding: {
                          "@type": "MediaObject",
                          contentUrl: archivoPdfUrl,
                          encodingFormat:
                              manual.archivo_pdf?.mime ||
                              "application/pdf",
                      },
                  }
                : {}),
        },
        {
            "@type": "BreadcrumbList",
            "@id": `${manualUrl}#breadcrumb`,
            itemListElement: [
                {
                    "@type": "ListItem",
                    position: 1,
                    name: "Inicio",
                    item: homeUrl,
                },
                {
                    "@type": "ListItem",
                    position: 2,
                    name: "Manuales",
                    item: manualsUrl,
                },
                {
                    "@type": "ListItem",
                    position: 3,
                    name: manualTitle,
                    item: manualUrl,
                },
            ],
        },
    ],
};
---

<Layout
    title={`${manualTitle} | TodoSatcom`}
    description={manual.descripcion}
    canonical={manualPath}
    image={imagenUrl}
    structuredData={structuredData}
>
    <main class="min-h-screen bg-slate-950 py-10 text-white">
        <Container>
            <Breadcrumbs
                items={[
                    {
                        label: "Manuales",
                        href: "/manuales",
                    },
                    {
                        label: manual.titulo,
                    },
                ]}
            />

            <section
                class="mt-8 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center"
            >
                <div>
                    <div class="flex flex-wrap items-center gap-3">
                        <a
                            href="/manuales"
                            class="text-sm font-semibold text-blue-400 transition hover:text-white"
                        >
                            ← Volver a manuales
                        </a>

                        {
                            manual.idioma && (
                                <p class="inline-flex rounded-full border border-blue-500/40 bg-blue-500/10 px-4 py-2 text-sm font-semibold text-blue-300">
                                    {formatLabel(manual.idioma)}
                                </p>
                            )
                        }

                        {
                            estadoEditorial && (
                                <p
                                    class={`inline-flex rounded-full border px-4 py-2 text-sm font-bold uppercase tracking-[0.08em] ${
                                        manual.discontinuado
                                            ? "border-red-400/60 bg-red-400/10 text-red-300"
                                            : "border-amber-400/60 bg-amber-400/10 text-amber-300"
                                    }`}
                                >
                                    {estadoEditorial}
                                </p>
                            )
                        }
                    </div>

                    <h1
                        class="mt-8 max-w-4xl text-4xl font-bold leading-tight tracking-tight !text-white md:text-6xl"
                    >
                        {manual.titulo}
                    </h1>

                    {
                        manual.descripcion && (
                            <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300 md:text-xl">
                                {manual.descripcion}
                            </p>
                        )
                    }

                    {
                        archivoPdfUrl && (
                            <a
                                href={archivoPdfUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="mt-8 inline-flex rounded-full border border-[#00ccff] bg-[#00ccff] px-5 py-3 text-sm font-bold text-slate-950 shadow-[0_0_18px_rgba(0,204,255,0.35)] transition hover:bg-white"
                            >
                                Abrir PDF →
                            </a>
                        )
                    }
                </div>

                {
                    imagenUrl && (
                        <div class="overflow-hidden">
                            <img
                                src={imagenUrl}
                                width={imagenWidth}
                                height={imagenHeight}
                                alt={manual.titulo}
                                class="h-[320px] w-full object-contain lg:h-[420px]"
                            />
                        </div>
                    )
                }
            </section>

            {
                meta.length > 0 && (
                    <section class="mt-16 rounded-3xl border border-white/10 bg-slate-900/70 p-6 shadow-2xl shadow-slate-950/30 md:p-8">
                        <h2 class="mb-6 text-3xl font-bold text-white">
                            Datos del manual
                        </h2>

                        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                            {meta.map((item: any) => (
                                <div class="rounded-2xl border border-white/10 bg-slate-950/70 p-4">
                                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                                        {item.label}
                                    </p>

                                    <p class="mt-2 text-lg font-semibold text-white">
                                        {item.value}
                                    </p>
                                </div>
                            ))}
                        </div>
                    </section>
                )
            }

            {
                contenidoHTML && (
                    <section class="mt-16 overflow-hidden rounded-3xl border border-white/10 bg-white text-slate-950 shadow-2xl shadow-slate-950/30">
                        <div class="border-b border-slate-200 px-6 py-6 md:px-10">
                            <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-700">
                                Documentación
                            </p>
                            <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">
                                Contenido del manual
                            </h2>
                        </div>

                        <div
                            class="prose prose-slate max-w-none px-6 py-8 prose-headings:text-slate-950 prose-p:text-slate-700 prose-a:text-blue-600 prose-strong:text-slate-950 prose-li:text-slate-700 md:px-10 md:py-12 md:[&_p]:text-[1.08rem] md:[&_p]:leading-8 md:[&_li]:text-[1.08rem] md:[&_li]:leading-8"
                            set:html={contenidoHTML}
                        />
                    </section>
                )
            }

            {
                (marcas.length > 0 ||
                    modelos.length > 0 ||
                    articulos.length > 0) && (
                    <section class="mt-16 border-t border-white/10 pt-12">
                        <h2 class="mb-8 text-3xl font-bold text-white">
                            Contenido relacionado
                        </h2>

                        <div class="grid gap-8 lg:grid-cols-3">
                            {marcas.length > 0 && (
                                <div>
                                    <h3 class="mb-5 border-l-2 border-blue-500 pl-3 text-sm font-bold uppercase tracking-[0.16em] text-slate-300">
                                        Operadores relacionados
                                    </h3>

                                    <div class="grid gap-5 [&>a]:min-h-[190px] [&>a]:h-full">
                                        {marcas.map((marca: any) => (
                                            <RelatedCard
                                                type="Operador"
                                                title={marca.nombre}
                                                description={
                                                    marca.descripcion_corta
                                                }
                                                url={`/operadores/${marca.slug}`}
                                                image={marca.imagen_portada}
                                            />
                                        ))}
                                    </div>
                                </div>
                            )}

                            {modelos.length > 0 && (
                                <div>
                                    <h3 class="mb-5 border-l-2 border-blue-500 pl-3 text-sm font-bold uppercase tracking-[0.16em] text-slate-300">
                                        Hardware relacionado
                                    </h3>

                                    <div class="grid gap-5 [&>a]:min-h-[190px] [&>a]:h-full">
                                        {modelos.map((modelo: any) => (
                                            <RelatedCard
                                                type="Hardware"
                                                title={modelo.nombre}
                                                description={
                                                    modelo.descripcion_corta
                                                }
                                                url={`/hardware/${modelo.slug}`}
                                                image={modelo.imagen_principal}
                                            />
                                        ))}
                                    </div>
                                </div>
                            )}

                            {articulos.length > 0 && (
                                <div>
                                    <h3 class="mb-5 border-l-2 border-blue-500 pl-3 text-sm font-bold uppercase tracking-[0.16em] text-slate-300">
                                        Noticias relacionadas
                                    </h3>

                                    <div class="grid gap-5 [&>a]:min-h-[190px] [&>a]:h-full">
                                        {articulos.map((articulo: any) => (
                                            <RelatedCard
                                                type="Noticia"
                                                title={articulo.titulo}
                                                description={articulo.subtitulo}
                                                url={`/noticias/${articulo.slug}`}
                                                image={
                                                    articulo.imagen_principal
                                                }
                                            />
                                        ))}
                                    </div>
                                </div>
                            )}
                        </div>
                    </section>
                )
            }
        </Container>
    </main>
</Layout>
