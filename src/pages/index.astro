---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import {
	getMarcasDestacadas,
	getArticulos,
	getDestacados,
	getModelos,
	getManuales,
} from "../lib/content";
import ArticleCard from "../components/ArticleCard.astro";
import BrandCard from "../components/BrandCard.astro";
import FeaturedCard from "../components/FeaturedCard.astro";
import ModelCard from "../components/ModelCard.astro";
import ManualCard from "../components/ManualCard.astro";

const destacados = await getDestacados();
const marcasDestacadas = await getMarcasDestacadas();
const modelos = (await getModelos()).slice(0, 3);
const manuales = (await getManuales()).slice(0, 3);

const articulos = (await getArticulos())
	.sort(
		(a: any, b: any) =>
			new Date(b.fecha_publicacion).getTime() -
			new Date(a.fecha_publicacion).getTime(),
	)
	.slice(0, 3);
---

<Layout title="TODOSat">
	<main class="min-h-screen py-10">
		<Container>
			<section class="py-12">
				<h1 class="font-heading text-5xl font-bold">Todo-Sat</h1>

				<p class="mt-6 max-w-3xl text-xl text-gray-600">
					Portal especializado en internet satelital, hardware,
					cobertura, instalación y actualidad del sector.
				</p>

				<form
					action="/buscar"
					method="get"
					class="mt-8 flex max-w-2xl gap-3"
				>
					<input
						type="search"
						name="q"
						placeholder="Buscar marcas, modelos, artículos o manuales..."
						class="w-full rounded border px-4 py-3"
					/>

					<button
						type="submit"
						class="rounded bg-blue-600 px-5 py-3 font-medium text-white hover:bg-blue-700"
					>
						Buscar
					</button>
				</form>
			</section>

			{
				marcasDestacadas.length > 0 && (
					<section class="mt-12">
						<div class="mb-6 flex items-end justify-between gap-4">
							<div>
								<h2 class="text-3xl font-bold">
									Marcas destacadas
								</h2>
								<p class="mt-2 text-gray-600">
									Una selección de operadores y compañías
									relevantes del sector.
								</p>
							</div>

							<a href="/marcas" class="text-blue-600 underline">
								Ver todas las marcas →
							</a>
						</div>

						<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
							{marcasDestacadas.map((marca: any) => (
								<BrandCard marca={marca} />
							))}
						</div>
					</section>
				)
			}

			{
				destacados.length > 0 && (
					<section class="mt-12">
						<h2 class="mb-6 text-3xl font-bold">
							Contenido destacado
						</h2>

						<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
							{destacados.map((destacado: any) => (
								<FeaturedCard destacado={destacado} />
							))}
						</div>
					</section>
				)
			}

			<section class="mt-16">
				<h2 class="mb-6 text-3xl font-bold">Últimos artículos</h2>

				<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
					{
						articulos.map((articulo: any) => (
							<ArticleCard articulo={articulo} />
						))
					}
				</div>
			</section>
			{
				modelos.length > 0 && (
					<section class="mt-16">
						<div class="mb-6 flex items-end justify-between gap-4">
							<div>
								<h2 class="text-3xl font-bold">
									Modelos recientes
								</h2>
								<p class="mt-2 text-gray-600">
									Equipos y terminales destacados del
									ecosistema satelital.
								</p>
							</div>

							<a href="/modelos" class="text-blue-600 underline">
								Ver todos los modelos →
							</a>
						</div>

						<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
							{modelos.map((modelo: any) => (
								<ModelCard modelo={modelo} />
							))}
						</div>
					</section>
				)
			}

			{
				manuales.length > 0 && (
					<section class="mt-16">
						<div class="mb-6 flex items-end justify-between gap-4">
							<div>
								<h2 class="text-3xl font-bold">
									Últimos manuales
								</h2>
								<p class="mt-2 text-gray-600">
									Documentación técnica, guías y manuales
									relacionados.
								</p>
							</div>

							<a href="/manuales" class="text-blue-600 underline">
								Ver todos los manuales →
							</a>
						</div>

						<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
							{manuales.map((manual: any) => (
								<ManualCard manual={manual} />
							))}
						</div>
					</section>
				)
			}
		</Container>
	</main>
</Layout>
