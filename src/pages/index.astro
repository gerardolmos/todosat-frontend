---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import {
	getArticulos,
	getDestacados,
	getModelos,
	getManuales,
	getMarcasHome,
} from "../lib/content";
import ArticleCard from "../components/ArticleCard.astro";
import ModelCard from "../components/ModelCard.astro";
import ManualCard from "../components/ManualCard.astro";
import HomeOperatorsSection from "../components/HomeOperatorsSection.astro";
import HomeFeaturedSection from "../components/HomeFeaturedSection.astro";
import HomeArticlesSection from "../components/HomeArticlesSection.astro";
import HomeModelsSection from "../components/HomeModelsSection.astro";
import HomeManualsSection from "../components/HomeManualsSection.astro";
import SectionDivider from "../components/SectionDivider.astro";

const destacados = await getDestacados();
const modelos = (await getModelos()).slice(0, 7);
const manuales = (await getManuales()).slice(0, 7);
const marcasHome = await getMarcasHome();

const articulos = (await getArticulos())
	.sort(
		(a: any, b: any) =>
			new Date(b.fecha_publicacion).getTime() -
			new Date(a.fecha_publicacion).getTime(),
	)
	.slice(0, 7);
---

<Layout
	title="TodoSatcom"
	description="Portal especializado en internet satelital, hardware, cobertura, instalación y actualidad del sector."
>
	<main class="min-h-screen bg-slate-950">
		<section class="relative overflow-hidden py-14 md:py-36">
			<video
				class="absolute inset-0 h-full w-full object-cover"
				autoplay
				muted
				loop
				playsinline
				preload="metadata"
			>
				<source src="/videos/hero-satcom.mp4" type="video/mp4" />
			</video>

			<div class="absolute inset-0 bg-slate-950/75"></div>

			<Container>
				<div class="relative z-10 max-w-3xl">
					<h1
						class="font-body text-3xl font-semibold tracking-tight md:text-6xl"
						style="color:white;"
					>
						Tu referente en internet satelital y comunicaciones.
					</h1>

					<p class="mt-5 max-w-2xl text-lg leading-8 text-slate-200">
						Guías, manuales, operadores, hardware y actualidad sobre
						comunicaciones satelitales.
					</p>

					<form
						action="/buscar"
						method="get"
						class="mt-8 flex max-w-2xl items-center gap-2 rounded-full border border-white/15 bg-slate-950/55 p-2 shadow-2xl shadow-slate-950/40 backdrop-blur-md"
					>
						<div
							class="flex min-h-12 flex-1 items-center gap-3 rounded-full px-4"
						>
							<span class="text-slate-400">⌕</span>

							<input
								type="search"
								name="q"
								autocomplete="off"
								spellcheck="false"
								placeholder="Buscar operadores, modelos, artículos o manuales..."
								class="w-full appearance-none bg-transparent text-sm text-white outline-none placeholder:text-slate-400"
							/>
						</div>

						<button
							type="submit"
							class="rounded-full bg-blue-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-blue-500"
						>
							Buscar
						</button>
					</form>
				</div>
			</Container>
		</section>

		<section class="bg-slate-950">
			<Container>
				<HomeOperatorsSection marcas={marcasHome} />
				<SectionDivider />
				<HomeFeaturedSection destacados={destacados} />
				<SectionDivider />
				<HomeArticlesSection articulos={articulos} />
				<SectionDivider />
				<HomeModelsSection modelos={modelos} />
				<SectionDivider />
				<HomeManualsSection manuales={manuales} />
			</Container>
		</section>
	</main>
</Layout>
