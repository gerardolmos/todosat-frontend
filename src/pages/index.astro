---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import {
	getArticulos,
	getDestacados,
	getModelos,
	getManuales,
	getMarcas,
	getMarcasHome,
} from "../lib/content";
import HomeOperatorsSection from "../components/HomeOperatorsSection.astro";
import HomeFeaturedSection from "../components/HomeFeaturedSection.astro";
import HomeArticlesSection from "../components/HomeArticlesSection.astro";
import HomeModelsSection from "../components/HomeModelsSection.astro";
import HomeManualsSection from "../components/HomeManualsSection.astro";
import SectionDivider from "../components/SectionDivider.astro";
import searchIcon from "../assets/images/icons/search.svg";

const destacados = await getDestacados();

const todosModelos = await getModelos();
const todosManuales = await getManuales();
const todosArticulos = await getArticulos();

const modelos = todosModelos.slice(0, 7);
const manuales = todosManuales.slice(0, 7);
const marcasHome = await getMarcasHome();
const marcasBusqueda = await getMarcas();

const articulos = todosArticulos
	.sort(
		(a: any, b: any) =>
			new Date(b.fecha_publicacion).getTime() -
			new Date(a.fecha_publicacion).getTime(),
	)
	.slice(0, 7);

function limpiarTexto(valor: any) {
	return String(valor || "")
		.toLowerCase()
		.normalize("NFD")
		.replace(/[\u0300-\u036f]/g, "");
}

const datosBusqueda = [
	...marcasBusqueda.map((item: any) => ({
		tipo: "Operador",
		titulo: item.nombre,
		descripcion: item.descripcion_corta,
		url: `/operadores/${item.slug}`,
		texto: limpiarTexto(
			`${item.nombre} ${item.descripcion_corta} ${item.descripcion_home}`,
		),
	})),

	...todosModelos.map((item: any) => ({
		tipo: "Hardware",
		titulo: item.nombre,
		url: `/hardware/${item.slug}`,
		descripcion: item.descripcion_corta,
		texto: limpiarTexto(
			`${item.nombre} ${item.descripcion_corta} ${item.tipo_hardware} ${item.marca?.nombre}`,
		),
	})),

	...todosArticulos.map((item: any) => ({
		tipo: "Artículo",
		titulo: item.titulo,
		url: `/noticias/${item.slug}`,
		descripcion: item.subtitulo,
		texto: limpiarTexto(
			`${item.titulo} ${item.subtitulo} ${item.contenido} ${
				item.categoria_tematica?.nombre || ""
			} ${item.categoria_tematica?.slug || ""}`,
		),
	})),

	...todosManuales.map((item: any) => ({
		tipo: "Manual",
		titulo: item.titulo,
		url: `/manuales/${item.slug}`,
		descripcion: item.descripcion,
		texto: limpiarTexto(
			`${item.titulo} ${item.descripcion} ${item.idioma}`,
		),
	})),
];
---

<script>
	function limpiarTexto(valor: string) {
		return String(valor || "")
			.toLowerCase()
			.normalize("NFD")
			.replace(/[\u0300-\u036f]/g, "");
	}

	function escapeHtml(valor: string) {
		return String(valor || "")
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/"/g, "&quot;")
			.replace(/'/g, "&#039;");
	}

	type SearchItem = {
		tipo: string;
		titulo: string;
		descripcion?: string;
		url: string;
		texto: string;
	};

	const input = document.querySelector(
		'form[action="/buscar"] input[name="q"]',
	);
	const suggestions = document.getElementById("hero-search-suggestions");
	const dataElement = document.getElementById("hero-search-data");

	if (
		input instanceof HTMLInputElement &&
		suggestions instanceof HTMLElement &&
		dataElement instanceof HTMLScriptElement
	) {
		const data = JSON.parse(
			dataElement.textContent || "[]",
		) as SearchItem[];

		input.addEventListener("input", () => {
			const queryOriginal = input.value.trim();
			const query = limpiarTexto(queryOriginal);

			if (query.length < 2) {
				suggestions.classList.add("hidden");
				suggestions.innerHTML = "";
				return;
			}

			const palabras = query.split(/\s+/).filter(Boolean);

			function calcularPuntuacion(item: SearchItem, palabras: string[]) {
				const titulo = limpiarTexto(item.titulo);
				const texto = limpiarTexto(item.texto);

				let puntos = 0;

				for (const palabra of palabras) {
					if (titulo === palabra) puntos += 100;
					else if (titulo.startsWith(palabra)) puntos += 80;
					else if (titulo.includes(palabra)) puntos += 60;
					else if (texto.includes(` ${palabra} `)) puntos += 20;
					else return 0;
				}

				return puntos;
			}

			function coincidePalabra(texto: string, palabra: string) {
				const palabrasTexto = texto.split(/\s+/).filter(Boolean);

				return palabrasTexto.some((palabraTexto) =>
					palabraTexto.startsWith(palabra),
				);
			}

			const resultados = data
				.filter((item: SearchItem) =>
					palabras.every((palabra) =>
						coincidePalabra(item.texto, palabra),
					),
				)
				.slice(0, 6);

			if (resultados.length === 0) {
				suggestions.classList.add("hidden");
				suggestions.innerHTML = "";
				return;
			}

			suggestions.innerHTML = `
				<div class="p-2">
					${resultados
						.map(
							(item: SearchItem) => `
								<a
									href="${item.url}"
									class="group flex items-center justify-between gap-4 rounded-xl px-4 py-3 transition hover:bg-slate-900"
								>
									<div>
	<p class="text-sm font-bold text-white group-hover:text-[#4EA1FF]">
		${escapeHtml(item.titulo)}
	</p>

	<p class="mt-1 text-xs font-semibold uppercase tracking-[0.14em] text-blue-400">
		${escapeHtml(item.tipo)}
	</p>

	${
		item.descripcion
			? `
				<p class="mt-2 line-clamp-1 text-xs text-slate-400">
					${escapeHtml(item.descripcion)}
				</p>
			`
			: ""
	}
</div>

									<span class="text-slate-500 group-hover:text-[#4EA1FF]">→</span>
								</a>
							`,
						)
						.join("")}
				</div>

				<a
					href="/buscar?q=${encodeURIComponent(queryOriginal)}"
					class="block border-t border-white/10 px-6 py-4 text-sm font-bold text-[#4EA1FF] hover:bg-slate-900"
				>
					Ver todos los resultados →
				</a>
			`;

			suggestions.classList.remove("hidden");
		});

		document.addEventListener("click", (event) => {
			if (
				!suggestions.contains(event.target as Node) &&
				event.target !== input
			) {
				suggestions.classList.add("hidden");
			}
		});
	}
</script>

<Layout
	title="TodoSatcom"
	description="Portal especializado en internet satelital, hardware, cobertura, instalación y actualidad del sector."
>
	<main class="min-h-screen bg-slate-950">
		<section
			class="relative overflow-visible py-14 md:min-h-[760px] md:py-44"
		>
			<video
				class="absolute inset-0 h-full w-full object-cover"
				autoplay
				muted
				loop
				playsinline
				preload="metadata"
			>
				<source src="/videos/hero-satcom.mp4" type="video/mp4" />
			</video>

			<div
				class="absolute inset-0 bg-gradient-to-b from-slate-950/90 via-slate-950/50 via-60% to-slate-950/0"
			>
			</div>
			<div
				class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-slate-950 to-transparent"
			>
			</div>

			<Container>
				<div class="relative z-40 max-w-3xl">
					<h1
						class="font-body text-3xl font-semibold tracking-tight md:text-6xl"
						style="color:white;"
					>
						Tu referente en internet satelital y comunicaciones.
					</h1>

					<p class="mt-5 max-w-2xl text-lg leading-8 text-slate-200">
						Guías, manuales, operadores, hardware y actualidad sobre
						comunicaciones satelitales.
					</p>

					<form
						action="/buscar"
						method="get"
						class="relative z-50 mt-8 flex max-w-2xl items-center gap-2 rounded-full border border-white/15 bg-slate-950/55 p-2 shadow-2xl shadow-slate-950/40 backdrop-blur-md"
					>
						<div
							class="flex min-h-12 min-w-0 flex-1 items-center gap-3 rounded-full px-3 md:px-4"
						>
							<img
								src={searchIcon.src}
								alt=""
								aria-hidden="true"
								class="h-8 w-8 shrink-0 object-contain"
							/>

							<input
								type="search"
								name="q"
								autocomplete="off"
								spellcheck="false"
								placeholder="Buscar..."
								class="min-w-0 w-full appearance-none bg-transparent text-base text-white outline-none placeholder:text-slate-400"
							/>
						</div>

						<button
							type="submit"
							class="rounded-full bg-blue-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-blue-500 mr-2"
						>
							Buscar
						</button>
						<div
							id="hero-search-suggestions"
							class="absolute left-0 top-full z-50 mt-3 hidden w-full overflow-hidden rounded-2xl border border-white/10 bg-slate-950/95 shadow-2xl shadow-slate-950/60 backdrop-blur-md"
						>
						</div>
					</form>
					<script
						type="application/json"
						id="hero-search-data"
						set:html={JSON.stringify(datosBusqueda)}
					/>
				</div>
			</Container>
		</section>

		<section class="bg-slate-950">
			<Container>
				<HomeOperatorsSection marcas={marcasHome} />
				<SectionDivider />
				<HomeFeaturedSection destacados={destacados} />
				<SectionDivider />
				<HomeArticlesSection articulos={articulos} />
				<SectionDivider />
				<HomeModelsSection modelos={modelos} />
				<SectionDivider />
				<HomeManualsSection manuales={manuales} />
			</Container>
		</section>
	</main>
</Layout>
