---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import {
	getMarcasDestacadas,
	getArticulos,
	getDestacados,
	getModelos,
	getManuales,
} from "../lib/content";
import ArticleCard from "../components/ArticleCard.astro";
import BrandCard from "../components/BrandCard.astro";
import FeaturedCard from "../components/FeaturedCard.astro";
import ModelCard from "../components/ModelCard.astro";
import ManualCard from "../components/ManualCard.astro";
import HomeOperatorsSection from "../components/HomeOperatorsSection.astro";

const destacados = await getDestacados();
const marcasDestacadas = await getMarcasDestacadas();
const modelos = (await getModelos()).slice(0, 3);
const manuales = (await getManuales()).slice(0, 3);

const articulos = (await getArticulos())
	.sort(
		(a: any, b: any) =>
			new Date(b.fecha_publicacion).getTime() -
			new Date(a.fecha_publicacion).getTime(),
	)
	.slice(0, 3);
---

<Layout
	title="Todo-Sat"
	description="Portal especializado en internet satelital, hardware, cobertura, instalación y actualidad del sector."
>
	<main class="min-h-screen pb-20">
		<section
			class="relative overflow-hidden border-b border-brand-border py-14 md:py-20"
		>
			<video
				class="absolute inset-0 h-full w-full object-cover"
				autoplay
				muted
				loop
				playsinline
				preload="metadata"
			>
				<source src="/videos/hero-satcom.mp4" type="video/mp4" />
			</video>

			<div class="absolute inset-0 bg-slate-950/75"></div>

			<Container>
				<div class="relative z-10 max-w-3xl">
					<h1
						class="font-body text-3xl font-semibold tracking-tight md:text-5xl"
						style="color:white;"
					>
						Tu referente en internet satelital y comunicaciones.
					</h1>

					<p class="mt-5 max-w-2xl text-lg leading-8 text-slate-200">
						Guías, manuales, operadores, hardware y actualidad sobre
						comunicaciones satelitales.
					</p>

					<form
						action="/buscar"
						method="get"
						class="mt-8 flex max-w-lg flex-col gap-2 rounded-2xl border border-white/20 bg-white/90 p-2 shadow-lg backdrop-blur sm:flex-row"
					>
						<input
							type="search"
							name="q"
							placeholder="Buscar marcas, modelos, artículos o manuales..."
							class="min-h-11 w-full rounded-xl border border-transparent bg-white px-4 text-sm outline-none focus:border-info-primary"
						/>

						<button
							type="submit"
							class="rounded-xl bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-info-primary-dark"
						>
							Buscar
						</button>
					</form>
				</div>
			</Container>
		</section>

		<section class="bg-slate-950">
			<Container>
				<!-- {
				marcasDestacadas.length > 0 && (
					<section class="mt-16 overflow-hidden rounded-3xl border border-brand-border bg-white shadow-sm">
						<div class="h-1.5 bg-info-primary" />
						<div class="p-6 md:p-8">
							<div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
								<div>
									<p class="inline-flex rounded-full bg-info-primary px-3 py-1 text-xs font-bold uppercase tracking-[0.15em] text-white">
										Operadores
									</p>

									<h2 class="home-section-title mt-3 text-4xl font-black tracking-tight">
										Operadores y compañías satelitales
									</h2>

									<p class="mt-3 max-w-3xl text-base leading-7 text-brand-muted">
										Explora las principales empresas del
										ecosistema satelital: operadores de
										internet, constelaciones, proveedores de
										conectividad y compañías clave del
										sector.
									</p>
								</div>

								<a
									href="/marcas"
									class="inline-flex w-fit items-center gap-2 rounded-full border border-brand-border px-5 py-3 text-sm font-semibold transition hover:border-info-primary hover:text-info-primary"
								>
									Ver todas las marcas
									<span>→</span>
								</a>
							</div>
						</div>

						<div class="border-t border-brand-border bg-sky-50 p-6 md:p-8">
							<div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
								{marcasDestacadas.map((marca: any) => (
									<BrandCard marca={marca} />
								))}
							</div>
						</div>
					</section>
				)
			} -->
				<HomeOperatorsSection />
				{
					destacados.length > 0 && (
						<section class="mt-16 overflow-hidden rounded-3xl border border-brand-border bg-white shadow-sm">
							<div class="h-1.5 bg-info-primary" />

							<div class="p-6 md:p-8">
								<p class="inline-flex rounded-full bg-info-primary px-3 py-1 text-xs font-bold uppercase tracking-[0.15em] text-white">
									Selección editorial
								</p>

								<h2 class="home-section-title mt-3 text-4xl font-black tracking-tight">
									Selección destacada
								</h2>

								<p class="mt-3 max-w-3xl text-base leading-7 text-brand-muted">
									Accede rápidamente a contenidos relevantes
									del portal: marcas, modelos, artículos y
									manuales seleccionados por su utilidad
									dentro del ecosistema satelital.
								</p>
							</div>

							<div class="border-t border-brand-border bg-sky-50/40 p-6 md:p-8">
								<div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
									{destacados.map((destacado: any) => (
										<FeaturedCard destacado={destacado} />
									))}
								</div>
							</div>
						</section>
					)
				}

				<section
					class="mt-16 overflow-hidden rounded-3xl border border-brand-border bg-white shadow-sm"
				>
					<div class="h-1.5 bg-info-primary"></div>

					<div class="p-6 md:p-8">
						<div
							class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between"
						>
							<div>
								<p
									class="inline-flex rounded-full bg-info-primary px-3 py-1 text-xs font-bold uppercase tracking-[0.15em] text-white"
								>
									Actualidad y guías
								</p>

								<h2
									class="home-section-title mt-3 text-4xl font-black tracking-tight"
								>
									Guías y actualidad satelital
								</h2>

								<p
									class="mt-3 max-w-3xl text-base leading-7 text-brand-muted"
								>
									Lee guías, análisis, comparativas y noticias
									sobre internet satelital, instalación,
									cobertura, operadores, hardware y evolución
									del sector.
								</p>
							</div>

							<a
								href="/articulos"
								class="inline-flex w-fit items-center gap-2 rounded-full border border-brand-border px-5 py-3 text-sm font-semibold transition hover:border-info-primary hover:text-info-primary"
							>
								Ver todos los artículos
								<span>→</span>
							</a>
						</div>
					</div>

					<div
						class="border-t border-brand-border bg-sky-50/40 p-6 md:p-8"
					>
						<div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
							{
								articulos.map((articulo: any) => (
									<ArticleCard articulo={articulo} />
								))
							}
						</div>
					</div>
				</section>

				{
					modelos.length > 0 && (
						<section class="mt-16 overflow-hidden rounded-3xl border border-brand-border bg-white shadow-sm">
							<div class="h-1.5 bg-info-primary" />

							<div class="p-6 md:p-8">
								<div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
									<div>
										<p class="inline-flex rounded-full bg-info-primary px-3 py-1 text-xs font-bold uppercase tracking-[0.15em] text-white">
											Hardware
										</p>

										<h2 class="home-section-title mt-3 text-4xl font-black tracking-tight">
											Equipos y terminales satelitales
										</h2>

										<p class="mt-3 max-w-3xl text-base leading-7 text-brand-muted">
											Consulta modelos de antenas,
											routers, kits de instalación y
											terminales utilizados para acceder a
											servicios de conectividad satelital.
										</p>
									</div>

									<a
										href="/modelos"
										class="inline-flex w-fit items-center gap-2 rounded-full border border-brand-border px-5 py-3 text-sm font-semibold transition hover:border-info-primary hover:text-info-primary"
									>
										Ver todos los modelos
										<span>→</span>
									</a>
								</div>
							</div>

							<div class="border-t border-brand-border bg-sky-50/40 p-6 md:p-8">
								<div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
									{modelos.map((modelo: any) => (
										<ModelCard modelo={modelo} />
									))}
								</div>
							</div>
						</section>
					)
				}
				{
					manuales.length > 0 && (
						<section class="mt-16 overflow-hidden rounded-3xl border border-brand-border bg-white shadow-sm">
							<div class="h-1.5 bg-info-primary" />

							<div class="p-6 md:p-8">
								<div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
									<div>
										<p class="inline-flex rounded-full bg-info-primary px-3 py-1 text-xs font-bold uppercase tracking-[0.15em] text-white">
											Documentación
										</p>

										<h2 class="home-section-title mt-3 text-4xl font-black tracking-tight">
											Manuales y documentación técnica
										</h2>

										<p class="mt-3 max-w-3xl text-base leading-7 text-brand-muted">
											Encuentra manuales de usuario,
											documentos técnicos, guías de
											instalación y recursos prácticos
											para configurar y entender equipos
											satelitales.
										</p>
									</div>

									<a
										href="/manuales"
										class="inline-flex w-fit items-center gap-2 rounded-full border border-brand-border px-5 py-3 text-sm font-semibold transition hover:border-info-primary hover:text-info-primary"
									>
										Ver todos los manuales
										<span>→</span>
									</a>
								</div>
							</div>

							<div class="border-t border-brand-border bg-sky-50/40 p-6 md:p-8">
								<div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
									{manuales.map((manual: any) => (
										<ManualCard manual={manual} />
									))}
								</div>
							</div>
						</section>
					)
				}
			</Container>
		</section>
	</main>
</Layout>
