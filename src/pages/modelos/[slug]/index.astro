---
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/Container.astro";
import { getModelos, getArticulos, getManuales } from "../../../lib/content";
import { renderBlocks } from "../../../lib/renderBlocks";
import { getMediaUrl } from "../../../lib/media";
import RelatedCard from "../../../components/RelatedCard.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { formatLabel } from "../../../lib/format";

export async function getStaticPaths() {
    const modelos = await getModelos();

    return modelos.map((modelo: any) => ({
        params: {
            slug: modelo.slug,
        },
        props: {
            modelo,
        },
    }));
}

const { modelo } = Astro.props as any;

const contenidoHTML = renderBlocks(modelo.descripcion_completa);
const imagenUrl = getMediaUrl(modelo.imagen_principal);
const galeria = modelo.galeria || [];

const articulos = (await getArticulos()).filter((articulo: any) =>
    articulo.modelos?.some(
        (modeloRelacionado: any) => modeloRelacionado.slug === modelo.slug,
    ),
);

const manuales = (await getManuales()).filter((manual: any) =>
    manual.modelos?.some(
        (modeloRelacionado: any) => modeloRelacionado.slug === modelo.slug,
    ),
);

const specs = [
    modelo.ano_lanzamiento && {
        label: "Año",
        value: modelo.ano_lanzamiento,
    },
    modelo.velocidad_descarga && {
        label: "Descarga",
        value: `${modelo.velocidad_descarga} Mbps`,
    },
    modelo.velocidad_subida && {
        label: "Subida",
        value: `${modelo.velocidad_subida} Mbps`,
    },
    modelo.latencia && {
        label: "Latencia",
        value: `${modelo.latencia} ms`,
    },
    modelo.consumo && {
        label: "Consumo",
        value: modelo.consumo,
    },
    modelo.uso_recomendado && {
        label: "Uso recomendado",
        value: modelo.uso_recomendado,
    },
    modelo.precio_orientativo && {
        label: "Precio orientativo",
        value: `${modelo.precio_orientativo} €`,
    },
    modelo.portatil !== null &&
        modelo.portatil !== undefined && {
            label: "Portátil",
            value: modelo.portatil ? "Sí" : "No",
        },
].filter(Boolean);
---

<Layout
    title={`${modelo.nombre} | Todo-Sat`}
    description={modelo.descripcion_corta}
>
    <main class="min-h-screen py-10">
        <Container>
            <Breadcrumbs
                items={[
                    {
                        label: "Modelos",
                        href: "/modelos",
                    },
                    {
                        label: modelo.nombre,
                    },
                ]}
            />

            <section
                class="mt-8 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center"
            >
                <div>
                    <a
                        href="/modelos"
                        class="text-sm font-semibold text-info-primary hover:text-info-primary-dark"
                    >
                        ← Volver a modelos
                    </a>

                    {
                        modelo.marca && (
                            <a
                                href={`/marcas/${modelo.marca.slug}`}
                                class="mt-8 inline-flex rounded-full bg-info-primary-soft px-4 py-2 text-sm font-semibold text-info-primary-dark hover:bg-sky-200"
                            >
                                {modelo.marca.nombre}
                            </a>
                        )
                    }

                    <h1 class="mt-6 max-w-4xl">
                        {modelo.nombre}
                    </h1>

                    {
                        modelo.descripcion_corta && (
                            <p class="mt-6 max-w-2xl text-xl leading-8 text-brand-muted">
                                {modelo.descripcion_corta}
                            </p>
                        )
                    }
                </div>

                {
                    imagenUrl && (
                        <div class="overflow-hidden rounded-3xl border border-brand-border bg-white shadow-sm">
                            <img
                                src={imagenUrl}
                                alt={modelo.nombre}
                                class="h-full max-h-[460px] w-full object-cover"
                            />
                        </div>
                    )
                }
            </section>

            {
                specs.length > 0 && (
                    <section class="mt-16 rounded-3xl border border-brand-border bg-white p-6 shadow-sm md:p-8">
                        <h2 class="mb-6 text-3xl">Ficha técnica</h2>

                        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                            {specs.map((spec: any) => (
                                <div class="rounded-2xl bg-brand-soft p-4">
                                    <p class="text-xs font-semibold uppercase tracking-wider text-brand-muted">
                                        {spec.label}
                                    </p>
                                    <p class="mt-2 text-lg font-semibold text-brand-base">
                                        {spec.value}
                                    </p>
                                </div>
                            ))}
                        </div>
                    </section>
                )
            }

            {
                contenidoHTML && (
                    <section class="mt-16 border-t border-brand-border pt-12">
                        <div
                            class="prose prose-lg max-w-none"
                            set:html={contenidoHTML}
                        />
                    </section>
                )
            }

            {
                galeria.length > 0 && (
                    <section class="mt-16 border-t border-brand-border pt-12">
                        <h2 class="mb-6">Galería</h2>

                        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
                            {galeria.map((imagen: any) => {
                                const url = getMediaUrl(imagen);

                                return url ? (
                                    <div class="overflow-hidden rounded-2xl border border-brand-border bg-white shadow-sm">
                                        <img
                                            src={url}
                                            alt={modelo.nombre}
                                            class="h-64 w-full object-cover"
                                        />
                                    </div>
                                ) : null;
                            })}
                        </div>
                    </section>
                )
            }

            <section class="mt-16 border-t border-brand-border pt-12">
                <h2 class="mb-6">Artículos relacionados</h2>

                {
                    articulos.length > 0 ? (
                        <div class="grid gap-5 md:grid-cols-2">
                            {articulos.map((articulo: any) => (
                                <RelatedCard
                                    type="Artículo"
                                    title={articulo.titulo}
                                    description={articulo.subtitulo}
                                    meta={formatLabel(articulo.tipo_articulo)}
                                    url={`/articulos/${articulo.slug}`}
                                    image={articulo.imagen_principal}
                                />
                            ))}
                        </div>
                    ) : (
                        <p class="text-brand-muted">
                            Todavía no hay artículos relacionados con este
                            modelo.
                        </p>
                    )
                }
            </section>

            <section class="mt-16 border-t border-brand-border pt-12">
                <h2 class="mb-6">Manuales relacionados</h2>

                {
                    manuales.length > 0 ? (
                        <div class="grid gap-5 md:grid-cols-2">
                            {manuales.map((manual: any) => (
                                <RelatedCard
                                    type="Manual"
                                    title={manual.titulo}
                                    description={manual.descripcion}
                                    meta={`${manual.ano_publicacion ?? ""}${manual.idioma ? ` · ${formatLabel(manual.idioma)}` : ""}`}
                                    url={`/manuales/${manual.slug}`}
                                    image={manual.imagen_portada}
                                />
                            ))}
                        </div>
                    ) : (
                        <p class="text-brand-muted">
                            Todavía no hay manuales relacionados con este
                            modelo.
                        </p>
                    )
                }
            </section>
        </Container>
    </main>
</Layout>
