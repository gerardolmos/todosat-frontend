---
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/Container.astro";
import { getModelos, getArticulos, getManuales } from "../../../lib/content";
import { renderBlocks } from "../../../lib/renderBlocks";
import { getMediaUrl } from "../../../lib/media";
import RelatedCard from "../../../components/RelatedCard.astro";

export async function getStaticPaths() {
    const modelos = await getModelos();

    return modelos.map((modelo: any) => ({
        params: {
            slug: modelo.slug,
        },
        props: {
            modelo,
        },
    }));
}

const { modelo } = Astro.props as any;

const contenidoHTML = renderBlocks(modelo.descripcion_completa);

const imagenUrl = getMediaUrl(modelo.imagen_principal);

const galeria = modelo.galeria || [];

const articulos = (await getArticulos()).filter((articulo: any) =>
    articulo.modelos?.some(
        (modeloRelacionado: any) => modeloRelacionado.slug === modelo.slug,
    ),
);

const manuales = (await getManuales()).filter((manual: any) =>
    manual.modelos?.some(
        (modeloRelacionado: any) => modeloRelacionado.slug === modelo.slug,
    ),
);
---

<Layout title={`${modelo.nombre} | TODOSat`}>
    <main class="min-h-screen py-10">
        <Container>
            <a href="/modelos" class="text-blue-600 underline">
                ← Volver a modelos
            </a>

            <h1 class="mt-6 text-5xl font-bold">
                {modelo.nombre}
            </h1>

            <p class="mt-4 text-xl text-gray-600">
                {modelo.descripcion_corta}
            </p>

            {
                imagenUrl && (
                    <img
                        src={imagenUrl}
                        alt={modelo.nombre}
                        class="mt-8 w-full max-w-4xl rounded"
                    />
                )
            }

            <div class="mt-10 grid gap-4">
                {
                    modelo.marca && (
                        <p>
                            <strong>Marca:</strong>{" "}
                            <a
                                href={`/marcas/${modelo.marca.slug}`}
                                class="text-blue-600 underline"
                            >
                                {modelo.marca.nombre}
                            </a>
                        </p>
                    )
                }

                <p>
                    <strong>Año:</strong>
                    {modelo.ano_lanzamiento}
                </p>

                <p>
                    <strong>Velocidad descarga:</strong>
                    {modelo.velocidad_descarga} Mbps
                </p>

                <p>
                    <strong>Velocidad subida:</strong>
                    {modelo.velocidad_subida} Mbps
                </p>

                <p>
                    <strong>Latencia:</strong>
                    {modelo.latencia} ms
                </p>

                <p>
                    <strong>Consumo:</strong>
                    {modelo.consumo}
                </p>

                <p>
                    <strong>Uso recomendado:</strong>
                    {modelo.uso_recomendado}
                </p>

                <p>
                    <strong>Precio orientativo:</strong>
                    {modelo.precio_orientativo} €
                </p>

                <p>
                    <strong>Portátil:</strong>
                    {modelo.portatil ? "Sí" : "No"}
                </p>
            </div>

            <section
                class="mt-10 prose prose-lg max-w-none"
                set:html={contenidoHTML}
            />
            {
                galeria.length > 0 && (
                    <section class="mt-12">
                        <h2 class="mb-6 text-3xl font-bold">Galería</h2>

                        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                            {galeria.map((imagen: any) => {
                                const url = getMediaUrl(imagen);

                                return url ? (
                                    <img
                                        src={url}
                                        alt={modelo.nombre}
                                        class="w-full rounded"
                                    />
                                ) : null;
                            })}
                        </div>
                    </section>
                )
            }

            <section class="mt-12">
                <h2 class="mb-6 text-3xl font-bold">Artículos relacionados</h2>

                {
                    articulos.length > 0 ? (
                        <div class="grid gap-4 md:grid-cols-2">
                            {articulos.map((articulo: any) => (
                                <RelatedCard
                                    type="Artículo"
                                    title={articulo.titulo}
                                    description={articulo.subtitulo}
                                    url={`/articulos/${articulo.slug}`}
                                    image={articulo.imagen_principal}
                                />
                            ))}
                        </div>
                    ) : (
                        <p class="text-gray-600">
                            Todavía no hay artículos relacionados con este
                            modelo.
                        </p>
                    )
                }
            </section>

            <section class="mt-12">
                <h2 class="mb-6 text-3xl font-bold">Manuales relacionados</h2>

                {
                    manuales.length > 0 ? (
                        <div class="grid gap-4 md:grid-cols-2">
                            {manuales.map((manual: any) => (
                                <RelatedCard
                                    type="Manual"
                                    title={manual.titulo}
                                    description={manual.descripcion}
                                    url={`/manuales/${manual.slug}`}
                                    image={manual.imagen_portada}
                                />
                            ))}
                        </div>
                    ) : (
                        <p class="text-gray-600">
                            Todavía no hay manuales relacionados con este
                            modelo.
                        </p>
                    )
                }
            </section>
        </Container>
    </main>
</Layout>
