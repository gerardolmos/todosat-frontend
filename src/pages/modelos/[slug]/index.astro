---
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/Container.astro";
import { getModelos, getArticulos, getManuales } from "../../../lib/content";
import { renderBlocks } from "../../../lib/renderBlocks";
import { getMediaUrl } from "../../../lib/media";
import RelatedCard from "../../../components/RelatedCard.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { formatLabel } from "../../../lib/format";

export async function getStaticPaths() {
    const modelos = await getModelos();

    return modelos.map((modelo: any) => ({
        params: {
            slug: modelo.slug,
        },
        props: {
            modelo,
        },
    }));
}

const { modelo } = Astro.props as any;

const contenidoHTML = renderBlocks(modelo.descripcion_completa);
const imagenUrl = getMediaUrl(modelo.imagen_principal);
const galeria = modelo.galeria || [];

const articulos = (await getArticulos()).filter((articulo: any) =>
    articulo.modelos?.some(
        (modeloRelacionado: any) => modeloRelacionado.slug === modelo.slug,
    ),
);

const manuales = (await getManuales()).filter((manual: any) =>
    manual.modelos?.some(
        (modeloRelacionado: any) => modeloRelacionado.slug === modelo.slug,
    ),
);

const specs = [
    modelo.tipo_hardware && {
        label: "Tipo",
        value: modelo.tipo_hardware,
    },
    modelo.ano_lanzamiento && {
        label: "Año",
        value: modelo.ano_lanzamiento,
    },
    modelo.velocidad_descarga && {
        label: "Descarga",
        value: `${modelo.velocidad_descarga} Mbps`,
    },
    modelo.velocidad_subida && {
        label: "Subida",
        value: `${modelo.velocidad_subida} Mbps`,
    },
    modelo.latencia && {
        label: "Latencia",
        value: `${modelo.latencia} ms`,
    },
    modelo.consumo && {
        label: "Consumo",
        value: modelo.consumo,
    },
    modelo.uso_recomendado && {
        label: "Uso recomendado",
        value: modelo.uso_recomendado,
    },
    modelo.precio_orientativo && {
        label: "Precio orientativo",
        value: `${modelo.precio_orientativo} €`,
    },
    modelo.portatil !== null &&
        modelo.portatil !== undefined && {
            label: "Portátil",
            value: modelo.portatil ? "Sí" : "No",
        },
].filter(Boolean);
---

<Layout
    title={`${modelo.nombre} | Todo-Sat`}
    description={modelo.descripcion_corta}
>
    <main class="min-h-screen bg-slate-950 py-10 text-white">
        <Container>
            <Breadcrumbs
                items={[
                    { label: "Hardware", href: "/modelos" },
                    { label: modelo.nombre },
                ]}
            />

            <section
                class="relative mt-8 overflow-hidden rounded-3xl bg-slate-950 p-8 shadow-2xl md:p-10"
            >
                <div
                    class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(0,94,255,0.24),transparent_35%),radial-gradient(circle_at_bottom_left,rgba(78,161,255,0.13),transparent_32%)]"
                >
                </div>

                <div
                    class="relative grid gap-10 lg:grid-cols-[1fr_0.95fr] lg:items-center"
                >
                    <div>
                        <a
                            href="/modelos"
                            class="text-sm font-semibold text-blue-400 hover:text-white mr-4"
                        >
                            ← Volver a hardware
                        </a>

                        {
                            modelo.marca && (
                                <a
                                    href={`/operadores/${modelo.marca.slug}`}
                                    class="mt-8 inline-flex rounded-full border border-blue-500/40 bg-blue-500/10 px-4 py-2 text-sm font-bold text-blue-300 hover:border-blue-400"
                                >
                                    {modelo.marca.nombre}
                                </a>
                            )
                        }

                        <h1
                            class="mt-6 max-w-4xl text-3xl font-bold leading-tight tracking-tight !text-white md:text-5xl"
                        >
                            {modelo.nombre}
                        </h1>

                        {
                            modelo.descripcion_corta && (
                                <p class="mt-5 max-w-2xl text-base leading-7 text-slate-300 md:text-lg md:leading-8">
                                    {modelo.descripcion_corta}
                                </p>
                            )
                        }
                        <div
                            class="mt-8 h-px w-32 bg-gradient-to-r from-[#00ccff] to-transparent"
                        >
                        </div>
                    </div>

                    {
                        imagenUrl && (
                            <div class="overflow-hidden rounded-3xl bg-slate-900 shadow-2xl">
                                <img
                                    src={imagenUrl}
                                    alt={modelo.nombre}
                                    class="h-[320px] w-full object-contain md:h-[500px]"
                                />
                            </div>
                        )
                    }
                </div>
            </section>

            {
                specs.length > 0 && (
                    <section class="mt-12 md:p-2">
                        <h2 class="mb-6 text-3xl font-bold !text-white">
                            Ficha técnica
                        </h2>

                        <div class="grid gap-x-12 gap-y-0 md:grid-cols-2 xl:grid-cols-3">
                            {specs.map((spec: any, index: number) => (
                                <div
                                    class={`py-5 ${
                                        index < specs.length - 3
                                            ? "border-b border-white/10"
                                            : ""
                                    }`}
                                >
                                    <p class="text-xs font-semibold uppercase tracking-wider text-blue-300">
                                        {spec.label}
                                    </p>

                                    <p class="mt-2 text-lg font-semibold leading-snug text-white">
                                        {spec.value}
                                    </p>
                                </div>
                            ))}
                        </div>
                    </section>
                )
            }

            {
                contenidoHTML && (
                    <section class="mt-16 border-t border-white/10 pt-12">
                        <div
                            class="prose prose-invert prose-lg max-w-none prose-headings:text-white prose-p:text-slate-300 prose-a:text-blue-400"
                            set:html={contenidoHTML}
                        />
                    </section>
                )
            }

            {
                galeria.length > 0 && (
                    <section class="mt-16 border-t border-white/10 pt-12">
                        <h2 class="mb-6 text-3xl font-bold !text-white">
                            Galería
                        </h2>

                        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
                            {galeria.map((imagen: any) => {
                                const url = getMediaUrl(imagen);

                                return url ? (
                                    <div class="overflow-hidden rounded-2xl border border-white/10 bg-slate-900 shadow-sm">
                                        <img
                                            src={url}
                                            alt={modelo.nombre}
                                            class="h-64 w-full object-cover"
                                        />
                                    </div>
                                ) : null;
                            })}
                        </div>
                    </section>
                )
            }

            <section class="mt-16 border-t border-white/10 pt-12">
                <h2 class="mb-6 text-3xl font-bold !text-white">
                    Artículos relacionados
                </h2>

                {
                    articulos.length > 0 ? (
                        <div class="grid gap-x-10 gap-y-2 md:grid-cols-2">
                            {articulos.map((articulo: any) => (
                                <RelatedCard
                                    type="Artículo"
                                    title={articulo.titulo}
                                    description={articulo.subtitulo}
                                    meta={articulo.categoria_tematica?.nombre}
                                    url={`/articulos/${articulo.slug}`}
                                    image={articulo.imagen_principal}
                                />
                            ))}
                        </div>
                    ) : (
                        <p class="text-slate-400">
                            Todavía no hay artículos relacionados con este
                            modelo.
                        </p>
                    )
                }
            </section>

            <section class="mt-16 border-t border-white/10 pt-12">
                <h2 class="mb-6 text-3xl font-bold !text-white">
                    Manuales relacionados
                </h2>

                {
                    manuales.length > 0 ? (
                        <div class="grid gap-x-10 gap-y-2 md:grid-cols-2">
                            {manuales.map((manual: any) => (
                                <RelatedCard
                                    type="Manual"
                                    title={manual.titulo}
                                    description={manual.descripcion}
                                    meta={`${manual.ano_publicacion ?? ""}${manual.idioma ? ` · ${formatLabel(manual.idioma)}` : ""}`}
                                    url={`/manuales/${manual.slug}`}
                                    image={manual.imagen_portada}
                                />
                            ))}
                        </div>
                    ) : (
                        <p class="text-slate-400">
                            Todavía no hay manuales relacionados con este
                            modelo.
                        </p>
                    )
                }
            </section>
        </Container>
    </main>
</Layout>
