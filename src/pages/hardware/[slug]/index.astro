---
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/Container.astro";
import { getHardwares, getNoticias, getManuales } from "../../../lib/content";
import { renderBlocks } from "../../../lib/renderBlocks";
import { getMediaUrl } from "../../../lib/media";
import RelatedCard from "../../../components/RelatedCard.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { formatLabel } from "../../../lib/format";

export async function getStaticPaths() {
    const modelos = await getHardwares();

    return modelos.map((modelo: any) => ({
        params: {
            slug: modelo.slug,
        },
        props: {
            modelo,
        },
    }));
}

const { modelo } = Astro.props as any;

const contenidoHTML = renderBlocks(modelo.descripcion_completa);
const imagenUrl = getMediaUrl(modelo.imagen_principal);
const galeria = modelo.galeria || [];

const articulos = (await getNoticias()).filter((articulo: any) =>
    articulo.hardwares?.some(
        (modeloRelacionado: any) => modeloRelacionado.slug === modelo.slug,
    ),
);

const manuales = (await getManuales()).filter((manual: any) =>
    manual.hardwares?.some(
        (modeloRelacionado: any) => modeloRelacionado.slug === modelo.slug,
    ),
);

const specs = [
    modelo.tipo_hardware && {
        label: "Tipo",
        value: modelo.tipo_hardware,
    },
    modelo.ano_lanzamiento && {
        label: "Año",
        value: modelo.ano_lanzamiento,
    },
    modelo.velocidad_descarga && {
        label: "Descarga",
        value: `${modelo.velocidad_descarga} Mbps`,
    },
    modelo.velocidad_subida && {
        label: "Subida",
        value: `${modelo.velocidad_subida} Mbps`,
    },
    modelo.latencia && {
        label: "Latencia",
        value: `${modelo.latencia} ms`,
    },
    modelo.consumo && {
        label: "Consumo",
        value: modelo.consumo,
    },
    modelo.uso_recomendado && {
        label: "Uso recomendado",
        value: modelo.uso_recomendado,
    },
    modelo.precio_orientativo && {
        label: "Precio orientativo",
        value: `${modelo.precio_orientativo} €`,
    },
    modelo.portatil !== null &&
        modelo.portatil !== undefined && {
            label: "Portátil",
            value: modelo.portatil ? "Sí" : "No",
        },
].filter(Boolean);

const hasAside =
    Boolean(modelo.operador) || articulos.length > 0 || manuales.length > 0;
---

<Layout
    title={`${modelo.nombre} | TodoSatcom`}
    description={modelo.descripcion_corta}
>
    <main class="min-h-screen bg-slate-950 text-white">
        <section class="bg-slate-950 py-8 md:py-12">
            <Container>
                <Breadcrumbs
                    items={[
                        { label: "Hardware", href: "/hardware" },
                        { label: modelo.nombre },
                    ]}
                />

                <article class="mt-8">
                    <a
                        href="/hardware"
                        class="inline-flex text-sm font-semibold text-blue-400 transition hover:text-white"
                    >
                        ← Volver a hardware
                    </a>

                    <header class="mt-8 max-w-5xl pb-10 md:pb-14">
                        <div class="flex flex-wrap gap-3">
                            {
                                modelo.operador && (
                                    <a
                                        href={`/operadores/${modelo.operador.slug}`}
                                        class="rounded-full border border-blue-500/50 bg-blue-500/10 px-3 py-1.5 text-xs font-semibold text-blue-300 transition hover:border-[#005EFF] hover:text-white md:px-4 md:py-2 md:text-sm"
                                    >
                                        {modelo.operador.nombre}
                                    </a>
                                )
                            }

                            {
                                modelo.tipo_hardware && (
                                    <span class="rounded-full border border-white/10 bg-slate-900 px-3 py-1.5 text-xs font-semibold text-slate-300 md:px-4 md:py-2 md:text-sm">
                                        {modelo.tipo_hardware}
                                    </span>
                                )
                            }

                            {
                                modelo.uso_recomendado && (
                                    <span class="rounded-full border border-white/10 bg-slate-900 px-3 py-1.5 text-xs font-semibold text-slate-300 md:px-4 md:py-2 md:text-sm">
                                        {modelo.uso_recomendado}
                                    </span>
                                )
                            }
                        </div>

                        <h1
                            class="mt-6 max-w-5xl text-4xl font-bold leading-tight tracking-tight !text-white md:mt-8 md:text-6xl"
                        >
                            {modelo.nombre}
                        </h1>

                        {
                            modelo.descripcion_corta && (
                                <p class="mt-6 max-w-3xl border-l-2 border-[#00ccff]/60 pl-5 text-lg leading-8 text-slate-300 md:text-2xl md:leading-9">
                                    {modelo.descripcion_corta}
                                </p>
                            )
                        }
                    </header>
                </article>
            </Container>
        </section>

        <section class="bg-slate-100 py-10 text-slate-950 md:py-14">
            <Container>
                <div
                    class={`grid gap-10 ${
                        hasAside
                            ? "lg:grid-cols-[minmax(0,1fr)_340px]"
                            : "lg:grid-cols-[minmax(0,1fr)]"
                    }`}
                >
                    <article
                        class="overflow-hidden rounded-3xl bg-white shadow-xl shadow-slate-950/10"
                    >
                        {
                            imagenUrl && (
                                <div class="border-b border-slate-200 bg-slate-950">
                                    <img
                                        src={imagenUrl}
                                        alt={modelo.nombre}
                                        class="h-[280px] w-full object-contain md:h-[520px]"
                                    />
                                </div>
                            )
                        }

                        {
                            specs.length > 0 && (
                                <section class="border-b border-slate-200 px-6 py-8 md:px-10 md:py-10">
                                    <h2 class="text-2xl font-bold tracking-tight text-slate-950 md:text-3xl">
                                        Ficha técnica
                                    </h2>

                                    <div class="mt-8 grid gap-x-10 gap-y-0 md:grid-cols-2 xl:grid-cols-3">
                                        {specs.map(
                                            (spec: any, index: number) => (
                                                <div
                                                    class={`py-5 ${
                                                        index < specs.length - 3
                                                            ? "border-b border-slate-200"
                                                            : ""
                                                    }`}
                                                >
                                                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-600">
                                                        {spec.label}
                                                    </p>

                                                    <p class="mt-2 text-lg font-semibold leading-snug text-slate-950">
                                                        {spec.value}
                                                    </p>
                                                </div>
                                            ),
                                        )}
                                    </div>
                                </section>
                            )
                        }

                        {
                            contenidoHTML && (
                                <section class="px-6 py-8 md:px-10 md:py-12">
                                    <div
                                        class="prose prose-slate max-w-none prose-headings:text-slate-950 prose-p:text-slate-700 prose-a:text-blue-600 prose-strong:text-slate-950 prose-li:text-slate-700 md:[&_p]:text-[1.08rem] md:[&_p]:leading-8 md:[&_li]:text-[1.08rem] md:[&_li]:leading-8"
                                        set:html={contenidoHTML}
                                    />
                                </section>
                            )
                        }

                        {
                            galeria.length > 0 && (
                                <section class="border-t border-slate-200 px-6 py-8 md:px-10 md:py-12">
                                    <h2 class="text-2xl font-bold tracking-tight text-slate-950 md:text-3xl">
                                        Galería
                                    </h2>

                                    <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
                                        {galeria.map((imagen: any) => {
                                            const url = getMediaUrl(imagen);

                                            return url ? (
                                                <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-sm">
                                                    <img
                                                        src={url}
                                                        alt={modelo.nombre}
                                                        class="h-64 w-full object-cover"
                                                    />
                                                </div>
                                            ) : null;
                                        })}
                                    </div>
                                </section>
                            )
                        }
                    </article>

                    {
                        hasAside && (
                            <aside class="lg:sticky lg:top-28 lg:self-start">
                                <div class="overflow-hidden rounded-3xl border border-white/10 bg-slate-950 text-white shadow-2xl">
                                    <div class="border-b border-white/10 p-6">
                                        <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-400">
                                            Relacionado
                                        </p>

                                        <h2 class="mt-3 text-2xl font-bold text-white">
                                            Sobre este hardware
                                        </h2>
                                    </div>

                                    <div class="space-y-8 p-6">
                                        {modelo.operador && (
                                            <section>
                                                <h3 class="mb-4 border-l-2 border-blue-500 pl-3 text-sm font-bold uppercase tracking-[0.16em] text-slate-300">
                                                    Operador
                                                </h3>

                                                <RelatedCard
                                                    type="Operador"
                                                    title={modelo.operador.nombre}
                                                    description={
                                                        modelo.operador
                                                            .descripcion_corta
                                                    }
                                                    url={`/operadores/${modelo.operador.slug}`}
                                                    image={
                                                        modelo.operador
                                                            .imagen_portada
                                                    }
                                                />
                                            </section>
                                        )}

                                        {articulos.length > 0 && (
                                            <section>
                                                <h3 class="mb-4 border-l-2 border-blue-500 pl-3 text-sm font-bold uppercase tracking-[0.16em] text-slate-300">
                                                    Artículos
                                                </h3>

                                                <div class="grid gap-4">
                                                    {articulos.map(
                                                        (articulo: any) => (
                                                            <RelatedCard
                                                                type="Artículo"
                                                                title={
                                                                    articulo.titulo
                                                                }
                                                                description={
                                                                    articulo.subtitulo
                                                                }
                                                                meta={
                                                                    articulo
                                                                        .categoria_noticia
                                                                        ?.nombre
                                                                }
                                                                url={`/noticias/${articulo.slug}`}
                                                                image={
                                                                    articulo.imagen_principal
                                                                }
                                                            />
                                                        ),
                                                    )}
                                                </div>
                                            </section>
                                        )}

                                        {manuales.length > 0 && (
                                            <section>
                                                <h3 class="mb-4 border-l-2 border-blue-500 pl-3 text-sm font-bold uppercase tracking-[0.16em] text-slate-300">
                                                    Manuales
                                                </h3>

                                                <div class="grid gap-4">
                                                    {manuales.map(
                                                        (manual: any) => (
                                                            <RelatedCard
                                                                type="Manual"
                                                                title={
                                                                    manual.titulo
                                                                }
                                                                description={
                                                                    manual.descripcion
                                                                }
                                                                meta={`${manual.ano_publicacion ?? ""}${manual.idioma ? ` · ${formatLabel(manual.idioma)}` : ""}`}
                                                                url={`/manuales/${manual.slug}`}
                                                                image={
                                                                    manual.imagen_portada
                                                                }
                                                            />
                                                        ),
                                                    )}
                                                </div>
                                            </section>
                                        )}
                                    </div>
                                </div>
                            </aside>
                        )
                    }
                </div>
            </Container>
        </section>
    </main>
</Layout>
