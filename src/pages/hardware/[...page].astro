---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import { getHardwares, getOperadores } from "../../lib/content";
import ModelCard from "../../components/ModelCard.astro";
import Pagination from "../../components/Pagination.astro";
import { toUrlSlug } from "../../lib/slug";

export async function getStaticPaths() {
    const PAGE_SIZE = 9;

    function createPage(data: any[], currentPage: number) {
        const totalPages = Math.ceil(data.length / PAGE_SIZE) || 1;
        const start = (currentPage - 1) * PAGE_SIZE;

        return {
            data: data.slice(start, start + PAGE_SIZE),
            currentPage,
            lastPage: totalPages,
        };
    }

    function createPaginatedPaths({
        modelosFiltrados,
        baseSegments,
        propsExtra,
    }: any) {
        const totalPages = Math.ceil(modelosFiltrados.length / PAGE_SIZE) || 1;
        const paths = [];

        for (let pageNumber = 1; pageNumber <= totalPages; pageNumber++) {
            paths.push({
                params: {
                    page:
                        pageNumber === 1
                            ? baseSegments.join("/")
                            : [...baseSegments, String(pageNumber)].join("/"),
                },
                props: {
                    page: createPage(modelosFiltrados, pageNumber),
                    ...propsExtra,
                },
            });
        }

        return paths;
    }

    const modelos = await getHardwares();
    const marcas = await getOperadores();

    const tiposHardware = Array.from(
        new Set(
            modelos.map((modelo: any) => modelo.tipo_hardware).filter(Boolean),
        ),
    ).sort();

    const paths: any[] = [];

    paths.push(
        ...createPaginatedPaths({
            modelosFiltrados: modelos,
            baseSegments: [],
            propsExtra: {
                marcas,
                tiposHardware,
                tipoActual: null,
                marcaActual: null,
            },
        }),
    );

    tiposHardware.forEach((tipo: any) => {
        const modelosTipo = modelos.filter(
            (modelo: any) => modelo.tipo_hardware === tipo,
        );

        paths.push(
            ...createPaginatedPaths({
                modelosFiltrados: modelosTipo,
                baseSegments: ["tipo", toUrlSlug(tipo)],
                propsExtra: {
                    marcas,
                    tiposHardware,
                    tipoActual: tipo,
                    marcaActual: null,
                },
            }),
        );
    });

    marcas.forEach((marca: any) => {
        const modelosMarca = modelos.filter(
            (modelo: any) => modelo.operador?.slug === marca.slug,
        );

        paths.push(
            ...createPaginatedPaths({
                modelosFiltrados: modelosMarca,
                baseSegments: ["operador", marca.slug],
                propsExtra: {
                    marcas,
                    tiposHardware,
                    tipoActual: null,
                    marcaActual: marca,
                },
            }),
        );

        tiposHardware.forEach((tipo: any) => {
            const modelosCombinados = modelos.filter(
                (modelo: any) =>
                    modelo.tipo_hardware === tipo &&
                    modelo.operador?.slug === marca.slug,
            );

            paths.push(
                ...createPaginatedPaths({
                    modelosFiltrados: modelosCombinados,
                    baseSegments: [
                        "tipo",
                        toUrlSlug(tipo),
                        "operador",
                        marca.slug,
                    ],
                    propsExtra: {
                        marcas,
                        tiposHardware,
                        tipoActual: tipo,
                        marcaActual: marca,
                    },
                }),
            );
        });
    });

    return paths;
}

const { page, marcas, tiposHardware, tipoActual, marcaActual } =
    Astro.props as any;

const currentPage = page.currentPage;
const pageSuffix = currentPage > 1 ? ` — Página ${currentPage}` : "";
const tipoSlug = tipoActual ? toUrlSlug(tipoActual) : null;

const sectionName =
    tipoActual && marcaActual
        ? `${tipoActual} de ${marcaActual.nombre}`
        : tipoActual
          ? `Hardware satelital: ${tipoActual}`
          : marcaActual
            ? `Hardware de ${marcaActual.nombre}`
            : "Hardware satelital";

const title = `${sectionName}${pageSuffix} | TodoSatcom`;

const descriptionBase =
    tipoActual && marcaActual
        ? `Consulta equipos de tipo ${tipoActual} relacionados con ${marcaActual.nombre}.`
        : tipoActual
          ? `Explora equipos de tipo ${tipoActual} para conectividad y comunicaciones satelitales.`
          : marcaActual
            ? `Consulta el hardware y los equipos satelitales relacionados con ${marcaActual.nombre}.`
            : "Explora terminales, antenas, routers y equipos para conectividad satelital en hogares, empresas, movilidad y entornos remotos.";

const description =
    currentPage > 1
        ? `${descriptionBase} Página ${currentPage}.`
        : descriptionBase;

const basePath =
    tipoActual && marcaActual
        ? `/hardware/tipo/${tipoSlug}/operador/${marcaActual.slug}`
        : tipoActual
          ? `/hardware/tipo/${tipoSlug}`
          : marcaActual
            ? `/hardware/operador/${marcaActual.slug}`
            : "/hardware";

const indexableBasePath =
    tipoActual && marcaActual
        ? `/hardware/operador/${marcaActual.slug}`
        : basePath;

const canonicalPath =
    tipoActual && marcaActual
        ? indexableBasePath
        : currentPage > 1
          ? `${basePath}/${currentPage}`
          : basePath;

const robots =
    tipoActual && marcaActual ? "noindex, follow" : "index, follow";
---

<Layout
    title={title}
    description={description}
    canonical={canonicalPath}
    robots={robots}
>
    <main class="min-h-screen bg-slate-950 py-10">
        <Container>
            <section
                class="relative mb-10 overflow-hidden rounded-3xl border border-white/10 bg-slate-950 px-6 py-10 shadow-2xl md:px-12 md:py-10"
            >
                <div
                    class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(0,94,255,0.26),transparent_35%),radial-gradient(circle_at_bottom_left,rgba(78,161,255,0.14),transparent_32%)]"
                >
                </div>
                <div
                    class="absolute inset-0 bg-[linear-gradient(120deg,transparent_0%,rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[length:48px_48px] opacity-20"
                >
                </div>
                <div
                    class="absolute -right-32 top-10 h-72 w-72 rounded-full border border-blue-400/20"
                >
                </div>
                <div
                    class="absolute -right-20 top-24 h-96 w-96 rounded-full border border-cyan-400/10"
                >
                </div>

                <div class="relative max-w-4xl">
                    <p
                        class="inline-flex rounded-full border border-blue-500/40 bg-blue-500/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.2em] text-blue-400"
                    >
                        Equipamiento satelital
                    </p>

                    <h1
                        class="mt-6 max-w-3xl text-3xl font-bold leading-tight tracking-tight !text-white md:text-6xl"
                    >
                        {sectionName}
                    </h1>

                    <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
                        {descriptionBase}
                    </p>

                    <div class="mt-8 flex flex-wrap gap-3">
                        <span
                            class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-slate-200"
                        >
                            Terminales
                        </span>
                        <span
                            class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-slate-200"
                        >
                            Antenas
                        </span>
                        <span
                            class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-slate-200"
                        >
                            Routers
                        </span>
                        <span
                            class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-slate-200"
                        >
                            Kits
                        </span>
                    </div>
                </div>
            </section>

            <div class="items-start gap-10 lg:grid lg:grid-cols-[260px_1fr]">
                <div class="mb-8 grid gap-4 lg:hidden">
                    <label class="block">
                        <span
                            class="mb-2 block text-xs font-bold uppercase tracking-[0.2em] text-blue-400"
                        >
                            Tipo de hardware
                        </span>

                        <div class="relative">
                            <select
                                class="appearance-none w-full rounded border border-white/10 bg-slate-950 px-4 py-3 text-sm font-semibold text-slate-200 outline-none"
                                onchange="window.location.href = this.value"
                            >
                                <option
                                    value={marcaActual
                                        ? `/hardware/operador/${marcaActual.slug}`
                                        : "/hardware"}
                                    selected={!tipoActual}
                                >
                                    Todos
                                </option>

                                {
                                    tiposHardware.map((tipo: any) => (
                                        <option
                                            value={
                                                marcaActual
                                                    ? `/hardware/tipo/${toUrlSlug(tipo)}/operador/${marcaActual.slug}`
                                                    : `/hardware/tipo/${toUrlSlug(tipo)}`
                                            }
                                            selected={tipoActual === tipo}
                                        >
                                            {tipo}
                                        </option>
                                    ))
                                }
                            </select>
                            <svg
                                class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </div>
                    </label>

                    <label class="block">
                        <span
                            class="mb-2 block text-xs font-bold uppercase tracking-[0.2em] text-blue-400"
                        >
                            Operador
                        </span>

                        <div class="relative">
                            <select
                                class="w-full rounded border border-white/10 bg-slate-950 px-4 py-3 text-sm font-semibold text-slate-200 outline-none"
                                onchange="window.location.href = this.value"
                            >
                                <option
                                    value={tipoActual
                                        ? `/hardware/tipo/${tipoSlug}`
                                        : "/hardware"}
                                    selected={!marcaActual}
                                >
                                    Todos
                                </option>

                                {
                                    marcas.map((marca: any) => (
                                        <option
                                            value={
                                                tipoActual
                                                    ? `/hardware/tipo/${tipoSlug}/operador/${marca.slug}`
                                                    : `/hardware/operador/${marca.slug}`
                                            }
                                            selected={
                                                marcaActual?.slug === marca.slug
                                            }
                                        >
                                            {marca.nombre}
                                        </option>
                                    ))
                                }
                            </select>
                            <svg
                                class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </div>
                    </label>
                </div>

                <aside
                    class="hidden lg:sticky lg:top-24 lg:block lg:self-start"
                >
                    <div>
                        <p
                            class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-blue-400"
                        >
                            Tipo de hardware
                        </p>

                        <nav class="mb-5">
                            <a
                                href={marcaActual
                                    ? `/hardware/operador/${marcaActual.slug}`
                                    : "/hardware"}
                                class={`block rounded border px-4 py-3 text-sm font-semibold transition ${
                                    !tipoActual
                                        ? "border-blue-500 bg-blue-500/15 text-blue-300"
                                        : "border-white/10 bg-white/5 text-slate-300 hover:bg-slate-900"
                                }`}
                            >
                                Todos
                            </a>

                            {
                                tiposHardware.map((tipo: any) => (
                                    <a
                                        href={
                                            marcaActual
                                                ? `/hardware/tipo/${toUrlSlug(tipo)}/operador/${marcaActual.slug}`
                                                : `/hardware/tipo/${toUrlSlug(tipo)}`
                                        }
                                        class={`block rounded border px-4 py-2 text-sm transition ${
                                            tipoActual === tipo
                                                ? "border-blue-500 bg-blue-500/15 text-blue-300"
                                                : "border-white/10 bg-white/5 text-slate-300 hover:bg-slate-900"
                                        }`}
                                    >
                                        {tipo}
                                    </a>
                                ))
                            }
                        </nav>

                        <p
                            class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-blue-400"
                        >
                            Operador
                        </p>

                        <nav class="grid grid-cols-2 gap-2">
                            <a
                                href={tipoActual
                                    ? `/hardware/tipo/${tipoSlug}`
                                    : "/hardware"}
                                class={`block rounded border px-4 py-3 text-sm font-semibold transition ${
                                    !marcaActual
                                        ? "border-blue-500 bg-blue-500/15 text-blue-300"
                                        : "border-white/10 bg-white/5 text-slate-300 hover:bg-slate-900"
                                }`}
                            >
                                Todos
                            </a>

                            {
                                marcas.map((marca: any) => (
                                    <a
                                        href={
                                            tipoActual
                                                ? `/hardware/tipo/${tipoSlug}/operador/${marca.slug}`
                                                : `/hardware/operador/${marca.slug}`
                                        }
                                        class={`block rounded border px-4 py-2 text-sm transition ${
                                            marcaActual?.slug === marca.slug
                                                ? "border-blue-500 bg-blue-500/15 text-blue-300"
                                                : "border-white/10 bg-white/5 text-slate-300 hover:bg-slate-900"
                                        }`}
                                    >
                                        {marca.nombre}
                                    </a>
                                ))
                            }
                        </nav>
                    </div>
                </aside>

                <section>
                    {
                        page.data.length > 0 ? (
                            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                                {page.data.map((modelo: any) => (
                                    <ModelCard modelo={modelo} />
                                ))}
                            </div>
                        ) : (
                            <p class="rounded border border-white/10 bg-slate-900 p-6 text-slate-300">
                                No hay hardware que coincida con estos filtros.
                            </p>
                        )
                    }

                    <Pagination
                        currentPage={page.currentPage}
                        totalPages={page.lastPage}
                        basePath={basePath}
                    />
                </section>
            </div>
        </Container>
    </main>
</Layout>
