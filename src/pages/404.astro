---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
---

<Layout title="Página no encontrada | TODOSat">
    <main class="min-h-screen py-20">
        <Container>
            <h1 class="text-5xl font-bold">Página no encontrada</h1>

            <p class="mt-6 max-w-2xl text-xl text-gray-600">
                La página que buscas no existe, ha cambiado de dirección o ya no
                está disponible.
            </p>

            <a
                href="/"
                class="mt-8 inline-block rounded border px-5 py-3 font-medium hover:bg-gray-50"
            >
                Volver al inicio
            </a>
        </Container>
    </main>
</Layout>
