---
import Layout from "../layouts/Layout.astro";
import { Picture } from "astro:assets";
import senalPerdida404 from "../assets/images/404-senal-perdida.png";
---

<Layout
    title="404 | Señal perdida"
    description="La página solicitada no está disponible en TodoSatcom."
    robots="noindex, nofollow"
    canonical={null}
>
    <main class="bg-[#00020B] md:min-h-screen">
        <div
            class="mx-auto flex max-w-5xl flex-col items-center px-6 py-6 md:min-h-screen md:justify-center md:py-12"
        >
            <Picture
                src={senalPerdida404}
                formats={["avif", "webp"]}
                fallbackFormat="png"
                widths={[380, 760, 1024]}
                sizes="(max-width: 767px) 380px, 1024px"
                alt="Señal perdida"
                loading="eager"
                decoding="async"
                fetchpriority="high"
                class="w-full max-w-[380px] object-contain md:max-w-5xl"
            />

            <a
                href="/"
                class="mt-4 inline-flex items-center gap-2 rounded-xl border border-[#00ccff] bg-slate-900 px-5 py-2.5 text-base font-semibold text-white shadow-[0_0_24px_rgba(0,204,255,0.25)] transition hover:bg-[#00ccff] hover:text-slate-950 md:mt-8 md:gap-3 md:rounded-2xl md:px-8 md:py-4 md:text-lg"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    class="h-5 w-5 md:h-6 md:w-6"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M2.25 12 11.204 3.045a1.125 1.125 0 0 1 1.592 0L21.75 12M4.5 9.75v10.125A1.125 1.125 0 0 0 5.625 21h12.75A1.125 1.125 0 0 0 19.5 19.875V9.75"
                    ></path>
                </svg>

                <span>Volver al inicio</span>
            </a>
        </div>
    </main>
</Layout>
