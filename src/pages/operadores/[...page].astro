---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import { getMarcas } from "../../lib/content";
import BrandCard from "../../components/BrandCard.astro";
import Pagination from "../../components/Pagination.astro";

export async function getStaticPaths({ paginate }: any) {
    const marcas = await getMarcas();

    return paginate(marcas, {
        pageSize: 9,
    });
}

const { page } = Astro.props as any;
---

<Layout title="Operadores | TodoSatcom">
    <main class="min-h-screen bg-slate-950 py-10">
        <Container>
            <h1 class="mb-8 text-4xl font-bold !text-white">Operadores</h1>

            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                {page.data.map((marca: any) => <BrandCard marca={marca} />)}
            </div>

            <Pagination
                currentPage={page.currentPage}
                totalPages={page.lastPage}
                basePath="/operadores"
            />
        </Container>
    </main>
</Layout>
