---
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/Container.astro";
import {
    getMarcas,
    getModelos,
    getArticulos,
    getManuales,
} from "../../../lib/content";
import { renderBlocks } from "../../../lib/renderBlocks";
import { getMediaUrl } from "../../../lib/media";
import RelatedCard from "../../../components/RelatedCard.astro";
import { formatLabel } from "../../../lib/format";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";

import coberturaIcon from "../../../assets/images/pictostecnicos/cobertura.png";
import satelitesIcon from "../../../assets/images/pictostecnicos/satelites.png";
import velocidadIcon from "../../../assets/images/pictostecnicos/velocidad.png";
import latenciaIcon from "../../../assets/images/pictostecnicos/latencia.png";
import orbitaIcon from "../../../assets/images/pictostecnicos/orbita.png";

export async function getStaticPaths() {
    const marcas = await getMarcas();

    return marcas.map((marca: any) => ({
        params: {
            slug: marca.slug,
        },
        props: {
            marca,
        },
    }));
}

const { marca } = Astro.props as any;

const descripcionHTML = renderBlocks(marca.descripcion_completa);
const logoUrl = getMediaUrl(marca.logo);
const imagenPortadaUrl = getMediaUrl(marca.imagen_portada);

const modelos = (await getModelos()).filter(
    (modelo: any) => modelo.marca?.slug === marca.slug,
);

const articulos = (await getArticulos()).filter((articulo: any) =>
    articulo.marcas?.some(
        (marcaRelacionada: any) => marcaRelacionada.slug === marca.slug,
    ),
);

const manuales = (await getManuales()).filter((manual: any) =>
    manual.marcas?.some(
        (marcaRelacionada: any) => marcaRelacionada.slug === marca.slug,
    ),
);

const metricas = [
    {
        label: "Cobertura",
        value: marca.cobertura,
        icon: coberturaIcon,
    },
    {
        label: "Satélites",
        value: marca.satelites,
        icon: satelitesIcon,
    },
    {
        label: "Velocidad",
        value: marca.velocidad,
        icon: velocidadIcon,
    },
    {
        label: "Latencia",
        value: marca.latencia,
        icon: latenciaIcon,
    },
].filter((item) => item.value);

const detallesTecnicos = [
    {
        title: "Cobertura",
        value: marca.cobertura,
        text: marca.cobertura_descripcion,
        icon: coberturaIcon,
    },
    {
        title: "Satélites",
        value: marca.satelites,
        text: marca.satelites_descripcion,
        icon: satelitesIcon,
    },
    {
        title: "Velocidad",
        value: marca.velocidad,
        text: marca.velocidad_descripcion,
        icon: velocidadIcon,
    },
    {
        title: "Latencia",
        value: marca.latencia,
        text: marca.latencia_descripcion,
        icon: latenciaIcon,
    },
    {
        title: "Tipo de órbita",
        value: marca.tipo_orbita,
        text: marca.orbita_descripcion,
        icon: orbitaIcon,
    },
].filter((item) => item.text || item.value);
---

<Layout
    title={`${marca.nombre} | TodoSatcom`}
    description={marca.descripcion_corta}
>
    <main class="min-h-screen bg-slate-950 py-10 text-white">
        <Container>
            <Breadcrumbs
                items={[
                    {
                        label: "Operadores",
                        href: "/operadores",
                    },
                    {
                        label: marca.nombre,
                    },
                ]}
            />

            <section
                class="relative mt-8 overflow-hidden rounded-3xl border border-white/10 bg-slate-900/45 p-5 shadow-2xl md:p-8"
            >
                <div
                    class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(0,94,255,0.22),transparent_34%),radial-gradient(circle_at_bottom_left,rgba(0,204,255,0.12),transparent_30%)]"
                >
                </div>

                <div
                    class="absolute inset-0 bg-[linear-gradient(120deg,transparent_0%,rgba(255,255,255,0.04)_1px,transparent_1px)] bg-[length:48px_48px] opacity-20"
                >
                </div>

                <div class="relative">
                    <a
                        href="/operadores"
                        class="inline-flex text-sm font-semibold text-blue-400 transition hover:text-white"
                    >
                        ← Volver a operadores
                    </a>

                    <div
                        class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-start lg:gap-12"
                    >
                        <div>
                            {
                                logoUrl && (
                                    <div>
                                        <img
                                            src={logoUrl}
                                            alt={`Logo de ${marca.nombre}`}
                                            class="max-h-16 w-auto max-w-[220px] object-contain md:max-h-40 md:max-w-[400px]"
                                        />

                                        <div class="h-px w-1/2 bg-gradient-to-r from-blue-400/70 to-transparent" />
                                    </div>
                                )
                            }

                            <h1
                                class="mt-5 max-w-3xl text-3xl font-bold leading-tight tracking-tight text-white md:text-5xl"
                            >
                                {marca.nombre}
                            </h1>

                            {
                                marca.descripcion_corta && (
                                    <p class="mt-2 max-w-2xl text-lg font-semibold leading-7 text-slate-100 md:text-xl md:leading-8">
                                        {marca.descripcion_corta}
                                    </p>
                                )
                            }

                            {
                                marca.descripcion_home && (
                                    <p class="mt-4 max-w-2xl text-base text-slate-400">
                                        {marca.descripcion_home}
                                    </p>
                                )
                            }
                        </div>

                        <div>
                            {
                                imagenPortadaUrl && (
                                    <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-slate-950/50 p-3 shadow-2xl">
                                        <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(78,161,255,0.18),transparent_55%)]" />

                                        <img
                                            src={imagenPortadaUrl}
                                            alt={marca.nombre}
                                            class="relative aspect-[16/11] w-full rounded-2xl object-contain"
                                        />

                                        <div class="absolute bottom-6 left-6 z-10 flex flex-wrap gap-3">
                                            {marca.tipo_orbita && (
                                                <span class="rounded-full border border-blue-500/60 bg-slate-950/80 px-4 py-2 text-sm font-semibold text-blue-300 backdrop-blur">
                                                    {marca.tipo_orbita}
                                                </span>
                                            )}

                                            {marca.pais_origen && (
                                                <span class="rounded-full border border-white/15 bg-slate-950/80 px-4 py-2 text-sm font-semibold text-slate-200 backdrop-blur">
                                                    {marca.pais_origen}
                                                </span>
                                            )}
                                        </div>
                                    </div>
                                )
                            }

                            {
                                marca.web_oficial && (
                                    <div class="mt-5 flex justify-end">
                                        <a
                                            href={marca.web_oficial}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="inline-flex rounded-full border border-blue-500/60 bg-blue-500/10 px-6 py-3 text-sm font-bold text-blue-300 transition hover:bg-blue-500 hover:text-white"
                                        >
                                            Web oficial →
                                        </a>
                                    </div>
                                )
                            }
                        </div>
                    </div>
                </div>
            </section>

            {
                detallesTecnicos.length > 0 && (
                    <section class="mt-10 rounded-3xl border border-white/10 bg-slate-900/30 p-6 md:p-8">
                        <h2 class="mb-8 text-2xl font-bold uppercase tracking-wide text-blue-400">
                            Información técnica
                        </h2>
                        <div class="mb-8 h-px w-full bg-white/10" />
                        <div class="grid gap-5 lg:grid-cols-2">
                            {detallesTecnicos.map((item) => (
                                <div class="rounded-2xl border border-white/10 bg-slate-950/40 p-6">
                                    <div class="mb-4 flex items-center gap-3">
                                        <img
                                            src={item.icon.src}
                                            alt={item.title}
                                            class="h-12 w-12 object-contain"
                                        />

                                        <h3 class="text-xl font-bold text-white">
                                            {item.title}:
                                            {item.value && (
                                                <span class="text-blue-400">
                                                    {item.value}
                                                </span>
                                            )}
                                        </h3>
                                    </div>

                                    <p class="leading-7 text-slate-300">
                                        {item.text}
                                    </p>
                                </div>
                            ))}
                        </div>
                    </section>
                )
            }

            {
                descripcionHTML && (
                    <section class="mt-10 rounded-3xl border border-white/10 bg-slate-900/30 p-6 md:p-8">
                        <h2 class="mb-8 text-2xl font-bold uppercase tracking-wide text-blue-400">
                            Acerca de {marca.nombre}
                        </h2>
                        <div class="mb-8 h-px w-full bg-white/10" />
                        <div
                            class="prose prose-invert max-w-5xl prose-headings:text-white prose-p:text-slate-300 prose-a:text-blue-400 prose-strong:text-white md:[&_p]:text-[1.18rem] md:[&_p]:leading-9 md:[&_li]:text-[1.18rem] md:[&_li]:leading-9"
                            set:html={descripcionHTML}
                        />
                    </section>
                )
            }

            <section class="mt-12 border-t border-white/10 pt-10">
                <h2 class="mb-6 text-3xl font-bold text-white">
                    Modelos de {marca.nombre}
                </h2>

                {
                    modelos.length > 0 ? (
                        <div class="grid gap-x-10 gap-y-2 md:grid-cols-2">
                            {modelos.map((modelo: any) => (
                                <RelatedCard
                                    type="Modelo"
                                    title={modelo.nombre}
                                    description={modelo.descripcion_corta}
                                    meta={modelo.marca?.nombre}
                                    url={`/modelos/${modelo.slug}`}
                                    image={modelo.imagen_principal}
                                />
                            ))}
                        </div>
                    ) : (
                        <p class="text-slate-300">
                            Todavía no hay modelos publicados para este
                            operador.
                        </p>
                    )
                }
            </section>

            <section class="mt-12 border-t border-white/10 pt-10">
                <h2 class="mb-6 text-3xl font-bold text-white">
                    Artículos relacionados
                </h2>
                <div class="mb-8 h-px w-full bg-white/10"></div>
                {
                    articulos.length > 0 ? (
                        <div class="grid gap-x-10 gap-y-2 md:grid-cols-2">
                            {articulos.map((articulo: any) => (
                                <RelatedCard
                                    type="Artículo"
                                    title={articulo.titulo}
                                    description={articulo.subtitulo}
                                    meta={articulo.categoria_tematica?.nombre}
                                    url={`/articulos/${articulo.slug}`}
                                    image={articulo.imagen_principal}
                                />
                            ))}
                        </div>
                    ) : (
                        <p class="text-slate-300">
                            Todavía no hay artículos relacionados con este
                            operador.
                        </p>
                    )
                }
            </section>

            <section class="mt-12 border-t border-white/10 pt-10">
                <h2 class="mb-6 text-3xl font-bold text-white">
                    Manuales relacionados
                </h2>
                <div class="mb-8 h-px w-full bg-white/10"></div>
                {
                    manuales.length > 0 ? (
                        <div class="grid gap-x-10 gap-y-2 md:grid-cols-2">
                            {manuales.map((manual: any) => (
                                <RelatedCard
                                    type="Manual"
                                    title={manual.titulo}
                                    description={manual.descripcion}
                                    meta={`${manual.ano_publicacion ?? ""}${manual.idioma ? ` · ${formatLabel(manual.idioma)}` : ""}`}
                                    url={`/manuales/${manual.slug}`}
                                    image={manual.imagen_portada}
                                />
                            ))}
                        </div>
                    ) : (
                        <p class="text-slate-300">
                            Todavía no hay manuales relacionados con este
                            operador.
                        </p>
                    )
                }
            </section>
        </Container>
    </main>
</Layout>
