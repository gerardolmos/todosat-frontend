---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import {
    getMarcas,
    getModelos,
    getArticulos,
    getManuales,
} from "../lib/content";

import { getMediaUrl } from "../lib/media";
import searchIcon from "../assets/images/icons/search.svg";

const marcas = await getMarcas();
const modelos = await getModelos();
const articulos = await getArticulos();
const manuales = await getManuales();

function limpiarTexto(valor: any) {
    return String(valor || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
}

const datosBusqueda = [
    ...marcas.map((item: any) => ({
        tipo: "Operador",
        titulo: item.nombre,
        descripcion: item.descripcion_corta,
        url: `/operadores/${item.slug}`,
        imageUrl: getMediaUrl(item.imagen_portada || item.logo),
        texto: limpiarTexto(`
			${item.nombre}
			${item.descripcion_home}
			${item.descripcion_corta}
			${item.descripcion_completa}
			${item.pais_origen}
			${item.tipo_orbita}
			${item.cobertura}
			${item.velocidad}
			${item.latencia}
		`),
    })),
    ...modelos.map((item: any) => ({
        tipo: "Hardware",
        titulo: item.nombre,
        descripcion: item.descripcion_corta,
        url: `/hardware/${item.slug}`,
        imageUrl: getMediaUrl(item.imagen_principal),
        texto: limpiarTexto(`
			${item.nombre}
			${item.descripcion_corta}
			${item.descripcion_completa}
			${item.uso_recomendado}
${item.tipo_hardware}
${item.marca?.nombre}
		`),
    })),
    ...articulos.map((item: any) => ({
        tipo: "Noticia",
        titulo: item.titulo,
        descripcion: item.subtitulo,
        url: `/noticias/${item.slug}`,
        imageUrl: getMediaUrl(item.imagen_principal),
        texto: limpiarTexto(`
			${item.titulo}
			${item.subtitulo}
			${item.contenido}
			${item.categoria_tematica?.nombre || ""}
		`),
    })),
    ...manuales.map((item: any) => ({
        tipo: "Manual",
        titulo: item.titulo,
        descripcion: item.descripcion,
        url: `/manuales/${item.slug}`,
        imageUrl: getMediaUrl(item.imagen_portada),
        texto: limpiarTexto(`
			${item.titulo}
			${item.descripcion}
			${item.idioma}
			${item.version}
			${item.ano_publicacion}
			${item.marcas?.map((marca: any) => marca.nombre).join(" ")}
			${item.modelos?.map((modelo: any) => modelo.nombre).join(" ")}
		`),
    })),
];
---

<Layout title="Buscar | TodoSatcom">
    <main class="min-h-screen bg-slate-950 py-16 text-white">
        <Container>
            <section
                class="relative z-20 mb-12 overflow-visible rounded-3xl border border-white/10 bg-slate-950 px-8 py-14 shadow-2xl md:px-12 md:py-16"
            >
                <div
                    class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(0,94,255,0.24),transparent_35%),radial-gradient(circle_at_bottom_left,rgba(78,161,255,0.13),transparent_32%)]"
                >
                </div>
                <div
                    class="absolute inset-0 bg-[linear-gradient(120deg,transparent_0%,rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[length:48px_48px] opacity-20"
                >
                </div>

                <div class="relative max-w-4xl">
                    <p
                        class="inline-flex rounded-full border border-blue-500/40 bg-blue-500/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.2em] text-blue-400"
                    >
                        Buscador global
                    </p>

                    <h1
                        class="mt-6 max-w-3xl text-5xl font-bold leading-tight tracking-tight !text-white md:text-6xl"
                    >
                        Buscar en TodoSatcom
                    </h1>

                    <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
                        Encuentra operadores, hardware, noticias y manuales
                        desde una única búsqueda.
                    </p>

                    <form
                        action="/buscar"
                        method="get"
                        class="relative z-50 mt-8 flex max-w-3xl items-center gap-2 rounded-full border border-white/15 bg-slate-950/55 p-2 shadow-2xl shadow-slate-950/40 backdrop-blur-md"
                    >
                        <div
                            class="flex min-h-12 flex-1 items-center gap-3 rounded-full px-4"
                        >
                            <img
                                src={searchIcon.src}
                                alt=""
                                aria-hidden="true"
                                class="h-6 w-6 shrink-0 object-contain"
                            />

                            <input
                                id="search-input"
                                type="search"
                                name="q"
                                autocomplete="off"
                                spellcheck="false"
                                placeholder="Buscar operadores, hardware, noticias o manuales..."
                                class="w-full appearance-none bg-transparent text-base text-white outline-none placeholder:text-slate-400"
                            />
                        </div>

                        <button
                            type="submit"
                            class="rounded-full bg-blue-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-blue-500"
                        >
                            Buscar
                        </button>
                        <div
                            id="search-page-suggestions"
                            class="absolute left-0 top-full z-50 mt-3 hidden w-full overflow-hidden rounded-2xl border border-white/10 bg-slate-950/95 shadow-2xl shadow-slate-950/60 backdrop-blur-md"
                        >
                        </div>
                    </form>
                </div>
            </section>

            <div id="search-results" class="mt-10"></div>

            <script
                type="application/json"
                id="search-data"
                set:html={JSON.stringify(datosBusqueda)}
            />
        </Container>
    </main>

    <script>
        type SearchItem = {
            tipo: string;
            titulo: string;
            descripcion?: string;
            url: string;
            texto: string;
            imageUrl?: string;
        };

        type RankedSearchItem = {
            item: SearchItem;
            score: number;
        };

        const RESULTS_PER_PAGE = 12;
        const MIN_QUERY_LENGTH = 3;

        function limpiarTexto(valor: string) {
            return String(valor || "")
                .toLowerCase()
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "");
        }

        function escapeHtml(valor: string) {
            return String(valor || "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function getWords(valor: string) {
            return limpiarTexto(valor).match(/[a-z0-9]+/g) || [];
        }

        function hasExactWord(words: string[], term: string) {
            return words.includes(term);
        }

        function hasWordStartingWith(words: string[], term: string) {
            return words.some((word) => word.startsWith(term));
        }

        function hasLongPartialMatch(words: string[], term: string) {
            if (term.length < 4) return false;

            return words.some((word) => word.includes(term));
        }

        function calcularPuntuacion(
            item: SearchItem,
            terms: string[],
            fullQuery: string,
        ) {
            const titulo = limpiarTexto(item.titulo);
            const descripcion = limpiarTexto(item.descripcion || "");
            const texto = limpiarTexto(item.texto);

            const titleWords = getWords(item.titulo);
            const descriptionWords = getWords(item.descripcion || "");
            const textWords = getWords(item.texto);

            let score = 0;

            for (const term of terms) {
                let termScore = 0;

                if (titulo === term) termScore = Math.max(termScore, 140);
                if (titulo.startsWith(term))
                    termScore = Math.max(termScore, 120);
                if (hasExactWord(titleWords, term))
                    termScore = Math.max(termScore, 100);
                if (hasWordStartingWith(titleWords, term))
                    termScore = Math.max(termScore, 80);
                if (hasLongPartialMatch(titleWords, term))
                    termScore = Math.max(termScore, 50);

                if (hasExactWord(descriptionWords, term))
                    termScore = Math.max(termScore, 35);
                if (hasWordStartingWith(descriptionWords, term))
                    termScore = Math.max(termScore, 25);
                if (hasLongPartialMatch(descriptionWords, term))
                    termScore = Math.max(termScore, 15);

                if (hasWordStartingWith(textWords, term))
                    termScore = Math.max(termScore, 12);
                if (hasLongPartialMatch(textWords, term))
                    termScore = Math.max(termScore, 6);

                if (termScore === 0) return 0;

                score += termScore;
            }

            if (titulo === fullQuery) score += 200;
            else if (titulo.startsWith(fullQuery)) score += 150;
            else if (fullQuery.length >= 4 && titulo.includes(fullQuery))
                score += 80;

            if (descripcion.includes(fullQuery) && fullQuery.length >= 4)
                score += 20;

            if (texto.includes(fullQuery) && fullQuery.length >= 4) score += 5;

            return score;
        }

        function crearUrlPagina(queryOriginal: string, page: number) {
            const params = new URLSearchParams();

            params.set("q", queryOriginal);

            if (page > 1) {
                params.set("page", String(page));
            }

            return `/buscar?${params.toString()}`;
        }

        function renderPagination(
            queryOriginal: string,
            currentPage: number,
            totalPages: number,
        ) {
            if (totalPages <= 1) return "";

            const previous =
                currentPage > 1
                    ? `
                    <a
                        href="${crearUrlPagina(queryOriginal, currentPage - 1)}"
                        class="rounded-full border border-white/10 px-4 py-2 text-sm font-bold text-slate-200 transition hover:border-blue-500 hover:text-white"
                    >
                        ← Anterior
                    </a>
                `
                    : `
                    <span class="rounded-full border border-white/5 px-4 py-2 text-sm font-bold text-slate-600">
                        ← Anterior
                    </span>
                `;

            const next =
                currentPage < totalPages
                    ? `
                    <a
                        href="${crearUrlPagina(queryOriginal, currentPage + 1)}"
                        class="rounded-full border border-white/10 px-4 py-2 text-sm font-bold text-slate-200 transition hover:border-blue-500 hover:text-white"
                    >
                        Siguiente →
                    </a>
                `
                    : `
                    <span class="rounded-full border border-white/5 px-4 py-2 text-sm font-bold text-slate-600">
                        Siguiente →
                    </span>
                `;

            return `
            <nav class="mt-12 flex flex-col gap-4 border-t border-white/10 pt-8 sm:flex-row sm:items-center sm:justify-between">
                ${previous}

                <p class="text-sm font-semibold text-slate-400">
                    Página <span class="text-white">${currentPage}</span> de <span class="text-white">${totalPages}</span>
                </p>

                ${next}
            </nav>
        `;
        }

        const params = new URLSearchParams(window.location.search);
        const queryOriginal = params.get("q")?.trim() || "";
        const query = limpiarTexto(queryOriginal);
        const pageParam = Number(params.get("page") || "1");
        const requestedPage =
            Number.isFinite(pageParam) && pageParam > 0
                ? Math.floor(pageParam)
                : 1;

        const input = document.getElementById("search-input");
        const suggestions = document.getElementById("search-page-suggestions");
        const resultsContainer = document.getElementById("search-results");
        const dataElement = document.getElementById("search-data");

        if (
            input instanceof HTMLInputElement &&
            resultsContainer instanceof HTMLElement &&
            dataElement instanceof HTMLScriptElement
        ) {
            input.value = queryOriginal;

            const data = JSON.parse(
                dataElement.textContent || "[]",
            ) as SearchItem[];

            if (suggestions instanceof HTMLElement) {
                input.addEventListener("input", () => {
                    const liveQueryOriginal = input.value.trim();
                    const liveQuery = limpiarTexto(liveQueryOriginal);

                    if (liveQuery.length < MIN_QUERY_LENGTH) {
                        suggestions.classList.add("hidden");
                        suggestions.innerHTML = "";
                        return;
                    }

                    const terms = liveQuery
                        .split(/\s+/)
                        .map((term) => term.trim())
                        .filter((term) => term.length >= MIN_QUERY_LENGTH);

                    if (terms.length === 0) {
                        suggestions.classList.add("hidden");
                        suggestions.innerHTML = "";
                        return;
                    }

                    const resultadosPredictivos = data
                        .map((item: SearchItem) => ({
                            item,
                            score: calcularPuntuacion(item, terms, liveQuery),
                        }))
                        .filter((result: RankedSearchItem) => result.score > 0)
                        .sort((a: RankedSearchItem, b: RankedSearchItem) => {
                            if (b.score !== a.score) return b.score - a.score;

                            return a.item.titulo.localeCompare(
                                b.item.titulo,
                                "es",
                            );
                        })
                        .slice(0, 6);

                    if (resultadosPredictivos.length === 0) {
                        suggestions.classList.add("hidden");
                        suggestions.innerHTML = "";
                        return;
                    }

                    suggestions.innerHTML = `
            <div class="p-2">
                ${resultadosPredictivos
                    .map(
                        ({ item }: RankedSearchItem) => `
                            <a
                                href="${item.url}"
                                class="group flex items-center justify-between gap-4 rounded-xl px-4 py-3 transition hover:bg-slate-900"
                            >
                                <div>
                                    <p class="text-sm font-bold text-white group-hover:text-[#4EA1FF]">
                                        ${escapeHtml(item.titulo)}
                                    </p>

                                    <p class="mt-1 text-xs font-semibold uppercase tracking-[0.14em] text-blue-400">
                                        ${escapeHtml(item.tipo)}
                                    </p>

                                    ${
                                        item.descripcion
                                            ? `
                                                <p class="mt-2 line-clamp-1 text-xs text-slate-400">
                                                    ${escapeHtml(item.descripcion)}
                                                </p>
                                            `
                                            : ""
                                    }
                                </div>

                                <span class="text-slate-500 group-hover:text-[#4EA1FF]">→</span>
                            </a>
                        `,
                    )
                    .join("")}
            </div>

            <a
                href="/buscar?q=${encodeURIComponent(liveQueryOriginal)}"
                class="block border-t border-white/10 px-6 py-4 text-sm font-bold text-[#4EA1FF] hover:bg-slate-900"
            >
                Ver todos los resultados →
            </a>
        `;

                    suggestions.classList.remove("hidden");
                });

                document.addEventListener("click", (event) => {
                    if (
                        !suggestions.contains(event.target as Node) &&
                        event.target !== input
                    ) {
                        suggestions.classList.add("hidden");
                    }
                });
            }

            if (!query) {
                resultsContainer.innerHTML = `
                <p class="rounded-2xl border border-white/10 bg-slate-900/40 p-6 text-slate-300">
                    Escribe una búsqueda para encontrar contenido en TodoSatcom.
                </p>
            `;
            } else {
                const terms = query
                    .split(/\s+/)
                    .map((term) => term.trim())
                    .filter((term) => term.length >= MIN_QUERY_LENGTH);

                if (terms.length === 0) {
                    resultsContainer.innerHTML = `
                    <p class="rounded-2xl border border-white/10 bg-slate-900/40 p-6 text-slate-300">
                        Introduce al menos <strong class="text-white">${MIN_QUERY_LENGTH} caracteres</strong> para buscar.
                    </p>
                `;
                } else {
                    const resultados = data
                        .map((item: SearchItem) => ({
                            item,
                            score: calcularPuntuacion(item, terms, query),
                        }))
                        .filter((result: RankedSearchItem) => result.score > 0)
                        .sort((a: RankedSearchItem, b: RankedSearchItem) => {
                            if (b.score !== a.score) return b.score - a.score;

                            return a.item.titulo.localeCompare(
                                b.item.titulo,
                                "es",
                            );
                        });

                    if (resultados.length === 0) {
                        resultsContainer.innerHTML = `
                        <p class="rounded-2xl border border-white/10 bg-slate-900/40 p-6 text-slate-300">
                            No se han encontrado resultados para <strong class="text-white">${escapeHtml(queryOriginal)}</strong>.
                        </p>
                    `;
                    } else {
                        const totalPages = Math.ceil(
                            resultados.length / RESULTS_PER_PAGE,
                        );
                        const currentPage = Math.min(requestedPage, totalPages);
                        const start = (currentPage - 1) * RESULTS_PER_PAGE;
                        const end = start + RESULTS_PER_PAGE;
                        const resultadosPagina = resultados.slice(start, end);

                        resultsContainer.innerHTML = `
                        <p class="mb-8 text-slate-300">
                            Mostrando
                            <span class="font-bold text-white">${start + 1}</span>–<span class="font-bold text-white">${Math.min(end, resultados.length)}</span>
                            de
                            <span class="font-bold text-white">${resultados.length}</span>
                            resultado${resultados.length === 1 ? "" : "s"} para
                            <strong class="text-white">${escapeHtml(queryOriginal)}</strong>
                        </p>

                        <ul class="grid gap-4 md:grid-cols-2">
                            ${resultadosPagina
                                .map(
                                    ({ item }: RankedSearchItem) => `
                                        <li>
                                            <a href="${item.url}" class="group flex h-full">
                                                <div class="flex min-h-[150px] w-full gap-5 border-b border-white/10 py-6 transition-colors duration-200 group-hover:border-[#005EFF]">
                                                    ${
                                                        item.imageUrl
                                                            ? `
                                                                <div class="h-24 w-24 shrink-0 overflow-hidden rounded">
                                                                    <img
                                                                        src="${item.imageUrl}"
                                                                        alt="${escapeHtml(item.titulo)}"
                                                                        class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-105"
                                                                        loading="lazy"
                                                                    />
                                                                </div>
                                                            `
                                                            : ""
                                                    }

                                                    <div class="flex min-w-0 flex-1 flex-col">
                                                        <div class="mb-3 flex flex-wrap gap-2">
                                                            <span class="rounded-full border border-blue-500/50 bg-blue-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-blue-300">
                                                                ${escapeHtml(item.tipo)}
                                                            </span>
                                                        </div>

                                                        <h3 class="line-clamp-2 text-lg font-bold leading-snug tracking-tight !text-white">
                                                            ${escapeHtml(item.titulo)}
                                                        </h3>

                                                        ${
                                                            item.descripcion
                                                                ? `
                                                                    <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-300">
                                                                        ${escapeHtml(item.descripcion)}
                                                                    </p>
                                                                `
                                                                : ""
                                                        }
                                                    </div>
                                                </div>
                                            </a>
                                        </li>
                                    `,
                                )
                                .join("")}
                        </ul>

                        ${renderPagination(queryOriginal, currentPage, totalPages)}
                    `;
                    }
                }
            }
        }
    </script>
</Layout>
