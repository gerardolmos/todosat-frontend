---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import { getArticulos, getCategorias } from "../../lib/content";
import ArticleCard from "../../components/ArticleCard.astro";
import Pagination from "../../components/Pagination.astro";
import { getMediaUrl } from "../../lib/media";
import todasIcon from "../../assets/images/categoryPictos/todas.png";

export async function getStaticPaths() {
    const PAGE_SIZE = 9;

    function createPage(data: any[], currentPage: number) {
        const totalPages = Math.ceil(data.length / PAGE_SIZE) || 1;
        const start = (currentPage - 1) * PAGE_SIZE;

        return {
            data: data.slice(start, start + PAGE_SIZE),
            currentPage,
            lastPage: totalPages,
        };
    }

    const articulos = await getArticulos();
    const categorias = await getCategorias();

    const paths: any[] = [];

    const totalPages = Math.ceil(articulos.length / PAGE_SIZE) || 1;

    for (let pageNumber = 1; pageNumber <= totalPages; pageNumber++) {
        paths.push({
            params: {
                page: pageNumber === 1 ? undefined : String(pageNumber),
            },
            props: {
                page: createPage(articulos, pageNumber),
                categorias,
                categoriaActual: null,
            },
        });
    }

    categorias.forEach((categoria: any) => {
        const categoriaSlug = String(categoria.slug);

        const articulosCategoria = articulos.filter(
            (articulo: any) =>
                articulo.categoria_tematica?.slug === categoriaSlug,
        );

        const totalCategoryPages =
            Math.ceil(articulosCategoria.length / PAGE_SIZE) || 1;

        for (
            let pageNumber = 1;
            pageNumber <= totalCategoryPages;
            pageNumber++
        ) {
            paths.push({
                params: {
                    page:
                        pageNumber === 1
                            ? categoriaSlug
                            : `${categoriaSlug}/${pageNumber}`,
                },
                props: {
                    page: createPage(articulosCategoria, pageNumber),
                    categorias,
                    categoriaActual: categoria,
                },
            });
        }
    });

    return paths;
}

const { page, categorias, categoriaActual } = Astro.props as any;

const title = categoriaActual
    ? `${categoriaActual.nombre} | Artículos | TodoSatcom`
    : "Artículos | TodoSatcom";

const basePath = categoriaActual
    ? `/articulos/${categoriaActual.slug}`
    : "/articulos";
---

<Layout title={title}>
    <main class="min-h-screen bg-slate-950 py-16 text-white">
        <Container>
            <div class="mb-10">
                <p
                    class="inline-flex w-fit rounded-full border border-blue-500/50 bg-blue-500/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-blue-400"
                >
                    Actualidad satelital
                </p>

                <h1
                    class="mt-6 text-4xl font-bold tracking-tight !text-white md:text-5xl"
                >
                    {categoriaActual ? categoriaActual.nombre : "Artículos"}
                </h1>

                <p class="mt-4 max-w-2xl text-base leading-7 text-slate-300">
                    {
                        categoriaActual?.descripcion ||
                            "Noticias, análisis y contenidos sobre operadores, gaming, tecnología espacial y comunicaciones satelitales."
                    }
                </p>
            </div>

            <div
                class="mb-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6"
            >
                <a
                    href="/articulos"
                    class={`group flex flex-col items-center rounded-xl border bg-transparent px-4 py-5 transition-all duration-150  hover:border-[#005EFF] hover:shadow-[0_0_14px_rgba(0,94,255,0.25)] ${
                        !categoriaActual
                            ? "border-[#005EFF] bg-slate-900/50 shadow-[0_0_18px_rgba(0,94,255,0.35)]"
                            : "border-transparent"
                    }`}
                >
                    <img
                        src={todasIcon.src}
                        alt="Todas las categorías"
                        class="h-36 w-36 object-contain transition-transform duration-150 group-hover:scale-105"
                    />

                    <p
                        class="mt-3 text-center text-base font-semibold tracking-wide text-white"
                    >
                        Todas
                    </p>
                </a>

                {
                    categorias.map((categoria: any) => {
                        const iconoUrl = getMediaUrl(categoria.icono);

                        return (
                            <a
                                href={`/articulos/${categoria.slug}`}
                                class={`group flex flex-col items-center rounded border bg-transparent px-4 py-5 transition-all duration-200 hover:border-[#005EFF] hover:shadow-[0_0_14px_rgba(0,94,255,0.25)]  ${
                                    categoriaActual?.slug === categoria.slug
                                        ? "border-[#005EFF] bg-slate-900/50 shadow-[0_0_18px_rgba(0,94,255,0.35)]"
                                        : "border-transparent"
                                }`}
                            >
                                {iconoUrl && (
                                    <img
                                        src={iconoUrl}
                                        alt={categoria.nombre}
                                        class="h-36 w-36 object-contain transition-transform duration-150 group-hover:scale-105"
                                    />
                                )}

                                <p class="mt-3 text-center text-base font-semibold tracking-wide text-white">
                                    {categoria.nombre}
                                </p>
                            </a>
                        );
                    })
                }
            </div>

            {
                page.data.length > 0 ? (
                    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                        {page.data.map((articulo: any) => (
                            <ArticleCard articulo={articulo} />
                        ))}
                    </div>
                ) : (
                    <p class="rounded border border-white/10 bg-slate-900 p-6 text-slate-300">
                        Todavía no hay artículos en esta categoría.
                    </p>
                )
            }

            <Pagination
                currentPage={page.currentPage}
                totalPages={page.lastPage}
                basePath={basePath}
            />
        </Container>
    </main>
</Layout>
