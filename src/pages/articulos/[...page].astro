---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/Container.astro";
import { getArticulos, getCategorias } from "../../lib/content";
import ArticleCard from "../../components/ArticleCard.astro";
import Pagination from "../../components/Pagination.astro";
import { getMediaUrl } from "../../lib/media";
import todasIcon from "../../assets/images/categoryPictos/todas.png";

export async function getStaticPaths() {
    const PAGE_SIZE = 9;

    function createPage(data: any[], currentPage: number) {
        const totalPages = Math.ceil(data.length / PAGE_SIZE) || 1;
        const start = (currentPage - 1) * PAGE_SIZE;

        return {
            data: data.slice(start, start + PAGE_SIZE),
            currentPage,
            lastPage: totalPages,
        };
    }

    const articulos = await getArticulos();
    const categorias = await getCategorias();

    const paths: any[] = [];

    const totalPages = Math.ceil(articulos.length / PAGE_SIZE) || 1;

    for (let pageNumber = 1; pageNumber <= totalPages; pageNumber++) {
        paths.push({
            params: {
                page: pageNumber === 1 ? undefined : String(pageNumber),
            },
            props: {
                page: createPage(articulos, pageNumber),
                categorias,
                categoriaActual: null,
            },
        });
    }

    categorias.forEach((categoria: any) => {
        const categoriaSlug = String(categoria.slug);

        const articulosCategoria = articulos.filter(
            (articulo: any) =>
                articulo.categoria_tematica?.slug === categoriaSlug,
        );

        const totalCategoryPages =
            Math.ceil(articulosCategoria.length / PAGE_SIZE) || 1;

        for (
            let pageNumber = 1;
            pageNumber <= totalCategoryPages;
            pageNumber++
        ) {
            paths.push({
                params: {
                    page:
                        pageNumber === 1
                            ? categoriaSlug
                            : `${categoriaSlug}/${pageNumber}`,
                },
                props: {
                    page: createPage(articulosCategoria, pageNumber),
                    categorias,
                    categoriaActual: categoria,
                },
            });
        }
    });

    return paths;
}

const { page, categorias, categoriaActual } = Astro.props as any;

const title = categoriaActual
    ? `${categoriaActual.nombre} | Artículos | TodoSatcom`
    : "Artículos | TodoSatcom";

const basePath = categoriaActual
    ? `/articulos/${categoriaActual.slug}`
    : "/articulos";
---

<Layout title={title}>
    <main class="min-h-screen bg-slate-950 py-16 text-white">
        <Container>
            <section
                class="relative mb-12 overflow-hidden rounded-3xl border border-white/10 bg-slate-950 px-8 py-14 shadow-2xl md:px-12 md:py-20"
            >
                <div
                    class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(0,94,255,0.24),transparent_35%),radial-gradient(circle_at_bottom_left,rgba(78,161,255,0.13),transparent_32%)]"
                >
                </div>
                <div
                    class="absolute inset-0 bg-[linear-gradient(120deg,transparent_0%,rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[length:48px_48px] opacity-20"
                >
                </div>
                <div
                    class="absolute -right-32 top-10 h-72 w-72 rounded-full border border-blue-400/20"
                >
                </div>
                <div
                    class="absolute -right-20 top-24 h-96 w-96 rounded-full border border-cyan-400/10"
                >
                </div>

                <div class="relative max-w-4xl">
                    <p
                        class="inline-flex rounded-full border border-blue-500/40 bg-blue-500/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.2em] text-blue-400"
                    >
                        Actualidad satelital
                    </p>

                    <h1
                        class="mt-6 max-w-3xl text-5xl font-bold leading-tight tracking-tight !text-white md:text-6xl"
                    >
                        {
                            categoriaActual
                                ? categoriaActual.nombre
                                : "Actualidad y guías"
                        }
                    </h1>

                    <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
                        {
                            categoriaActual?.descripcion ||
                                "Noticias, análisis, guías y contenidos para entender mejor los operadores, equipos, servicios y tendencias del ecosistema satelital."
                        }
                    </p>

                    <div class="mt-8 flex flex-wrap gap-3">
                        <span
                            class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-slate-200"
                        >
                            Noticias
                        </span>
                        <span
                            class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-slate-200"
                        >
                            Guías
                        </span>
                        <span
                            class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-slate-200"
                        >
                            Comparativas
                        </span>
                        <span
                            class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-slate-200"
                        >
                            Análisis
                        </span>
                    </div>
                </div>
            </section>

            <div class="grid gap-10 lg:grid-cols-[260px_1fr]">
                <aside class="lg:sticky lg:top-24 lg:self-start">
                    <div>
                        <p
                            class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-blue-400"
                        >
                            Categorías
                        </p>

                        <nav>
                            <a
                                href="/articulos"
                                class={`group flex items-center gap-4 border-b border-white/10 px-1 py-2.5 transition-all duration-200 hover:bg-slate-900/30 ${
                                    !categoriaActual
                                        ? "text-blue-400"
                                        : "text-white"
                                }`}
                            >
                                <img
                                    src={todasIcon.src}
                                    alt="Todas las categorías"
                                    class="h-18 w-18 object-contain transition-transform duration-300 group-hover:scale-110"
                                />

                                <span class="font-semibold"> Todas </span>
                            </a>

                            {
                                categorias.map((categoria: any) => {
                                    const iconoUrl = getMediaUrl(
                                        categoria.icono,
                                    );

                                    return (
                                        <a
                                            href={`/articulos/${categoria.slug}`}
                                            class={`group flex items-center gap-4 border-b border-white/10 px-1 py-2.5 transition-all duration-200 hover:bg-slate-900/30 ${
                                                categoriaActual?.slug ===
                                                categoria.slug
                                                    ? "text-blue-400"
                                                    : "text-white"
                                            }`}
                                        >
                                            {iconoUrl && (
                                                <img
                                                    src={iconoUrl}
                                                    alt={categoria.nombre}
                                                    class="h-18 w-18 object-contain transition-transform duration-300 group-hover:scale-110"
                                                />
                                            )}

                                            <span class="font-semibold">
                                                {categoria.nombre}
                                            </span>
                                        </a>
                                    );
                                })
                            }
                        </nav>
                    </div>
                </aside>

                <section>
                    {
                        page.data.length > 0 ? (
                            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                                {page.data.map((articulo: any) => (
                                    <ArticleCard articulo={articulo} />
                                ))}
                            </div>
                        ) : (
                            <p class="rounded border border-white/10 bg-slate-900 p-6 text-slate-300">
                                Todavía no hay artículos en esta categoría.
                            </p>
                        )
                    }

                    <Pagination
                        currentPage={page.currentPage}
                        totalPages={page.lastPage}
                        basePath={basePath}
                    />
                </section>
            </div>
        </Container>
    </main></Layout
>
