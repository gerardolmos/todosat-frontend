---
import Layout from "../../../layouts/Layout.astro";
import { getArticulos } from "../../../lib/content";
import { renderBlocks } from "../../../lib/renderBlocks";
import { getMediaUrl } from "../../../lib/media";
import Container from "../../../components/Container.astro";
import RelatedCard from "../../../components/RelatedCard.astro";

export async function getStaticPaths() {
    const articulos = await getArticulos();

    return articulos.map((articulo: any) => ({
        params: {
            slug: articulo.slug,
        },
        props: {
            articulo: articulo,
        },
    }));
}

const { articulo } = Astro.props as any;
const contenidoHTML = renderBlocks(articulo.contenido);
const imagenUrl = getMediaUrl(articulo.imagen_principal);

const categoria = articulo.categoria_tematica;
const marcas = articulo.marcas || [];
const modelos = articulo.modelos || [];
const manuales = articulo.manuals || [];
---

<Layout title={`${articulo.titulo} | TODOSat`}>
    <main class="min-h-screen py-10">
        <Container>
            <a href="/articulos" class="text-blue-600 underline">
                ← Volver a artículos
            </a>

            <h1 class="text-5xl font-bold mt-6">
                {articulo.titulo}
            </h1>

            {
                articulo.subtitulo && (
                    <p class="mt-4 text-2xl text-gray-700">
                        {articulo.subtitulo}
                    </p>
                )
            }

            {
                imagenUrl && (
                    <img
                        src={imagenUrl}
                        alt={articulo.titulo}
                        class="mt-8 w-full max-w-4xl rounded"
                    />
                )
            }

            <div class="mt-10 space-y-2">
                {
                    articulo.tipo_articulo && (
                        <p>
                            Tipo: <strong>{articulo.tipo_articulo}</strong>
                        </p>
                    )
                }

                {
                    articulo.fecha_publicacion && (
                        <p>
                            Fecha: <strong>{articulo.fecha_publicacion}</strong>
                        </p>
                    )
                }

                {
                    categoria && (
                        <p>
                            Categoría:{" "}
                            <a
                                href={`/categorias/${categoria.slug}`}
                                class="text-blue-600 underline"
                            >
                                {categoria.nombre}
                            </a>
                        </p>
                    )
                }
            </div>

            <section
                class="mt-10 prose prose-lg max-w-none"
                set:html={contenidoHTML}
            />

            {
                marcas.length > 0 && (
                    <section class="mt-12">
                        <h2 class="text-3xl font-bold">Marcas relacionadas</h2>

                        <div class="mt-4 grid gap-4 md:grid-cols-2">
                            {marcas.map((marca: any) => (
                                <RelatedCard
                                    type="Marca"
                                    title={marca.nombre}
                                    description={marca.descripcion_corta}
                                    url={`/marcas/${marca.slug}`}
                                    image={marca.imagen_portada}
                                />
                            ))}
                        </div>
                    </section>
                )
            }

            {
                modelos.length > 0 && (
                    <section class="mt-12">
                        <h2 class="text-3xl font-bold">Modelos relacionados</h2>

                        <div class="mt-4 grid gap-4 md:grid-cols-2">
                            {modelos.map((modelo: any) => (
                                <RelatedCard
                                    type="Modelo"
                                    title={modelo.nombre}
                                    description={modelo.descripcion_corta}
                                    url={`/modelos/${modelo.slug}`}
                                    image={modelo.imagen_principal}
                                />
                            ))}
                        </div>
                    </section>
                )
            }

            {
                manuales.length > 0 && (
                    <section class="mt-12">
                        <h2 class="text-3xl font-bold">
                            Manuales relacionados
                        </h2>

                        <div class="mt-4 grid gap-4 md:grid-cols-2">
                            {manuales.map((manual: any) => (
                                <RelatedCard
                                    type="Manual"
                                    title={manual.titulo}
                                    description={manual.descripcion}
                                    url={`/manuales/${manual.slug}`}
                                    image={manual.imagen_portada}
                                />
                            ))}
                        </div>
                    </section>
                )
            }
        </Container>
    </main>
</Layout>
