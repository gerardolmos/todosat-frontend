---
import Layout from "../../../layouts/Layout.astro";
import { getArticulos } from "../../../lib/content";
import { renderBlocks } from "../../../lib/renderBlocks";
import { getMediaUrl } from "../../../lib/media";
import Container from "../../../components/Container.astro";
import RelatedCard from "../../../components/RelatedCard.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { formatLabel } from "../../../lib/format";

export async function getStaticPaths() {
    const articulos = await getArticulos();

    return articulos.map((articulo: any) => ({
        params: {
            slug: articulo.slug,
        },
        props: {
            articulo,
        },
    }));
}

const { articulo } = Astro.props as any;

const contenidoHTML = renderBlocks(articulo.contenido);
const imagenUrl = getMediaUrl(articulo.imagen_principal);

const categoria = articulo.categoria_tematica;
const marcas = articulo.marcas || [];
const modelos = articulo.modelos || [];
const manuales = articulo.manuals || [];
---

<Layout
    title={`${articulo.titulo} | Todo-Sat`}
    description={articulo.subtitulo}
>
    <main class="min-h-screen py-10">
        <Container>
            <Breadcrumbs
                items={[
                    {
                        label: "Artículos",
                        href: "/articulos",
                    },
                    {
                        label: articulo.titulo,
                    },
                ]}
            />

            <article class="mt-8">
                <a
                    href="/articulos"
                    class="text-sm font-semibold text-info-primary hover:text-info-primary-dark"
                >
                    ← Volver a artículos
                </a>

                <header class="mt-8 max-w-4xl">
                    <div class="flex flex-wrap gap-3">
                        {
                            articulo.tipo_articulo && (
                                <span class="rounded-full bg-info-primary-soft px-4 py-2 text-sm font-semibold text-info-primary-dark">
                                    {formatLabel(articulo.tipo_articulo)}
                                </span>
                            )
                        }

                        {
                            articulo.fecha_publicacion && (
                                <span class="rounded-full bg-brand-soft px-4 py-2 text-sm font-semibold text-brand-muted">
                                    {articulo.fecha_publicacion}
                                </span>
                            )
                        }

                        {
                            categoria && (
                                <a
                                    href={`/categorias/${categoria.slug}`}
                                    class="rounded-full bg-brand-soft px-4 py-2 text-sm font-semibold text-brand-muted hover:text-info-primary"
                                >
                                    {categoria.nombre}
                                </a>
                            )
                        }
                    </div>

                    <h1 class="mt-6">
                        {articulo.titulo}
                    </h1>

                    {
                        articulo.subtitulo && (
                            <p class="mt-6 text-2xl leading-9 text-brand-muted">
                                {articulo.subtitulo}
                            </p>
                        )
                    }
                </header>

                {
                    imagenUrl && (
                        <div class="mt-10 overflow-hidden rounded-3xl border border-brand-border bg-white shadow-sm">
                            <img
                                src={imagenUrl}
                                alt={articulo.titulo}
                                class="max-h-[520px] w-full object-cover"
                            />
                        </div>
                    )
                }

                {
                    contenidoHTML && (
                        <section class="mt-14 border-t border-brand-border pt-12">
                            <div
                                class="prose prose-lg max-w-none"
                                set:html={contenidoHTML}
                            />
                        </section>
                    )
                }
            </article>

            {
                marcas.length > 0 && (
                    <section class="mt-16 border-t border-brand-border pt-12">
                        <h2 class="mb-6">Marcas relacionadas</h2>

                        <div class="grid gap-5 md:grid-cols-2">
                            {marcas.map((marca: any) => (
                                <RelatedCard
                                    type="Marca"
                                    title={marca.nombre}
                                    description={marca.descripcion_corta}
                                    url={`/marcas/${marca.slug}`}
                                    image={marca.imagen_portada}
                                />
                            ))}
                        </div>
                    </section>
                )
            }

            {
                modelos.length > 0 && (
                    <section class="mt-16 border-t border-brand-border pt-12">
                        <h2 class="mb-6">Modelos relacionados</h2>

                        <div class="grid gap-5 md:grid-cols-2">
                            {modelos.map((modelo: any) => (
                                <RelatedCard
                                    type="Modelo"
                                    title={modelo.nombre}
                                    description={modelo.descripcion_corta}
                                    url={`/modelos/${modelo.slug}`}
                                    image={modelo.imagen_principal}
                                />
                            ))}
                        </div>
                    </section>
                )
            }

            {
                manuales.length > 0 && (
                    <section class="mt-16 border-t border-brand-border pt-12">
                        <h2 class="mb-6">Manuales relacionados</h2>

                        <div class="grid gap-5 md:grid-cols-2">
                            {manuales.map((manual: any) => (
                                <RelatedCard
                                    type="Manual"
                                    title={manual.titulo}
                                    description={manual.descripcion}
                                    url={`/manuales/${manual.slug}`}
                                    image={manual.imagen_portada}
                                />
                            ))}
                        </div>
                    </section>
                )
            }
        </Container>
    </main>
</Layout>
