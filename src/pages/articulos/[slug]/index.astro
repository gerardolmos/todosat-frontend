---
import Layout from "../../../layouts/Layout.astro";
import { getArticulos } from "../../../lib/content";
import { renderBlocks, getReadingTime } from "../../../lib/renderBlocks";
import { getMediaUrl } from "../../../lib/media";
import Container from "../../../components/Container.astro";
import RelatedCard from "../../../components/RelatedCard.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";

export async function getStaticPaths() {
    const articulos = await getArticulos();

    return articulos.map((articulo: any) => ({
        params: {
            slug: articulo.slug,
        },
        props: {
            articulo,
        },
    }));
}

const { articulo } = Astro.props as any;

const contenidoHTML = renderBlocks(articulo.contenido);
const imagenUrl = getMediaUrl(articulo.imagen_principal);

const categoria = articulo.categoria_tematica;
const marcas = articulo.marcas || [];
const modelos = articulo.modelos || [];
const manuales = articulo.manuals || [];

const fecha = articulo.fecha_publicacion
    ? new Date(articulo.fecha_publicacion).toLocaleDateString("es-ES", {
          day: "2-digit",
          month: "long",
          year: "numeric",
      })
    : null;

const readingTime = getReadingTime(articulo.contenido);
---

<Layout
    title={`${articulo.titulo} | TodoSatcom`}
    description={articulo.subtitulo}
>
    <main class="min-h-screen bg-slate-950 py-16 text-white">
        <Container>
            <Breadcrumbs
                items={[
                    {
                        label: "Artículos",
                        href: "/articulos",
                    },
                    {
                        label: articulo.titulo,
                    },
                ]}
            />

            <article class="mt-8">
                <a
                    href="/articulos"
                    class="inline-flex text-sm font-semibold text-blue-400 transition hover:text-white"
                >
                    ← Volver a artículos
                </a>

                <header class="mt-8 max-w-4xl">
                    <div class="flex flex-wrap gap-3">
                        {
                            categoria && (
                                <a
                                    href={`/articulos/${categoria.slug}`}
                                    class="rounded-full border border-blue-500/50 bg-blue-500/10 px-4 py-2 text-sm font-semibold text-blue-300 transition hover:border-[#005EFF] hover:text-white"
                                >
                                    {categoria.nombre}
                                </a>
                            )
                        }

                        {
                            fecha && (
                                <span class="rounded-full border border-white/10 bg-slate-900 px-4 py-2 text-sm font-semibold text-slate-300">
                                    {fecha}
                                </span>
                            )
                        }
                        {
                            readingTime && (
                                <span class="rounded-full border border-white/10 bg-slate-900 px-4 py-2 text-sm font-semibold text-slate-300">
                                    {readingTime} min lectura
                                </span>
                            )
                        }
                    </div>

                    <h1
                        class="mt-8 max-w-5xl text-4xl font-bold leading-tight tracking-tight !text-white md:text-6xl"
                    >
                        {articulo.titulo}
                    </h1>

                    {
                        articulo.subtitulo && (
                            <p class="mt-6 max-w-3xl text-xl leading-8 text-slate-300 md:text-2xl md:leading-9">
                                {articulo.subtitulo}
                            </p>
                        )
                    }
                </header>

                {
                    imagenUrl && (
                        <div class="mt-12 overflow-hidden rounded-3xl">
                            <img
                                src={imagenUrl}
                                alt={articulo.titulo}
                                class="max-h-[560px] w-full object-cover"
                            />
                        </div>
                    )
                }

                {
                    contenidoHTML && (
                        <section class="mt-12">
                            <div
                                class="prose prose-invert prose-lg max-w-4xl prose-headings:text-white prose-p:text-slate-300 prose-a:text-blue-400 prose-strong:text-white"
                                set:html={contenidoHTML}
                            />
                        </section>
                    )
                }
            </article>

            {
                marcas.length > 0 && (
                    <section class="mt-16 border-t border-white/10 pt-12">
                        <h2 class="mb-6 text-3xl font-bold !text-white">
                            Operadores relacionados
                        </h2>

                        <div class="grid gap-x-10 gap-y-2 md:grid-cols-2">
                            {marcas.map((marca: any) => (
                                <RelatedCard
                                    type="Operador"
                                    title={marca.nombre}
                                    description={marca.descripcion_corta}
                                    url={`/operadores/${marca.slug}`}
                                    image={marca.imagen_portada}
                                />
                            ))}
                        </div>
                    </section>
                )
            }

            {
                modelos.length > 0 && (
                    <section class="mt-16 border-t border-white/10 pt-12">
                        <h2 class="mb-6 text-3xl font-bold !text-white">
                            Modelos relacionados
                        </h2>

                        <div class="grid gap-5 md:grid-cols-2">
                            {modelos.map((modelo: any) => (
                                <RelatedCard
                                    type="Modelo"
                                    title={modelo.nombre}
                                    description={modelo.descripcion_corta}
                                    url={`/modelos/${modelo.slug}`}
                                    image={modelo.imagen_principal}
                                />
                            ))}
                        </div>
                    </section>
                )
            }

            {
                manuales.length > 0 && (
                    <section class="mt-16 border-t border-white/10 pt-12">
                        <h2 class="mb-6 text-3xl font-bold !text-white">
                            Manuales relacionados
                        </h2>

                        <div class="grid gap-5 md:grid-cols-2">
                            {manuales.map((manual: any) => (
                                <RelatedCard
                                    type="Manual"
                                    title={manual.titulo}
                                    description={manual.descripcion}
                                    url={`/manuales/${manual.slug}`}
                                    image={manual.imagen_portada}
                                />
                            ))}
                        </div>
                    </section>
                )
            }
        </Container>
    </main>
</Layout>
