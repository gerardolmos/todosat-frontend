---
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/Container.astro";
import { getCategorias, getArticulos } from "../../../lib/content";

export async function getStaticPaths() {
    const categorias = await getCategorias();

    return categorias.map((categoria: any) => ({
        params: {
            slug: categoria.slug,
        },
        props: {
            categoria,
        },
    }));
}

const { categoria } = Astro.props as any;

const articulos = (await getArticulos()).filter(
    (articulo: any) => articulo.categoria_tematica?.slug === categoria.slug,
);
---

<Layout title={`${categoria.nombre} | TODOSat`}>
    <main class="min-h-screen py-10">
        <Container>
            <a href="/categorias" class="text-blue-600 underline">
                ← Volver a categorías
            </a>

            <h1 class="mt-6 text-5xl font-bold">
                {categoria.nombre}
            </h1>

            <p class="mt-4 text-xl text-gray-600">
                {categoria.descripcion}
            </p>

            <section class="mt-12">
                <h2 class="mb-6 text-3xl font-bold">Artículos</h2>

                <div class="grid gap-6">
                    {
                        articulos.map((articulo: any) => (
                            <a
                                href={`/articulos/${articulo.slug}`}
                                class="block rounded border p-6 hover:bg-gray-50"
                            >
                                <h3 class="text-2xl font-bold">
                                    {articulo.titulo}
                                </h3>

                                <p class="mt-2 text-gray-600">
                                    {articulo.subtitulo}
                                </p>
                            </a>
                        ))
                    }
                </div>
            </section>
        </Container>
    </main>
</Layout>
