---
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/Container.astro";
import { getCategorias, getArticulos } from "../../../lib/content";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import RelatedCard from "../../../components/RelatedCard.astro";

export async function getStaticPaths() {
    const categorias = await getCategorias();

    return categorias.map((categoria: any) => ({
        params: {
            slug: categoria.slug,
        },
        props: {
            categoria,
        },
    }));
}

const { categoria } = Astro.props as any;

const articulos = (await getArticulos()).filter(
    (articulo: any) => articulo.categoria_tematica?.slug === categoria.slug,
);
---

<Layout title={`${categoria.nombre} | TODOSat`}>
    <main class="min-h-screen py-10">
        <Container>
            <Breadcrumbs
                items={[
                    {
                        label: "Categorías",
                        href: "/categorias",
                    },
                    {
                        label: categoria.nombre,
                    },
                ]}
            />
            <a href="/categorias" class="text-blue-600 underline">
                ← Volver a categorías
            </a>

            <h1 class="mt-6 text-5xl font-bold">
                {categoria.nombre}
            </h1>

            <p class="mt-4 text-xl text-gray-600">
                {categoria.descripcion}
            </p>

            <section class="mt-12">
                <h2 class="mb-6 text-3xl font-bold">Artículos</h2>

                {
                    articulos.length > 0 ? (
                        <div class="grid gap-4 md:grid-cols-2">
                            {articulos.map((articulo: any) => (
                                <RelatedCard
                                    type="Artículo"
                                    title={articulo.titulo}
                                    description={articulo.subtitulo}
                                    meta={articulo.tipo_articulo}
                                    url={`/articulos/${articulo.slug}`}
                                    image={articulo.imagen_principal}
                                />
                            ))}
                        </div>
                    ) : (
                        <p class="text-gray-600">
                            Todavía no hay artículos en esta categoría.
                        </p>
                    )
                }
            </section>
        </Container>
    </main>
</Layout>
