---
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/Container.astro";
import {
    getMarcas,
    getModelos,
    getArticulos,
    getManuales,
} from "../../../lib/content";
import { renderBlocks } from "../../../lib/renderBlocks";
import { getMediaUrl } from "../../../lib/media";
import RelatedCard from "../../../components/RelatedCard.astro";
import { formatLabel } from "../../../lib/format";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";

export async function getStaticPaths() {
    const marcas = await getMarcas();

    return marcas.map((marca: any) => ({
        params: {
            slug: marca.slug,
        },
        props: {
            marca,
        },
    }));
}

const { marca } = Astro.props as any;

const descripcionHTML = renderBlocks(marca.descripcion_completa);
const logoUrl = getMediaUrl(marca.logo);
const imagenPortadaUrl = getMediaUrl(marca.imagen_portada);

const modelos = (await getModelos()).filter(
    (modelo: any) => modelo.marca?.slug === marca.slug,
);

const articulos = (await getArticulos()).filter((articulo: any) =>
    articulo.marcas?.some(
        (marcaRelacionada: any) => marcaRelacionada.slug === marca.slug,
    ),
);

const manuales = (await getManuales()).filter((manual: any) =>
    manual.marcas?.some(
        (marcaRelacionada: any) => marcaRelacionada.slug === marca.slug,
    ),
);
---

<Layout
    title={`${marca.nombre} | Todo-Sat`}
    description={marca.descripcion_corta}
>
    <main class="min-h-screen py-10">
        <Container>
            <Breadcrumbs
                items={[
                    {
                        label: "Marcas",
                        href: "/marcas",
                    },
                    {
                        label: marca.nombre,
                    },
                ]}
            />

            <section
                class="mt-8 grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center"
            >
                <div>
                    <a
                        href="/marcas"
                        class="text-sm font-semibold text-info-primary hover:text-info-primary-dark"
                    >
                        ← Volver a marcas
                    </a>

                    {
                        logoUrl && (
                            <img
                                src={logoUrl}
                                alt={`Logo de ${marca.nombre}`}
                                class="mt-8 max-h-20 w-auto"
                            />
                        )
                    }

                    <h1 class="mt-6 max-w-4xl">
                        {marca.nombre}
                    </h1>

                    {
                        marca.descripcion_corta && (
                            <p class="mt-6 max-w-2xl text-xl leading-8 text-brand-muted">
                                {marca.descripcion_corta}
                            </p>
                        )
                    }

                    <div class="mt-8 flex flex-wrap gap-3">
                        {
                            marca.tipo_orbita && (
                                <span class="rounded-full bg-info-primary-soft px-4 py-2 text-sm font-semibold text-info-primary-dark">
                                    {marca.tipo_orbita}
                                </span>
                            )
                        }

                        {
                            marca.pais_origen && (
                                <span class="rounded-full bg-brand-soft px-4 py-2 text-sm font-semibold text-brand-muted">
                                    {marca.pais_origen}
                                </span>
                            )
                        }
                    </div>

                    {
                        marca.web_oficial && (
                            <a
                                href={marca.web_oficial}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="mt-8 inline-flex rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-info-primary-dark"
                            >
                                Web oficial →
                            </a>
                        )
                    }
                </div>

                {
                    imagenPortadaUrl && (
                        <div class="overflow-hidden rounded-3xl border border-brand-border bg-white shadow-sm">
                            <img
                                src={imagenPortadaUrl}
                                alt={marca.nombre}
                                class="h-full max-h-[460px] w-full object-cover"
                            />
                        </div>
                    )
                }
            </section>

            {
                descripcionHTML && (
                    <section class="mt-16 border-t border-brand-border pt-12">
                        <div
                            class="prose prose-lg max-w-none"
                            set:html={descripcionHTML}
                        />
                    </section>
                )
            }

            <section class="mt-16 border-t border-brand-border pt-12">
                <h2 class="mb-6">
                    Modelos de {marca.nombre}
                </h2>

                {
                    modelos.length > 0 ? (
                        <div class="grid gap-5 md:grid-cols-2">
                            {modelos.map((modelo: any) => (
                                <RelatedCard
                                    type="Modelo"
                                    title={modelo.nombre}
                                    description={modelo.descripcion_corta}
                                    meta={modelo.marca?.nombre}
                                    url={`/modelos/${modelo.slug}`}
                                    image={modelo.imagen_principal}
                                />
                            ))}
                        </div>
                    ) : (
                        <p class="text-brand-muted">
                            Todavía no hay modelos publicados para esta marca.
                        </p>
                    )
                }
            </section>

            <section class="mt-16 border-t border-brand-border pt-12">
                <h2 class="mb-6">Artículos relacionados</h2>

                {
                    articulos.length > 0 ? (
                        <div class="grid gap-5 md:grid-cols-2">
                            {articulos.map((articulo: any) => (
                                <RelatedCard
                                    type="Artículo"
                                    title={articulo.titulo}
                                    description={articulo.subtitulo}
                                    meta={formatLabel(articulo.tipo_articulo)}
                                    url={`/articulos/${articulo.slug}`}
                                    image={articulo.imagen_principal}
                                />
                            ))}
                        </div>
                    ) : (
                        <p class="text-brand-muted">
                            Todavía no hay artículos relacionados con esta
                            marca.
                        </p>
                    )
                }
            </section>

            <section class="mt-16 border-t border-brand-border pt-12">
                <h2 class="mb-6">Manuales relacionados</h2>

                {
                    manuales.length > 0 ? (
                        <div class="grid gap-5 md:grid-cols-2">
                            {manuales.map((manual: any) => (
                                <RelatedCard
                                    type="Manual"
                                    title={manual.titulo}
                                    description={manual.descripcion}
                                    meta={`${manual.ano_publicacion ?? ""}${manual.idioma ? ` · ${formatLabel(manual.idioma)}` : ""}`}
                                    url={`/manuales/${manual.slug}`}
                                    image={manual.imagen_portada}
                                />
                            ))}
                        </div>
                    ) : (
                        <p class="text-brand-muted">
                            Todavía no hay manuales relacionados con esta marca.
                        </p>
                    )
                }
            </section>
        </Container>
    </main>
</Layout>
